.claude/settings.local.json

# seeded design-canvas payloads (2 MB editor + content); regenerate from the .dc.html files
docs/design/**/cags-*-variations.html
# round-2/3 naming variants (payload is regenerable from the .dc.html files + canvas.json)
docs/design/**/cags-*-variations-round-*.html
docs/design/**/cags-*-components-round-*.html
# round-4 tables canvas payload (regenerable from the .dc.html files + canvas.json)
