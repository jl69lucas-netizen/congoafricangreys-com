</style>

<script>
  // ---- Dial + rail scroll-spy. A static ring reads as broken, so it is driven, not decorative. ----
  const ids = ["cost","rescue","routes","dayone","ongoing","cheap","shipping","reserve","faq"];
  const dial = document.getElementById("adoptDial");
  const num = document.getElementById("dialNum");
  const dialLinks = Array.from(document.querySelectorAll(".dial-list a"));
  const railLinks = Array.from(document.querySelectorAll(".railA a"));
  const secs = ids.map((i) => document.getElementById(i)).filter(Boolean);

  if (secs.length) {
    const setActive = (idx) => {
      if (num) num.textContent = String(idx + 1);
      if (dial) dial.style.setProperty("--p", String(Math.round(((idx + 1) / ids.length) * 100)));
      dialLinks.forEach((a, i) => a.classList.toggle("on", i === idx));
      railLinks.forEach((a, i) => a.classList.toggle("on", i === idx));
      const activeRail = railLinks[idx];
      if (activeRail && activeRail.parentElement) {
        activeRail.parentElement.scrollTo({ left: activeRail.offsetLeft - 16, behavior: "smooth" });
      }
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const idx = secs.indexOf(e.target);
          if (idx > -1) setActive(idx);
        }
      });
    }, { rootMargin: "-45% 0px -50% 0px", threshold: 0 });
    secs.forEach((s) => io.observe(s));
    setActive(0);
  }

  // ---- Avail-B price-band filter ----
  const bandBtns = Array.from(document.querySelectorAll(".side-f"));
  const cards = Array.from(document.querySelectorAll(".availB-c"));
  bandBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const want = btn.getAttribute("data-band");
      bandBtns.forEach((b) => b.classList.toggle("on", b === btn));
      cards.forEach((c) => {
        const show = want === "all" || c.getAttribute("data-cat") === want;
        c.classList.toggle("hide", !show);
      });
    });
  });

  // ---- Price-watch band chips on the fs-nl ledger newsletter ----
  const nlBtns = Array.from(document.querySelectorAll("#nlbands button"));
  const nlInput = document.getElementById("nlband-input");
  nlBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      nlBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      if (nlInput) nlInput.value = btn.getAttribute("data-band") || "";
    });
  });

  // ---- True-Cost Calculator.
  // Constants are interpolated from data/financial-entities.json + data/price-matrix.json at build
  // time by the frontmatter above; nothing here is retyped by hand. Every output is a RANGE, because
  // the underlying data is a range. Differentiated from the homepage first-year calculator by the
  // multi-year projection and the route comparison.
  const CT = {
    setup: [475, 1300],
    annual: [375, 1350],
    cage: [300, 800],
    stand: [100, 300],
  };
  const usd = (n) => "$" + Math.round(n).toLocaleString("en-US");
  const band = (lo, hi) => (Math.round(lo) === Math.round(hi) ? usd(lo) : usd(lo) + "–" + usd(hi));

  const ctBird = document.getElementById("ct-bird");
  const ctShip = document.getElementById("ct-ship");
  const ctSetup = document.getElementById("ct-setup");
  const ctYears = document.getElementById("ct-years");
  const outDay = document.getElementById("ct-day");
  const outY1 = document.getElementById("ct-yr1");
  const outSpan = document.getElementById("ct-span");
  const spanLabel = document.getElementById("ct-spanlabel");

  function recalc() {
    if (!ctBird || !outDay) return;
    const [bLo, bHi] = ctBird.value.split(",").map(Number);
    const ship = Number(ctShip.value);
    const owned = Number(ctSetup.value);
    const yrs = Number(ctYears.value);

    let setLo = CT.setup[0], setHi = CT.setup[1];
    if (owned >= 1) { setLo -= CT.cage[0]; setHi -= CT.cage[1]; }
    if (owned >= 2) { setLo -= CT.stand[0]; setHi -= CT.stand[1]; }
    setLo = Math.max(0, setLo); setHi = Math.max(0, setHi);

    const dayLo = bLo + ship, dayHi = bHi + ship;
    const y1Lo = dayLo + setLo + CT.annual[0];
    const y1Hi = dayHi + setHi + CT.annual[1];
    const spanLo = y1Lo + CT.annual[0] * (yrs - 1);
    const spanHi = y1Hi + CT.annual[1] * (yrs - 1);

    outDay.textContent = band(dayLo, dayHi);
    outY1.textContent = band(y1Lo, y1Hi);
    outSpan.textContent = yrs === 1 ? band(y1Lo, y1Hi) : band(spanLo, spanHi);
    if (spanLabel) spanLabel.textContent = yrs === 1 ? "Across one year" : "Across " + yrs + " years";
  }
  [ctBird, ctShip, ctSetup, ctYears].forEach((el) => el && el.addEventListener("change", recalc));
  recalc();
</script>
