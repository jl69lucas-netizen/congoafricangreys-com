              ))}
            </div>
            <p class="side-ship">Ships nationwide · {money(airport)} airport · {money(home)} home</p>
            <p class="side-note">Pickup in Midland, TX is free within two to three hours.</p>
          </aside>
          <div class="availB-grid">
            {available.map((b) => {
              const g = birdImg[b.id];
              const isPair = b.sex === "pair";
              return (
                <article class="availB-c" data-cat={bandOf(b.price)}>
                  <a class="availB-photo" href={b.slug} tabindex="-1">
                    <img src={g.src} srcset={g.src.replace('.webp', '-400.webp') + " 400w, " + g.src + " 800w"}
                      sizes="(max-width:980px) 46vw, 210px" width="440" height="440"
                      style={`object-position:${g.pos}`} loading="lazy" decoding="async" alt={g.alt} />
                    <span class={`availB-badge ${bandOf(b.price)}`}>{bandOf(b.price) === "band4" ? "Pair" : bandLabelShort(b.price)}</span>
                    <span class="availB-dot" title="Available"></span>
                  </a>
                  <div class="availB-body">
                    <h4 class="availB-name"><a href={b.slug}>{b.name}</a></h4>
                    <p class="availB-meta">{isPair ? "Congo companion pair" : (b.variant === "timneh_african_grey" ? "Timneh" : "Congo") + " · " + (b.sex === "female" ? "hen" : "cock") + " · " + b.age_at_listing}</p>
                    <p class="availB-blurb">{birdBlurb[b.id]}</p>
                    <ul class="availB-chips">{cardChips.map((c) => (<li>{c}</li>))}</ul>
                    <span class="availB-price">{b.price_display}</span>
                    <a class="availB-btn btn-clay" href={b.slug}>View {b.name} &rarr;</a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <h4 class="cag-h4">What Is the Least Expensive Documented Grey You Have?</h4>
        <p>Evie, a Timneh hen, at {money(floorPrice)}. She carries the identical document set as the {money(ceilPrice)} pair — DNA certificate, CITES Appendix I file, PBFD and Polyomavirus PCR results, and an avian-vet health certificate. The price reflects subspecies and demand, never a thinner file.</p>

        <h3 class="cag-h3">What Do Buyers Say About Paying Our Price?</h3>
        <div class="quote-grid">
          {stories.map((s) => (
            <figure class="quote-c">
              <div class="q-head">
                <img class="q-av" src={s.avatar} width="44" height="44" loading="lazy" decoding="async" alt={`${s.name}, a verified C.A.Gs buyer from ${s.loc}`} />
                <div class="q-id"><span class="q-name">{s.name}</span><span class="q-loc">{s.loc} · {s.meta}</span></div>
              </div>
              <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
              <blockquote><p>{s.quote}</p></blockquote>
            </figure>
          ))}
        </div>
      </section>

      <div class="seam"><img src={seam} width="150" height="50" alt="" loading="lazy" decoding="async"></div>

      <!-- 09 · FAQ — FAQ-C dark, refreshed to a ledger register with a clay $ chip -->
      <section id="faq" class="sec">
        <h2 class="cag-h2">African Grey Adoption Cost Questions Buyers Ask Us</h2>
        <p>These are the questions people actually send us about money, in the order they usually send them. Every answer here is the same one we would give you on the phone.</p>
        <div class="faqC">
          {faqs.map((f, i) => (
            <details class="faqC-item">
              <summary><span class="faqC-n" aria-hidden="true">$</span><span class="faqC-q">{f.q}</span><span class="faqC-x" aria-hidden="true"></span></summary>
              <div class="faqC-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>

        <h3 class="cag-h3">What Should You Read Next Before You Commit?</h3>
        <div class="read-cards">
          <a class="read-c" href="/african-grey-parrot-price/">
            <div class="read-body">
              <p class="read-kicker">Cost of ownership</p>
              <p class="read-title">Our Cost-of-Ownership Breakdown</p>
              <p class="read-sub">The long-run arithmetic in full — what a Grey costs to keep, not to acquire.</p>
              <span class="read-more">Read the breakdown &rarr;</span>
            </div>
          </a>
          <a class="read-c" href="/african-grey-parrot-lifespan/">
