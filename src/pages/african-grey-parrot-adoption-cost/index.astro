---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import clutch from '../../../data/clutch-inventory.json';
import fin from '../../../data/financial-entities.json';

// Meta — extended 3-part for-sale format (Primary KW | conversational query | number+positive | brand — LSI), ≤280
const title = "African Grey Parrot Adoption Cost | What Does an African Grey Actually Cost in the USA? | 3 Honest Routes Priced Day One, Year One and Five Years | C.A.Gs – Midland, TX — Rescue Fees, Breeder Pricing, DNA-Sexed CITES-Papered Congo and Timneh Greys";
// Desc — primary benefit | secondary benefit | trust signal + CTA, ≤300
const description = "See every route priced honestly — rescue fees from $450, our documented Congos and Timnehs from $1,500, and the five-year number nobody publishes. USDA-licensed, CITES Appendix I papered, PBFD and Polyomavirus PCR screened. Ships nationwide, $185 airport or $350 home. Reserve yours in 24 hours.";
const canonical = "https://congoafricangreys.com/african-grey-parrot-adoption-cost/";
const site = "https://congoafricangreys.com";
const seam = "/cag-fs-seam-emblem.webp";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
  { name: "African Grey Adoption Cost", url: "/african-grey-parrot-adoption-cost/" },
];

// ---- Real inventory. Status is never hardcoded; sold birds never render. ----
const available = ((clutch as any).birds as any[])
  .filter((b) => b.status === "available")
  .sort((a, b) => a.price - b.price);

const prices = available.map((b) => b.price);
const floorPrice = Math.min(...prices);
const ceilPrice = Math.max(...prices);

// Price-band faceting — this page's Avail-B axis. Siblings facet by subspecies,
// availability posture, sex and age band; the money axis is ours alone.
const bandOf = (p: number) => (p < 1700 ? "band1" : p < 2300 ? "band2" : p < 3000 ? "band3" : "band4");
const bands = [
  { k: "band1", label: "$1,500 – $1,699" },
  { k: "band2", label: "$1,700 – $2,299" },
  { k: "band3", label: "$2,300 – $2,599" },
  { k: "band4", label: "$3,500 bonded pair" },
];
const bandCount = (k: string) => available.filter((b) => bandOf(b.price) === k).length;
const bandLabelShort = (p: number) => (p < 1700 ? "Under $1,700" : p < 2300 ? "$1,700+" : p < 3000 ? "$2,300+" : "Pair");

const birdImg: Record<string, { src: string; pos: string; alt: string }> = {
  "evie": { src: "/evie-timneh-african-grey-female-perched-card.webp", pos: "center 12%", alt: "Evie, a Timneh African Grey hen at our lowest documented price of $1,500" },
  "elad": { src: "/elad-timneh-african-grey-male-wings-card.webp", pos: "center 20%", alt: "Elad, a young Timneh African Grey cock whose DNA certificate is already on file" },
  "bery": { src: "/bery-congo-african-grey-cuddly-tamed-card.webp", pos: "center 30%", alt: "Bery, a tamed Congo African Grey hen in the lower Congo price band" },
  "roys": { src: "/roys-congo-african-grey-male-tame-card.webp", pos: "center 30%", alt: "Roys, a confident Congo African Grey cock suited to a busy household" },
  "amie": { src: "/amie-congo-african-grey-handfed-baby-card.webp", pos: "center 25%", alt: "Amie, a hand-fed Congo African Grey hen at the top of our single-bird range" },
  "jins-jeni": { src: "/jins-jeni-congo-african-grey-pair-card.webp", pos: "center 30%", alt: "Jins and Jeni, a Congo African Grey companion pair that rehomes together" },
};
const birdBlurb: Record<string, string> = {
  "evie": "Our lowest documented price, and nothing was removed to reach it.",
  "elad": "Steady Timneh cock, harness-curious and easy to handle already.",
  "bery": "A settled hen who reads as calm from the first afternoon home.",
  "roys": "Busy and chatty — better matched to a loud house than a quiet one.",
  "amie": "Hand-fed from the nursery, socialised on shoulders since hatch.",
  "jins-jeni": "Two birds, one price, one home — they do not separate.",
};
const heroLadder: Record<string, string> = {
  "evie": "Rung one of our price ladder — Evie the Timneh hen, the lowest documented price we hold",
  "bery": "Rung two — Bery the Congo hen, where the Congo band opens",
  "roys": "Rung three — Roys the Congo cock, mid-band and fully papered",
  "jins-jeni": "Top rung — Jins and Jeni, the bonded Congo pair sold as one",
};
const cardChips = ["DNA-sexed", "PCR screened", "Vet certificate"];

// ---- Delivery tiers, read from the data file, never retyped ----
const d = (fin as any).purchase_costs.delivery_options;
const airport = d.airport_pickup.cost;
const home = d.home_delivery.cost;
const nanny = d.flight_nanny.cost_from;

// ---- Setup and annual ranges, read from the data file ----
const fy = (fin as any).first_year_setup;
const an = (fin as any).annual_ongoing;
const sumR = (o: any, keys: string[]) => keys.reduce((a: number[], k) => [a[0] + o[k].min, a[1] + o[k].max], [0, 0]);
const setupOnce = sumR(fy, ["cage_large", "perches_and_toys", "initial_avian_vet_visit"]);
const annualRun = sumR(an, ["food_and_treats", "avian_vet_wellness", "toys_replacement", "unexpected_vet"]);
const money = (n: number) => "$" + n.toLocaleString("en-US");
const range = (r: number[]) => money(r[0]) + "–" + money(r[1]);

// ---- Section spine. The band column IS the T1 refresh: the contents list previews the money. ----
const sections = [
  { id: "cost",     n: "01", label: "What a Grey Costs",   band: "$450–$8,500", tag: "market" },
  { id: "rescue",   n: "02", label: "Rescue Fees",         band: "$450–$1,500", tag: "published" },
  { id: "routes",   n: "03", label: "Three Routes Priced", band: "5-year view", tag: "our ledger" },
  { id: "dayone",   n: "04", label: "Day One",             band: range([floorPrice, ceilPrice]), tag: "our birds" },
  { id: "ongoing",  n: "05", label: "Every Year After",    band: range(annualRun), tag: "recurring" },
  { id: "cheap",    n: "06", label: "Under $1,000",        band: "the warning", tag: "caution" },
  { id: "shipping", n: "07", label: "Getting Home",        band: money(0) + "–" + money(nanny) + "+", tag: "delivery" },
  { id: "reserve",  n: "08", label: "Reservable Now",      band: range([floorPrice, ceilPrice]), tag: available.length + " birds" },
  { id: "faq",      n: "09", label: "Cost Questions",      band: "answers", tag: "" },
];

// ---- Geo: six states unused by every sibling in this cluster ----
const shipPlaces = [
  { href: "/african-grey-parrot-for-sale-new-jersey/", label: "African Grey adoption cost New Jersey", note: "Dense rescue corridor — worth pricing both routes" },
  { href: "/african-grey-parrot-for-sale-massachusetts/", label: "What a documented Grey costs Massachusetts", note: "Boston-area cargo arrival" },
  { href: "/african-grey-parrot-for-sale-minnesota/", label: "African Grey prices Minnesota", note: "Cold-season routing rules apply" },
  { href: "/african-grey-parrot-for-sale-missouri/", label: "Grey parrot cost Missouri", note: "Central routing, shortest transit" },
  { href: "/african-grey-parrot-for-sale-oregon/", label: "African Grey adoption fees Oregon", note: "West-coast arrival airports" },
  { href: "/african-grey-parrot-for-sale-indiana/", label: "Documented African Grey pricing Indiana", note: "Midwest pickup and cargo" },
];

// ---- Real reviews only. Verbatim from our published set; neither is spent elsewhere in this cluster. ----
const stories = [
  { name: "Lawrence Brunner", loc: "Fullerton, CA", meta: "Congo African Grey",
    avatar: "/lawrence-brunner-fullerton-ca-review.webp",
    quote: "I'd been burned by a deposit scam before, so I asked C.A.Gs for everything — their license number, the CITES paperwork, a live video call. They sent it all without hesitating. My Congo landed at LAX calm and healthy with his whole documentation packet in the carrier. Worth every dollar." },
  { name: "Ida Brim", loc: "Nashville, TN", meta: "Congo African Grey",
    avatar: "/ida-brim-nashville-tn-review.webp",
    quote: "From the first email to home delivery here in Nashville, everything was exactly as promised. My grey arrived hand-raised, weaned, and confident — with his health certificate and CITES documents in hand. He bonded with our family in days." },
];

// ---- Table G · True-Cost Ledger. Rescue figures from Sprint 0 fee schedules; ours from the data files. ----
const yr1Ours = [floorPrice + setupOnce[0] + airport, ceilPrice + setupOnce[1] + home];
const yr5Ours = [yr1Ours[0] + annualRun[0] * 4, yr1Ours[1] + annualRun[1] * 4];
const ledgerRows = [
  { horizon: "Day one", rescue: "$450 – $1,500", ours: range([floorPrice, ceilPrice]), sub: "$400 – $900",
    misses: "A published rescue fee rarely covers transport. A sub-floor listing frequently covers nothing at all." },
  { horizon: "Year one", rescue: "$925 – $2,800", ours: range(yr1Ours), sub: "$1,400 – $4,000+",
    misses: "Setup costs the same whichever route you take. The sub-floor column swells because undocumented birds arrive needing work." },
  { horizon: "Five years", rescue: "$2,425 – $8,200", ours: range(yr5Ours), sub: "$2,900 – $9,400+",
    misses: "By year five the three routes converge. What you bought on day one was documentation, not a discount." },
];

// ---- Table A · how the routes present themselves, from the Sprint 0 SERP sweep ----
const compareRows = [
  { f: "Price actually published", a: "Yes — a fee schedule", b: "Yes — per bird", c: "Yes, and often struck through" },
  { f: "DNA sexing certificate", a: "Sometimes, if a prior owner paid", b: "Included in the price", c: "Rarely, and rarely verifiable" },
  { f: "PBFD and Polyomavirus PCR", a: "Case by case", b: "Screened before placing", c: "Almost never" },
  { f: "CITES Appendix I file", a: "Depends on the surrender paperwork", b: "On file for every bird", c: "Frequently absent" },
  { f: "Known history and parentage", a: "Often partial", b: "Named parents, hatch date, band number", c: "Unverifiable" },
  { f: "Who sets the number", a: "A committee, against a schedule", b: "The breeder who raised the bird", c: "Whoever wants the deposit" },
];

// ---- FAQ. PAA-sourced, fetched live in Sprint 0. Answers are visible in the DOM. ----
const faqs = [
  { q: "How much should I pay for an African grey parrot?",
    a: `Across the US market a documented African Grey runs roughly $1,500 to $3,500 from a licensed breeder, while rescue adoption fees are published between $450 and $1,500 and premium breeder listings reach $8,500. Our own floor is ${money(floorPrice)}, and a bird at that price still carries a DNA certificate, CITES Appendix I paperwork, PBFD and Polyomavirus PCR screening, and an avian-vet health certificate.` },
  { q: "Is it cheaper to adopt an African grey than to buy one?",
    a: "On day one, usually yes — a published rescue fee is lower than a breeder price. Across five years the routes converge, because setup, food, enrichment and veterinary care are identical whichever door the bird came through. Adoption changes what you pay on day one and barely changes what you pay by year five." },
  { q: "What is a rehoming fee, and is it different from an adoption fee?",
    a: "An adoption fee is set by an organisation against a published schedule. A rehoming fee is set by whoever currently holds the bird, and it is a private sale. That is why rehoming figures vary so wildly — owners report paying $600 to $900, while one California store was asking $5,500 for a tame six-year-old." },
  { q: "Why are African grey parrots so expensive?",
    a: "Three things carry the price. African Greys are CITES Appendix I, so every legal transfer is documented. They need twelve to sixteen weeks of daily hand-feeding before they can be placed. And demand rose sharply from 2020 without falling back. A bird priced far below that reality has usually skipped one of the three." },
  { q: "What does it cost to care for an African grey each year?",
    a: `Budget ${range(annualRun)} a year once the bird is home: pellets and fresh produce, an annual avian-vet wellness exam, toy and perch replacement, and a contingency for the vet visit you did not plan. The contingency is the line people leave out, and it is the one that hurts.` },
  { q: "Do you ship African greys outside the United States?",
    a: "No. We are a USDA-licensed Texas aviary and we place birds inside the United States only. Because African Greys are CITES Appendix I, international movement needs export and import permits in both countries, so prices quoted overseas do not transfer to a US captive-bred bird and are not a fair comparison to ours." },
  { q: "How much is shipping for an African grey parrot?",
    a: `Airport pickup is ${money(airport)} and home delivery is ${money(home)}, both on IATA live-animal terms with Delta, United or American. A flight nanny who keeps the bird in the cabin starts from ${money(nanny)} and is quoted per route. If you live within two to three hours of Midland, Texas, collection here costs nothing.` },
  { q: "Is a cheap African grey parrot a scam?",
    a: `Not always, but a listing far below our ${money(floorPrice)} floor is worth slowing down for. Ask for the USDA licence number, the DNA certificate, the PCR results and a live video call with the bird. A seller who holds those sends them within a day; a seller who does not will change the subject to payment.` },
  { q: "What paperwork should come with the price?",
    a: "A hatch certificate with the closed leg-band number, the CITES Appendix I captive-bred file, the DNA sexing certificate, the PBFD and Polyomavirus PCR results, and an avian-vet health certificate dated within ten days of travel. We price all of it into the bird and never bill it afterwards." },
  { q: "Can I pay a deposit to hold a bird while I get set up?",
    a: "Yes. A deposit holds a named bird and starts the paperwork; the balance falls due before travel is booked. That gap is deliberately the window in which most people buy the cage, because buying the cage twice is the most common first-year mistake we see." },
];

// ---- Schema. One Product + Offer per real available bird. AggregateOffer is banned here: not a hub. ----
const productSchema = {
  "@context": "https://schema.org",
  "@graph": available.map((b) => ({
    "@type": "Product",
    "name": `${b.name} — ${b.variant === "timneh_african_grey" ? "Timneh" : "Congo"} African Grey`,
    "url": site + b.slug,
    "image": site + (birdImg[b.id]?.src ?? ""),
    "description": birdBlurb[b.id] ?? "",
    "category": "Live pet bird",
    "brand": { "@type": "Brand", "name": "C.A.Gs – Midland, TX" },
    "offers": {
      "@type": "Offer",
      "price": b.price,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": site + b.slug,
      "seller": { "@type": "Organization", "name": "C.A.Gs – Midland, TX" },
    },
  })),
};
// ---- In-body figures. Rule 50b: the PRIMARY keyword appears in the primary
// image's alt only; every other alt rotates a different keyword type, so no two
// images on the page share a keyword class.
//   kind "inf" = infographic — baked-in text, so native 16:9 with object-fit
//                contain, NEVER cover-cropped (hardening §1c).
//   kind "og"  = real photo — takes the taller 5:4 mobile frame and a per-image
//                object-position so the bird is never clipped out of the strip.
const figs: Record<string, { src: string; kind: "inf" | "og"; pos?: string; alt: string; cap: string }> = {
  inf1: { src: "/african-grey-adoption-fee-vs-true-cost-iceberg.webp", kind: "inf",
    alt: "African Grey parrot adoption cost split into the visible fee above the waterline and the cage, vet, food and forty-year costs below it",
    cap: "The fee is the visible tip. Cage, vet, food and four decades of upkeep sit under the waterline — and no listing prices those." },
  og1: { src: "/african-greys-available-price-bands.webp", kind: "og", pos: "center 30%",
    alt: "Seven documented Congo and Timneh Greys from our aviary, the birds behind each price band we publish",
    cap: "Seven of ours. The spread in price across them is subspecies and demand — never a thinner document file." },
  inf7: { src: "/what-an-adoption-fee-does-not-cover.webp", kind: "inf",
    alt: "African Grey rescue adoption fee inclusions checked off against the DNA certificate, PCR screening, CITES paperwork and health guarantee it leaves out",
    cap: "A rescue fee reliably buys the bird and whatever history came with it. The four struck-through lines are what you then arrange and pay for yourself." },
  inf3: { src: "/african-grey-cost-by-acquisition-route-stacked.webp", kind: "inf",
    alt: "Total cost by acquisition route, stacked across rescue, breeder and online listing, with purchase price in clay and everything after it in green",
    cap: "Clay is what you pay to acquire the bird; green is everything that follows. The online listing starts cheapest and finishes highest." },
  inf2: { src: "/african-grey-day-one-money-breakdown.webp", kind: "inf",
    alt: "Day one money breakdown for a hand-raised Grey, itemised as bird, delivery and papers on a single receipt",
    cap: "Three lines, one total. We publish all three before you send a deposit." },
  og5: { src: "/african-grey-on-travel-carrier-day-one.webp", kind: "og", pos: "center 35%",
    alt: "Hand-raised Grey settled on its travel carrier the morning it leaves our Midland aviary",
    cap: "Day one, from our side of it — carrier, water cup, and the document folder that travels taped to the crate." },
  og3: { src: "/living-with-an-african-grey-running-costs.webp", kind: "og", pos: "center 30%",
    alt: "Grey on a play stand in a family room, the daily setting the annual running cost actually pays for",
    cap: "This is what the recurring lines buy: a bird out of its cage, in the room, part of the household." },
  og4: { src: "/african-grey-fresh-produce-annual-food-cost.webp", kind: "og", pos: "center 45%",
    alt: "Fresh chop bowl prepared for our Greys, the produce line item inside the yearly food budget",
    cap: "One morning's chop. Produce, not pellets, is the line most first-year budgets underestimate." },
  og6: { src: "/african-grey-toy-enrichment-line-item.webp", kind: "og", pos: "center 28%",
    alt: "One of our Greys shoulder-perched with a foraging toy, showing the enrichment line item in practice",
    cap: "Toys are consumable by design — a Grey is supposed to destroy them. Budget them as recurring, not once." },
  inf8: { src: "/african-grey-cost-by-decade-forty-year-timeline.webp", kind: "inf",
    alt: "Lifetime cost of owning an African Grey widening decade by decade from years one to forty",
    cap: "Decade by decade. You are the first of what may be two or three owners, and the bird outlives most of the equipment." },
  og2: { src: "/african-grey-forty-year-family-commitment.webp", kind: "og", pos: "center 32%",
    alt: "Older owner holding a settled Grey, the long commitment the forty-year money question really describes",
    cap: "The forty-year question is not really about money. It is about who takes the bird if you cannot." },
  inf5: { src: "/what-a-cheap-african-grey-really-costs.webp", kind: "inf",
    alt: "Cheap African Grey parrot true cost traced from an eight hundred dollar listing through missing papers, vet bills and quarantine",
    cap: "The $800 is where it starts, not where it ends. Every box to the right is a bill that arrives later." },
  inf6: { src: "/adoption-cost-african-grey-delivery-options.webp", kind: "inf",
    alt: "African Grey parrot delivery cost compared across airport cargo, home delivery and an accompanied flight nanny",
    cap: "Three ways home, three published prices. Pickup in Midland is free if you are within two to three hours." },
};
const fig = (k: string) => {
  const f = figs[k];
  return { ...f, srcset: `${f.src.replace(".webp", "-760.webp")} 760w, ${f.src} 1408w` };
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout {title} {description} {canonical} ogType="product" hideGlobalCta
  heroPreload="/evie-timneh-african-grey-female-perched-card.webp"
  heroPreloadSrcset="/evie-timneh-african-grey-female-perched-card-400.webp 400w, /evie-timneh-african-grey-female-perched-card.webp 800w"
  heroPreloadSizes="(max-width:900px) 44vw, 260px">

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="adopt">
  <div class="container"><Breadcrumb items={breadcrumbs} /></div>

  <!-- HERO — Split-Hero C dark. Refresh delta vs the egg page: the 2×2 grid is an ascending PRICE LADDER. -->
  <header class="adopt-hero">
    <div class="container hero-grid">
      <div class="hero-card">
        <p class="eyebrow">Priced {money(floorPrice)} to {money(ceilPrice)} · Midland, TX · USDA-licensed</p>
        <h1 class="cag-h1">African Grey Parrot Adoption Cost: What You <em>Really</em> Pay, Route by Route</h1>
        <p class="lead">A rescue publishes one number, a breeder publishes another, and the listing you found last night publishes a third that looks too good. Here at C.A.Gs we price all three side by side — day one, year one, and five years out — then show you the documented Congos and Timnehs reservable from {money(floorPrice)}.</p>
        <div class="hero-cta">
          <a class="btn-clay" href="#reserve">See the birds and prices &rarr;</a>
          <a class="btn-ghost" href="#routes">Compare the three routes</a>
        </div>
        <ul class="hero-chips">
          <li>Floor {money(floorPrice)}</li><li>CITES Appendix I</li><li>US delivery only</li>
        </ul>
      </div>
      <div class="hero-imgs">
        {["evie", "bery", "roys", "jins-jeni"].map((id) => {
          const g = birdImg[id];
          const b = available.find((x) => x.id === id);
          return b ? (
            <span class="hero-tile">
              <img src={g.src}
                srcset={g.src.replace('.webp', '-400.webp') + " 400w, " + g.src + " 800w"}
                sizes="(max-width:900px) 44vw, 260px" width="704" height="384"
                style={`object-position:${g.pos}`}
                fetchpriority="high" loading="eager" decoding="async" alt={heroLadder[id]} />
              <b class="hero-tile-p">{b.price_display}</b>
            </span>
          ) : null;
        })}
      </div>
    </div>
  </header>

  <!-- COUNTER — 8 Ledger-verified snippets, height reserved so the strip cannot shift -->
  <div class="adopt-counter">
    <div class="container counter-row">
      <div class="cs"><b>{money(floorPrice)}</b><span class="cs-l">Floor price</span></div>
      <div class="cs"><b>{money(airport)}</b><span class="cs-l">Airport tier</span></div>
      <div class="cs"><b>{money(home)}</b><span class="cs-l">Home tier</span></div>
      <div class="cs"><b>12+</b><span class="cs-l">Yrs aviary</span></div>
      <div class="cs"><b>100%</b><span class="cs-l">CITES papered</span></div>
      <div class="cs"><b>0</b><span class="cs-l">Wild-caught, ever</span></div>
      <div class="cs"><b>24h</b><span class="cs-l">Inquiry reply</span></div>
      <div class="cs"><b>40–60</b><span class="cs-l">Year commitment</span></div>
    </div>
  </div>

  <!-- MOBILE JUMP RAIL -->
  <nav class="adopt-rail" aria-label="On this page">
    <div class="container railA">
      {sections.map((s, i) => (<a href={`#${s.id}`} class={i === 0 ? "on" : ""}><span class="p">{s.n}</span> {s.label}</a>))}
    </div>
  </nav>

  <div class="container">
    <div class="adopt-body">

    <!-- DESKTOP DIAL — Dial 1 Clay Progress; ring driven by the scroll-spy at the foot of this file -->
    <nav class="dial desk-only" aria-label="Contents" id="adoptDial" style="--p:11">
      <div class="dial-ring"><div><b id="dialNum">1</b><span>of {sections.length}</span></div></div>
      <div class="dial-list">
        {sections.map((s, i) => (<a href={`#${s.id}`} data-i={i} class={i === 0 ? "on" : ""}><span class="num">{s.n}</span>{s.label}{s.tag && <span class="tag">{s.tag}</span>}</a>))}
      </div>
    </nav>

    <main class="adopt-main">

      <!-- T1 REFRESHED · money-preview ledger rail (in-body TOC) -->
      <nav class="t1m" aria-label="Sections of this page, with the cost each one covers">
        <p class="t1m-k">The ledger, section by section</p>
        <p class="t1m-h">Every Number on This Page, and Where to Find It</p>
        <ul class="t1m-list">
          {sections.map((s) => (
            <li><a href={`#${s.id}`}><span class="t1m-band">{s.band}</span><span>{s.label}</span></a></li>
          ))}
        </ul>
      </nav>

      <!-- 01 · WHAT A GREY COSTS -->
      <section id="cost" class="sec">
        <h2 class="cag-h2">What Does an African Grey Parrot Cost in 2026?</h2>
        <p>A documented African Grey costs between {money(floorPrice)} and {money(ceilPrice)} here at C.A.Gs, and between roughly $450 and $8,500 across the wider US market — a spread wide enough that quoting a single figure would be dishonest. That range exists because the same species is sold through three different doors, and each door prices a different thing: a rescue prices its overheads, a breeder prices sixteen weeks of hand-feeding and a paperwork trail, and an anonymous listing prices whatever it thinks you will send.</p>

        {(() => { const f = fig("inf1"); return (
          <figure class="sec-fig">
            <img class={`sec-img ${f.kind === "inf" ? "inf-img" : "og-photo"}`} src={f.src} srcset={f.srcset}
              sizes="(max-width:900px) 92vw, 760px" width="1408" height="768"
