      <!-- ═══ §13 JINS & JENI ═══ -->
      <section id="jins-jeni">
        <h2 class="cag-h2">Who Are Jins and Jeni, and Do They Have to Leave Together?</h2>
        <p>They are the two birds most people arrive on this page looking for, so here is everything we know about them.</p>

        <figure class="sec-img-wrap">
          <img class="sec-img og-photo" src={`${IMG}/jins-jeni-congo-pair-portrait.webp`} width="1408" height="768"
