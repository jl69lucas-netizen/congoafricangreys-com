---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Congo African Grey Parrot Pair for Sale | Will Two Greys Bond to Each Other and Ignore You? | 3 Honest Pairing Routes From $1,800 | C.A.Gs Midland TX — Jins & Jeni, DNA-Sexed, CITES Appendix I, Both Birds Papered, Nationwide Delivery";
const description = "Two documented Congo African Greys, and the answer no one else publishes: a pair often bonds to itself. We tell you when one bird is the better buy. Jins & Jeni $3,500, or either bird singly. USDA-licensed Texas aviary, 24-hour reply.";
const canonical = "https://congoafricangreys.com/congo-african-grey-parrot-pair-for-sale/";
const IMG = "/images/congo-pair-page";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Congo African Grey for Sale", url: "/congo-african-grey-for-sale/" },
  { name: "Congo African Grey Pair for Sale", url: "/congo-african-grey-parrot-pair-for-sale/" },
];

/* Live inventory — data/clutch-inventory.json + data/price-matrix.json. Never hardcode a different figure. */
const routes = [
  { id: "ready", facet: "Ready-Made Pair", name: "Jins & Jeni", price: "$3,500", sub: "Two birds, one reservation",
    blurb: "Jins (male, about six months) and Jeni (female, about four) were raised alongside each other here. Unrelated, both hand-raised, both papered.",
    img: `${IMG}/jins-jeni-pair-card-portrait`, alt: "Jins and Jeni, our unrelated Congo African Grey companion pair, feeding side by side in our Midland aviary",
    href: "/available/jins-jeni/", cta: "See Jins & Jeni" },
  { id: "single", facet: "Either Bird Singly", name: "Jins, or Jeni", price: "$1,900 / $1,800", sub: "You are not obliged to take both",
    blurb: "If one bird is the right answer for your household, say so and we will place one. Neither of them is held hostage to the other.",
    img: `${IMG}/jins-or-jeni-single-bird-option`, alt: "Two unrelated young Congo greys sharing a bowl, either of which we will place on its own",
    href: "#reserve", cta: "Ask About One" },
  { id: "build", facet: "Build Your Own Pair", name: "Roys & Amie", price: "$2,300 + $2,500", split: "Two birds, $4,800 in total", sub: "Two singles you introduce at home",
    blurb: "Roys is a confident male, Amie a steadier female. Bought together they arrive as two individuals, not a unit, which is the configuration that keeps both birds people-focused.",
    img: `${IMG}/roys-amie-two-congo-singles`, alt: "Roys and Amie photographed close together, the two Congo singles most often reserved as a build-your-own pair",
    href: "#reserve", cta: "See Roys & Amie" },
  { id: "timneh", facet: "Build Your Own Pair", name: "Elad & Evie", price: "$1,600 + $1,500", split: "Two birds, $3,100 in total", sub: "The Timneh alternative",
    blurb: "Both Timnehs, both out of Levi and Rily. Smaller, quieter and typically talking earlier than a Congo, at the lowest two-bird figure we offer.",
    img: `${IMG}/elad-evie-timneh-pair-option`, alt: "A pair of hand-tame Timneh greys stepping onto a keeper's hand, the lower-priced two-bird route",
    href: "/timneh-african-grey-for-sale/", cta: "See the Timnehs" },
  { id: "breeding", facet: "Breeding Referral", name: "Proven Breeding Pair", price: "From $3,000", sub: "A different purchase entirely",
    blurb: "Adults we hold back for breeding, closed-banded. This is stock for an aviary, not a companion pair for a living room.",
    img: `${IMG}/proven-breeding-pair-african-greys`, alt: "An adult grey inside our breeding flight, the aviary stock we list apart from every companion bird",
    href: "/african-grey-breeding-pair-for-sale/", cta: "See the Adults" },
  { id: "bery", facet: "Either Bird Singly", name: "Bery", price: "$1,700", sub: "One bird, complete on her own",
    blurb: "Bery is a female Congo who came out of hand-raising exceptionally people-oriented. She is the bird we point first-time owners toward.",
    img: `${IMG}/bery-single-congo-hen`, alt: "Bery taking a head scratch, the single Congo hen we point first-time owners toward",
    href: "/available/bery/", cta: "Ask About Bery" },
];

const facets = ["All Routes", "Ready-Made Pair", "Either Bird Singly", "Build Your Own Pair", "Breeding Referral"];

const counters = [
  { n: "2", l: "Birds, 1 Deposit" },
  { n: "$1,500", l: "Floor Price" },
  { n: "100%", l: "CITES Papered" },
  { n: "12+", l: "Yrs Aviary" },
  { n: "24h", l: "Reply" },
  { n: "0", l: "Wild-Caught" },
];

/* T3 Boarding-Pass TOC — 18 stops, the number the dial can show WITHOUT its own scrollbar
   at a 700px-tall viewport. Five H2s that read fine in the scroll flow but nobody
   jump-navigates to (#takeaway, #market, #build-your-own, #legal, #reading) stay on the
   page and out of the rail: a nav you have to scroll to read is not a nav. Numbering is
   the dial's own 1..18, not the section count — the ring tracks these 18. */
const stops = [
  { n: 1,  t: "Will They Ignore You?",       h: "#bonding-short" },
  { n: 2,  t: "Pairs & Singles Available",    h: "#available" },
  { n: 3,  t: "Why a Pair Drifts Away",     h: "#pair-bond" },
  { n: 4,  t: "What a Pair Protects",        h: "#protects" },
  { n: 5,  t: "Keeping Both Bonded",         h: "#protocol" },
  { n: 6,  t: "When One Bird Is Better",      h: "#one-bird" },
  { n: 7,  t: "Three Routes Compared",       h: "#routes" },
  { n: 8,  t: "Pair vs Two Singles",          h: "#arithmetic" },
  { n: 9,  t: "Jins & Jeni",                  h: "#jins-jeni" },
  { n: 10, t: "Paperwork Per Bird",           h: "#papers" },
  { n: 11, t: "Health Screening",             h: "#health" },
  { n: 12, t: "How Two Greys Travel",         h: "#shipping" },
  { n: 13, t: "Settling Two Greys In",        h: "#settling" },
  { n: 14, t: "Verifying Any Pair Seller",    h: "#verify" },
  { n: 15, t: "What Buyers Said",             h: "#reviews" },
  { n: 16, t: "How We Compare",               h: "#compare" },
  { n: 17, t: "Pair Questions",               h: "#faq" },
  { n: 18, t: "Reserve",                      h: "#reserve" },
];

const faqs = [
  { q: "If I buy two African Greys, will they bond to each other instead of me?",
    a: "They can, and it is the single most common regret we hear about pairs. Two greys housed together all day, close in age and unrelated, will often make each other the primary relationship and treat people as staff. It is not automatic. What decides it is husbandry: separate cages, daily one-to-one time with each bird, and training them individually rather than as a unit. If you cannot commit to that time every day, one bird will give you a closer relationship than two." },
  { q: "Does a pair have any advantage over a single grey?",
    a: "Yes, and it is worth stating honestly because most sellers only give you one half of this. A single grey that bonds hard to one person is prone to jealousy and can become aggressive toward everyone else in the household. A pair spreads that. They also have company during the hours you are out, which matters for a bird this intelligent. You trade intensity of human attachment for stability and company." },
  { q: "Do Jins and Jeni have to be bought together?",
    a: "No. We offer them together at $3,500 because they were raised alongside each other, but either bird can go on its own — Jins at $1,900, Jeni at $1,800. We would rather place one bird in the right home than push two into the wrong one." },
  { q: "How much daily time does each bird in a pair actually need?",
    a: "Plan on fifteen to thirty minutes alone with each bird, every day, on top of whatever time they spend out together. That is the number that keeps both birds people-focused. Two birds do not halve the work; they roughly double it." },
  { q: "Can a Congo and a Timneh live together?",
    a: "Yes, as companions. We keep Congos and Timnehs alongside each other here and the photograph on this page is our own aviary. What we would not recommend is pairing a Congo with a Timneh as a breeding pair — different subspecies, and that is not what either bird is for." },
  { q: "Should the two birds be male and female?",
    a: "For a companion pair it does not matter. Two hens or two cocks will keep each other company perfectly well. Sex only becomes decisive if you intend to breed, which is a different purchase and a different page." },
  { q: "Can two African Greys share one cage?",
    a: "Not on arrival, and in our experience not ever, if you want both birds tame. We ask every pair buyer to run two cages. Shared housing accelerates the pair bond and removes the separation you need in order to work with each bird individually." },
  { q: "What paperwork comes with a pair?",
    a: "Two complete sets, never one shared file. Each bird travels with its own CITES Appendix I documentation, its own DNA sexing certificate, its own avian vet health certificate, and its own hatch certificate and band number." },
  { q: "Do two birds ship in one crate or two?",
    a: "It depends on how settled they are with each other. Birds that already share space travel together in one IATA-compliant container; birds that do not go in adjacent compartments. Either way both birds fly on the same flight, and we make that call per pair rather than by policy." },
  { q: "Do I pay shipping twice for two birds?",
    a: "No. Airport pickup is $185 and home delivery is $350 for the reservation, not per bird. What does double is the paperwork and the handling, which is why a pair is not simply half price per head." },
  { q: "Why do some pairs cost $6,500 and others $1,800?",
    a: "Documented adult pairs are currently listed elsewhere between $6,500 and $8,000, and undocumented listings advertise pairs around $1,800. Ours sits at $3,500 because we bred and raised both birds here, so no reseller margin sits in the price. A low price with papers is value. A low price without them is bait." },
  { q: "At what age can a pair actually breed?",
    a: "Congo African Greys are not sexually mature until roughly three to five years. Any listing advertising a four-month-old or fifteen-month-old bonded or breeding pair is describing something that cannot happen, and that alone tells you what the listing is worth." },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem", position: i + 1, name: b.name,
        item: `https://congoafricangreys.com${b.url}`,
      })),
    },
    {
      "@type": "Product",
      name: "Jins & Jeni — Congo African Grey Companion Pair",
      description: "An unrelated, hand-raised companion pair of Congo African Greys (Psittacus erithacus) from C.A.Gs in Midland, Texas. Jins (male, ~6 months) and Jeni (female, ~4 months). DNA sexed, CITES Appendix I documented, captive-bred in the USA. Offered together at $3,500, or either bird singly.",
      brand: { "@type": "Brand", name: "C.A.Gs – Midland, TX" },
      image: [`https://congoafricangreys.com${IMG}/jins-jeni-congo-pair-portrait.webp`],
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        lowPrice: "1800",
        highPrice: "3500",
        offerCount: 3,
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: "C.A.Gs – Midland, TX" },
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question", name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const seam = "/cag-fs-seam-emblem.webp";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="product"
  hideGlobalCta
  schemaJson={JSON.stringify(schema)}
  heroPreload={`${IMG}/hero-congo-pair-midland-trust-560.webp`}
  heroPreloadSrcset={`${IMG}/hero-congo-pair-midland-trust-560.webp 560w, ${IMG}/hero-congo-pair-midland-trust-760.webp 760w, ${IMG}/hero-congo-pair-midland-trust-1040.webp 1040w, ${IMG}/hero-congo-pair-midland-trust.webp 1408w`}
  heroPreloadSizes="(max-width:980px) 46vw, 520px"
>
<main class="cpair">

  <div class="container"><Breadcrumb items={breadcrumbs} /></div>

  <!-- ═══ §1 HERO — Hero-A refreshed "Bonded Duo", two tiles ═══ -->
  <header class="phero hero-duo">
    <div class="container phero-grid">
      <div class="phero-copy">
        <p class="eyebrow">Est. 2014 · Midland, TX · USDA-licensed</p>
        <h1 class="cag-h1">Congo African Grey Parrot Pair for Sale — Two Documented Birds, and the Honest Answer About Bonding</h1>
        <p class="lead">Most places selling you a pair will not tell you that two greys often end up preferring each other. We will, before you spend anything, because the answer changes which birds you should actually take home. Every bird here is captive-bred in the USA at our USDA AWA licensed aviary and leaves with its own CITES Appendix I documentation.</p>
        <div class="phero-cta">
          <a class="btn-clay" href="#available">See Pairs &amp; Singles →</a>
          <a class="btn-ghost" href="#bonding-short">Read the Bonding Answer</a>
        </div>
        <ul class="phero-ribbon">
          <li>Both birds papered</li><li>DNA sexed</li><li>Either bird singly</li><li>Ships nationwide</li>
        </ul>
      </div>
      <div class="phero-duo">
        <figure class="duo-a">
          <img src={`${IMG}/hero-congo-pair-midland-trust-560.webp`} width="1408" height="880"
               alt="Congo African Grey parrot pair for sale — a proof-of-life photo of both birds beside a dated name card at our Midland, Texas aviary"
               loading="eager" fetchpriority="high" decoding="async"  srcset={`${String(`${IMG}/hero-congo-pair-midland-trust-560.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-190$2')} 190w, ${String(`${IMG}/hero-congo-pair-midland-trust-560.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-350$2')} 350w, ${`${IMG}/hero-congo-pair-midland-trust-560.webp`} 560w`} sizes="45.2vw" />
        </figure>
        <figure class="duo-b">
          <img src={`${IMG}/hero-jins-jeni-congo-pair-together-320.webp`} width="1408" height="880"
               alt="Jins and Jeni, an unrelated companion pair of hand-raised Congo greys, sharing a bowl of vegetables"
               loading="eager" fetchpriority="high" decoding="async"  srcset={`${String(`${IMG}/hero-jins-jeni-congo-pair-together-320.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-230$2')} 230w, ${`${IMG}/hero-jins-jeni-congo-pair-together-320.webp`} 320w`} sizes="(max-width:900px) 45.3vw, 15.5vw" />
        </figure>
      </div>
    </div>
  </header>

  <!-- ═══ §2 COUNTER STRIP — 6 cards ═══ -->
  <section class="counter-wrap">
    <div class="container counter-row">
      {counters.map((c) => (
        <div class="cs"><span class="num">{c.n}</span><span class="cs-l">{c.l}</span></div>
      ))}
    </div>
  </section>

  <!-- ═══ MOBILE RAIL A — sticky TOP, never bottom ═══ -->
  <nav class="railA" aria-label="Jump to a section">
    <ul>
      {stops.map((s) => (
        <li><a href={s.h} data-stop={s.n}><span class="rn">{String(s.n).padStart(2, "0")}</span>{s.t}</a></li>
      ))}
    </ul>
  </nav>

  <div class="container cpair-body">

    <!-- ═══ DIAL 2 DARK-AVIARY + T3 BOARDING-PASS TOC ═══ -->
    <aside class="tdial" aria-label="Page contents">
      <div class="tdial-ring" id="dialRing" style="--p:0">
        <div class="tdial-inner"><span class="tnum" id="dialNum">1</span><span class="tof">of {stops.length}</span></div>
      </div>
      <p class="tdial-k">Boarding pass</p>
      <ol class="tdial-list" id="dialList">
        {stops.map((s) => (
          <li><a href={s.h} data-stop={s.n}><span class="ti">{String(s.n).padStart(2, "0")}</span><span class="tt">{s.t}</span></a></li>
        ))}
      </ol>
    </aside>

    <div class="cpair-main">

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>
      <!-- ═══ §3 BLUF — the compressed honest answer ═══ -->
      <section id="bonding-short">
        <h2 class="cag-h2">Will Two African Greys Bond to Each Other and Ignore You?</h2>
        <p class="lead bluf">Often, yes — if you house them together all day and treat them as a unit. Two greys close in age will make each other the primary relationship and reduce you to staff. It is not inevitable. Separate cages, fifteen to thirty minutes alone with each bird daily, and training them one at a time keeps both birds people-focused. If you cannot give that time, one grey will love you more than two ever will.</p>
        <h3 class="cag-h3">The Short Answer Before You Scroll</h3>
        <p>That paragraph is the whole page in miniature, and we would rather you read it before you look at a single price. Buying a companion pair of African Greys is not the same decision as buying two African Greys, and the difference is entirely in what you do after they arrive.</p>
        <h3 class="cag-h3">What This Page Covers, and Where to Jump</h3>
        <p>Below you will find every pair and single we currently have, the three genuine routes to owning two birds, what a documented pair costs elsewhere, and the protocol we hand every pair buyer. <a href="#one-bird">Our honest case for buying one bird instead</a> sits in the middle of the page rather than buried at the bottom, because for a fair number of households it is the right answer.</p>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>

      <!-- ═══ §4 AVAILABLE — Avail-B faceted by pairing route ═══ -->
      <section id="available">
        <h2 class="cag-h2">Which Congo African Grey Pairs and Singles Can You Reserve From Our Aviary?</h2>
        <p>Everything below is a real bird in our aviary right now, priced from our live inventory rather than from a template. The filter sorts by how you would take them home, because that is the decision most pair buyers are actually making.</p>

        <div class="availB">
          <div class="availB-rail">
            <p class="availB-k">Browse by route</p>
            {facets.map((f) => (
              <button class="facet" data-facet={f} type="button">{f}</button>
            ))}
            <p class="availB-ship">Ships nationwide · $185 airport · $350 home</p>
          </div>
          <div class="availB-grid" id="routeGrid">
            {routes.map((r) => (
              <article class="rcard" data-facet={r.facet}>
                <div class="rcard-photo">
                  {/* One `sizes` entry per layout the grid actually has: 1 full-width card
                      ≤640 (~345px at 375), 2 columns 641–980 (~346px at 768), 3 columns of
                      ~232px 981–1024, 3 of ~212px above. Every wrong value here costs
                      real bytes or real sharpness — a flat "240px" pulled the 640w master
                      into a 316px box, and "232px" on tablet under-served a 346px card. */}
                  <img src={`${r.img}-480.webp`} width="640" height="480"
                       alt={r.alt} loading="lazy" decoding="async"  srcset={`${String(`${r.img}-480.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-230$2')} 230w, ${`${r.img}-480.webp`} 480w`} sizes="(max-width:640px) 91.7vw, (max-width:900px) 45vw, 230px" />
                  <span class="rbadge">{r.facet}</span>
                </div>
                <div class="rcard-body">
                  <h3 class="rcard-name">{r.name}</h3>
                  <p class="rcard-price">{r.price}{r.split && <span class="rcard-split">{r.split}</span>}</p>
                  <p class="rcard-sub">{r.sub}</p>
                  <p class="rcard-trust">DNA sexed · CITES papered</p>
                  <p class="rcard-blurb">{r.blurb}</p>
                  <p class="rcard-ship">Ships nationwide · $185 airport · $350 home</p>
                  <a class="btn-clay rcta" href={r.href}>{r.cta} →</a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <h4 class="cag-h4">How Does the Deposit Work on a Two-Bird Reservation?</h4>
        <p>One deposit of $200 holds a pair, not two deposits. It comes off the balance and it stops us showing those birds to anyone else while you arrange the rest.</p>
        <h5 class="cag-h5">Every Price on This Page Comes From Our Live Inventory</h5>
        <p>If a bird sells, it comes off this page rather than sitting here as bait. We would rather show you four birds that exist than twelve that do not.</p>
        <h6 class="cag-h6"><span class="h6k">From the Aviary:</span> Jins Is the Elder of the Two by Roughly Eight Weeks</h6>
        <p class="note">That gap matters more than it sounds. Jins reached each developmental stage first, and Jeni copied him through most of it, which is part of why they settle so easily together.</p>

        <p class="ctaline"><a class="btn-clay" href="#reserve">Reserve This Pair →</a></p>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>
      <!-- ═══ §5 KEY TAKEAWAY — K1 Receipt + K2 Price-Tag ═══ -->
      <section id="takeaway">
        <h2 class="cag-h2">What Should You Know Before Committing to a Second Grey?</h2>
        <p>If you read nothing else on this page, read these five lines. They are the ones buyers tell us they wish someone had said before they bought.</p>
        <h3 class="cag-h3">The Five Facts That Decide This Purchase</h3>
        <div class="k1">
          <p class="k1-h">The receipt</p>
          <dl class="k1-list">
            <div><dt>A pair bonds to itself</dt><dd>unless you actively work against it, every day</dd></div>
            <div><dt>Two birds double the work</dt><dd>they do not halve it, and they do not entertain each other on your behalf</dd></div>
            <div><dt>Two cages, not one</dt><dd>shared housing is the fastest route to two birds that ignore you</dd></div>
            <div><dt>Both birds are papered separately</dt><dd>two CITES sets, two DNA certificates, two health certificates</dd></div>
            <div><dt>One bird is a complete answer</dt><dd>and for a first-time owner it is usually the better one</dd></div>
          </dl>
        </div>
        <div class="k2">
          <span class="k2-tag">From</span><span class="k2-price">$1,800</span>
          <p class="k2-note">A single documented Congo. A ready-made pair is $3,500, and our proven breeding pairs run $3,000 to $5,500.</p>
        </div>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>

      <!-- ═══ §6 THE BONDING TREATMENT ═══ -->
      <section id="pair-bond">
        <h2 class="cag-h2">Why Does a Pair of African Greys Sometimes Stop Needing You?</h2>
        <p>This is the question buyers ask us privately after they have already paid someone else, and it deserves a straight answer rather than a reassuring one. A grey is built to live in a flock and to pair-bond within it, and when you supply a second grey you have supplied the flock.</p>

        <h3 class="cag-h3">What a Pair Bond Actually Is in <em>Psittacus erithacus</em></h3>
        <p>A pair bond is a preferred social partner, not a marriage and not necessarily a mating. Two greys who preen each other, call to each other across a room and choose the same perch have formed one. <a href="https://www.parrots.org/" target="_blank" rel="noopener">World Parrot Trust field material on grey social structure</a> describes flocks that break into stable pairs well outside any breeding season, which is exactly what we see in our own aviary among birds far too young to breed. ↗</p>

        <h3 class="cag-h3">The Three Conditions That Make Human Bonding Fade</h3>
        <p>In our experience it takes all three together, and removing any one of them changes the outcome. The birds are unrelated, they are close in age, and they are housed together with constant access to each other and little separate handling.</p>
        <figure class="sec-img-wrap">
          <img class="sec-img inf-img" src={`${IMG}/pair-bond-three-risk-conditions.webp`} width="1376" height="768" style={"aspect-ratio:1376/768"}
               alt="The three stacked conditions that let a Congo African Grey pair bond to each other instead of to you"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/pair-bond-three-risk-conditions.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-480$2')} 480w, ${`${IMG}/pair-bond-three-risk-conditions.webp`} 1376w`} sizes="(max-width:1024px) 100vw, 59.4vw" />
          <figcaption class="img-note">All three present is the strongest pair bond. Remove any one of them and the human bond holds.</figcaption>
        </figure>
        <h4 class="cag-h4">Does Buying Two Birds at Once Cause This?</h4>
        <p>Buying two at once raises the odds, because neither bird has an established relationship with you to fall back on. A grey that has lived with you for two years before a second arrives usually keeps its human bond intact.</p>
        <h4 class="cag-h4">Does It Matter If the Two Birds Are Unrelated?</h4>
        <p>It does, and not in the direction most people assume. Unrelated birds of similar age are more likely to pair-bond than siblings raised together, which is one reason the pairs sold as ready-made are the ones most likely to end up self-sufficient.</p>
        <h5 class="cag-h5">Owners Report Both Outcomes, and Husbandry Decides Which</h5>
        <p>Read enough owner threads and you will find people whose two greys adore them and people whose two greys barely acknowledge them. The difference is almost never the birds.</p>
        <h6 class="cag-h6"><span class="h6k">Before You Commit:</span> Our Own Jins and Jeni Meet All Three Risk Conditions</h6>
        <p class="note">They are unrelated, they are eight weeks apart, and they have been housed together since they weaned. We are telling you that about our own flagship pair because it is true and because the protocol below is the answer to it.</p>
      </section>

      <figure class="sec-img-wrap">
        <img class="sec-img og-photo" src={`${IMG}/male-female-african-greys-shared-space.webp`} width="1408" height="768"
             alt="Two African Greys sharing a perch inside their enclosure, the housing arrangement that accelerates a pair bond"
             loading="lazy" decoding="async"  srcset={`${String(`${IMG}/male-female-african-greys-shared-space.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-460$2')} 460w, ${`${IMG}/male-female-african-greys-shared-space.webp`} 1408w`} sizes="(max-width:1024px) 92.1vw, 59.4vw" />
        <figcaption class="img-note">Constant shared access is the single strongest predictor of a pair that stops needing people.</figcaption>
      </figure>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>
      <!-- ═══ §7 THE COUNTERWEIGHT ═══ -->
      <section id="protects">
        <h2 class="cag-h2">What Does a Bonded Pair Protect Your Grey From?</h2>
        <p>Everything above is one half of the trade, and reporting only that half would be as misleading as the sales pages that report neither. There are real things a pair gives a grey that a single bird never gets.</p>

        <h3 class="cag-h3">The One-Person-Bird Problem a Single Grey Often Develops</h3>
        <p>Greys are notorious for choosing one human and defending that choice against everyone else in the house. It is the most common behavioural complaint we field, and it lands hardest on families. A second bird spreads the social load and takes the edge off it.</p>

        <figure class="sec-img-wrap">
          <img class="sec-img og-photo" src={`${IMG}/two-trained-african-greys-with-owner.webp`} width="1408" height="768"
               alt="Two hand-tame greys perched at a keeper's shoulder at once, the social load spread across more than one bird"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/two-trained-african-greys-with-owner.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-460$2')} 460w, ${`${IMG}/two-trained-african-greys-with-owner.webp`} 1408w`} sizes="(max-width:1024px) 92.1vw, 59.4vw" />
          <figcaption class="img-note">Two birds comfortable with the same person at the same time. That is the outcome the protocol below is aiming at.</figcaption>
        </figure>

        <h3 class="cag-h3">Boredom, Plucking, and the Cost of an Under-Occupied Grey</h3>
        <p>A grey alone in a quiet house for nine hours is an intelligent animal with nothing to do. <a href="https://lafeber.com/pet-birds/" target="_blank" rel="noopener">Lafeber's companion-bird behaviour library</a> treats enrichment and social contact as core husbandry rather than enrichment extras, and company is one form of that contact. ↗</p>
        <figure class="sec-img-wrap">
          <img class="sec-img inf-img" src={`${IMG}/pair-versus-single-grey-tradeoff.webp`} width="1408" height="768" style={"aspect-ratio:1408/768"}
               alt="One grey against two greys, weighed column by column, with neither side drawn as the winner"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/pair-versus-single-grey-tradeoff.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-480$2')} 480w, ${`${IMG}/pair-versus-single-grey-tradeoff.webp`} 1408w`} sizes="(max-width:1024px) 100vw, 59.4vw" />
          <figcaption class="img-note">Both columns are true at once. Which one you want decides the purchase.</figcaption>
        </figure>
        <h4 class="cag-h4">Are Two Greys Really Less Neurotic Than One?</h4>
        <p>Often, in households where the birds would otherwise be alone all day. Not reliably, in households where one bird would have had constant company anyway.</p>
        <h5 class="cag-h5">Feather-Destructive Behaviour Is Multi-Causal, Never Just Loneliness</h5>
        <p>Plucking has dietary, medical, hormonal and environmental drivers, and an avian vet works through all of them. <a href="https://www.aav.org/" target="_blank" rel="noopener">The Association of Avian Veterinarians directory</a> is where to start if you are seeing it. ↗</p>
        <h6 class="cag-h6"><span class="h6k">Two-Bird Note:</span> Company Is Not a Treatment for Plucking, and We Never Sell It as One</h6>
        <p class="note">If a seller offers you a second bird as a fix for a plucking grey, they are guessing with your money.</p>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>

      <!-- ═══ §8 THE PROTOCOL ═══ -->
      <section id="protocol">
        <h2 class="cag-h2">How Do You Keep a Pair Tame and Still Bonded to You?</h2>
        <p>This is the part nobody hands you at the point of sale, and it is the whole difference between two birds that love your household and two birds that live in it. None of it is difficult. All of it is daily.</p>

        <h3 class="cag-h3">Separate One-to-One Time, Every Day, Per Bird</h3>
        <p>Fifteen to thirty minutes with each bird, alone, out of sight of the other. Not shared time in the same room. The point is that each bird experiences you as its own relationship rather than as a feature of the environment they share.</p>

        <h3 class="cag-h3">Training Each Bird Alone Rather Than as a Unit</h3>
        <p>Target training, step-up, recall, simple foraging puzzles — done individually. A bird that has learned something with you has a reason to seek you out. Two birds trained together learn to watch each other instead.</p>

        <figure class="fs-video">
          <video controls preload="none" width="1280" height="720"
                 poster={`${IMG}/tamed-pair-african-greys-on-shoulder-760.webp`}>
            <source src="/video/congo-pair-socialization.mp4" type="video/mp4" />
          </video>
          <figcaption><span class="fsv-tag">Our aviary · Midland, TX</span> A one-to-one socialisation session, filmed here. This is what each bird in a pair needs on its own, away from the other.</figcaption>
        </figure>

        <h3 class="cag-h3">Why We Recommend Two Cages, Not One</h3>
        <p>Two cages is the structural version of everything above. It gives you a way to separate without a confrontation, it lets each bird have its own territory, and it means an illness in one bird is not automatically an illness in both.</p>
        <figure class="sec-img-wrap">
          <img class="sec-img inf-img" src={`${IMG}/keeping-a-pair-tame-daily-protocol.webp`} width="1376" height="768" style={"aspect-ratio:1376/768"}
               alt="The four daily habits that keep both birds in a two-grey household focused on people"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/keeping-a-pair-tame-daily-protocol.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-480$2')} 480w, ${`${IMG}/keeping-a-pair-tame-daily-protocol.webp`} 1376w`} sizes="(max-width:1024px) 100vw, 59.4vw" />
          <figcaption class="img-note">Four habits, done daily. Skipping them is how a pair drifts away from its owners.</figcaption>
        </figure>
        <h4 class="cag-h4">30 Minutes a Day per Bird Is the Number That Keeps a Pair Tame</h4>
        <p>Fifteen minutes is the floor and thirty is comfortable. Two birds therefore need roughly an hour of your undivided attention a day before you count any shared time at all.</p>
        <h4 class="cag-h4">Can You Undo a Pair Bond That Has Already Formed?</h4>
        <p>Partially, and slowly, and it is far harder than preventing it. This is why the first thirty days matter more than the first year.</p>
        <h5 class="cag-h5">Separating a Settled Pair Causes Measurable Distress</h5>
        <p>Splitting two birds who have lived together for years is not a neutral act, and we would not recommend buying a pair on the assumption you can undo it later.</p>
        <h6 class="cag-h6"><span class="h6k">Two-Bird Note:</span> The Midland Socialization Method Applied to Two Birds</h6>
        <p class="note">Our house method puts every chick through family handling and out-of-cage routine with several people. With a pair we run it twice, in parallel, deliberately keeping the two birds' sessions apart so neither learns to rely on the other's confidence.</p>

        <p class="ctaline"><a class="btn-clay" href="#reserve">Ask Us Which Bird Suits You →</a></p>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>
      <!-- ═══ §9 THE STEP-DOWN ═══ -->
      <section id="one-bird">
        <h2 class="cag-h2">When Is One African Grey the Better Buy?</h2>
        <p>We sell more birds by answering this honestly than we would by avoiding it, and it is the reason Jins and Jeni can be split. A pair is a configuration, not an upgrade.</p>

        <h3 class="cag-h3">Two Birds Is Two Lifetimes, Not One Purchase</h3>
        <p>A Congo African Grey lives roughly 40 to 60 years in good care. Buying a pair is not one long commitment, it is two overlapping ones, and the second bird will very likely outlive the arrangement you are imagining today. Households that think that through and still want two are the ones a pair suits.</p>

        <h3 class="cag-h3">Buyer Profiles That Do Better With a Single Grey</h3>
        <p>If you want the closest possible relationship with a parrot, buy one. If this is your first parrot, buy one — a single grey is a large enough project on its own. If your daily free time is genuinely limited, buy one, because two birds without individual attention is the configuration that produces the outcome at the top of this page.</p>

        <h3 class="cag-h3">Buying One Now and a Second Later</h3>
        <p>This is the route we quietly recommend most often. Take one bird, build the relationship, and add a second in a year or two if the household still wants it. The established bird keeps its human bond, and the new arrival learns from a grey who already trusts people.</p>
        <figure class="sec-img-wrap">
          <img class="sec-img inf-img" src={`${IMG}/one-grey-or-two-decision-guide.webp`} width="1376" height="768" style={"aspect-ratio:1376/768"}
               alt="A buy-one or buy-two decision guide for African Grey households, split by free time and experience"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/one-grey-or-two-decision-guide.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-480$2')} 480w, ${`${IMG}/one-grey-or-two-decision-guide.webp`} 1376w`} sizes="(max-width:1024px) 100vw, 59.4vw" />
          <figcaption class="img-note">There is no wrong answer on this chart, only a wrong match to a household.</figcaption>
        </figure>
        <h4 class="cag-h4">Will a Single Grey Be Lonely While You Work?</h4>
        <p>A single grey in an empty house needs foraging work, radio or background noise, a window view, and a real reunion when you get home. That is a manageable list, and it is a smaller commitment than a second bird.</p>
      </section>

      <div class="seam-wrap" aria-hidden="true"><img class="seam" src={seam} alt="" width="182" height="60" loading="lazy" decoding="async" /></div>

      <!-- ═══ §10 TABLE F — PAIRING ROUTES ═══ -->
      <section id="routes">
        <h2 class="cag-h2">How Do the Three Routes to a Pair Compare?</h2>
        <p>Three genuinely different purchases get called "a pair", and conflating them is how buyers end up with breeding stock in a living room. Here is what separates them.</p>

