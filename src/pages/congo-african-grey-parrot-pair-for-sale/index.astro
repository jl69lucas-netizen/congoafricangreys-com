<script is:inline>
  (function () {
    /* Avail-B route filter */
    var grid = document.getElementById('routeGrid');
    if (grid) {
      document.querySelectorAll('.facet').forEach(function (b) {
        b.addEventListener('click', function () {
          var f = b.getAttribute('data-facet');
          document.querySelectorAll('.facet').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
          grid.querySelectorAll('.rcard').forEach(function (c) {
            c.classList.toggle('hide', f !== 'All Routes' && c.getAttribute('data-facet') !== f);
          });
        });
      });
    }
    /* Dial + rail scroll-spy — a static ring reads as broken.
       Keyed to the dial's OWN hrefs, not to the page's section order: the page carries
       23 sections and the rail lists 18, so indexing document sections would light the
       wrong stop from #takeaway onward. */
    var ring = document.getElementById('dialRing'), num = document.getElementById('dialNum');
    var links = Array.prototype.slice.call(document.querySelectorAll('.tdial-list a, .railA a'));
    var stopEls = Array.prototype.slice.call(document.querySelectorAll('.tdial-list a')).map(function (a) {
      return document.getElementById(a.getAttribute('href').slice(1));
    }).filter(Boolean);
    /* Position-derived, not IntersectionObserver-derived. An IO whose callback lets the
       LAST intersecting entry win reported "18 of 18" on first paint: before the lazy
       images and webfont resolved, the document was short enough that most sections sat
       inside the observer band at once, and the final entry set the ring. Reading scroll
       position answers "which stop am I in" directly, with no first-paint race. */
    if (ring && stopEls.length) {
      var active = -1, tops = [], throttle = 0;
      var measure = function () {
        tops = stopEls.map(function (e) { return e.getBoundingClientRect().top + scrollY; });
      };
      var sync = function () {
        var line = scrollY + (matchMedia('(max-width:1024px)').matches ? 170 : 150);
        var i = 1;
        for (var k = 0; k < tops.length; k++) { if (tops[k] <= line) i = k + 1; }
        if (i === active) return;
        active = i;
        num.textContent = i;
        ring.style.setProperty('--p', (i / stopEls.length) * 100);
        links.forEach(function (a) { a.classList.toggle('on', +a.getAttribute('data-stop') === i); });
      };
      /* setTimeout, NOT requestAnimationFrame. rAF only runs while the page is painting,
         so a `queued = true; requestAnimationFrame(sync)` guard latches on permanently the
         first time the tab is occluded or backgrounded and the dial silently freezes on
         whichever stop it last saw. Measured here: the ring stuck on 10 through four
         scrolls. Offsets are cached, so a scroll tick is 18 array reads, no layout. */
      var onScroll = function () {
        if (throttle) return;
        throttle = setTimeout(function () { throttle = 0; sync(); }, 90);
      };
      var resync = function () { measure(); active = -1; sync(); };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', resync, { passive: true });
      addEventListener('hashchange', resync);
      /* The document is still growing at first paint (lazy images, webfont), and a landing
         on #hash fires no scroll event, so one early measure is not enough. */
      addEventListener('load', resync);
      [120, 500, 1500].forEach(function (t) { setTimeout(resync, t); });
      resync();
    }
  })();
</script>

<style>
:root { --cp-ink:#1c1a18; --cp-mid:#5a5248; --cp-bd:#ede5dc; --cp-green:#2D6A4F; --cp-clay:#e8604c; --cp-clayink:#c8472f; --cp-claytext:#b04228; --cp-cream:#faf7f4; }
/* THE root cause of "jump links on mobile not working". A global `scroll-behavior:smooth`
   applies to this 31,000px page, so one rail tap starts a multi-second crawl through
   ~9,000px that any thumb-touch cancels. Measured: click a chip, wait 1.2s, scrollY is
   still 25. The for-sale cluster spec requires `scroll-behavior:auto` on pages carrying a
   jump rail (cag-for-sale-page-builder §5, memory reference_smooth_scroll_kills_jump_links).
   Scoped with :has() so no sibling page loses its smooth scrolling. */
:global(html:has(.cpair)) { scroll-behavior:auto; }

/* The site header measures 96px, not the 72px this page had been assuming. At 72 the
   sticky rail parked 24px behind the header and every jump link landed underneath both.
   Measured in Playwright: body>header rect h=96, .railA h=52. (page-hardening §1b) */
.cpair { --hdr:96px; --rail-h:52px; background:var(--cp-cream); color:var(--cp-ink); overflow-x:clip; }
.cpair .container { max-width:1200px; margin:0 auto; padding:0 clamp(16px, 4vw, 48px); }
.cpair p { max-width:70ch; color:var(--cp-mid); line-height:1.65; }
