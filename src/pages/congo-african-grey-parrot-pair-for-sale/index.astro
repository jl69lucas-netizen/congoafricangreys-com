/* Framed seam, not a floating logo: two clay hairlines flanking the wordmark (§4).
   Gutters cut ~40% (2.4/1.7rem → 1.45/1.05rem, plus the .5rem first-heading rule below).
   Measured seam-emblem-to-H2 distance: 100px → 60px. The seam is a punctuation mark
   between sections, and it was reading as a page break. */
.seam-wrap { display:flex; align-items:center; gap:clamp(12px,3vw,20px); margin:1.45rem 0 1.05rem; }
.seam-wrap::before, .seam-wrap::after { content:""; flex:1; height:1px;
  background:linear-gradient(to right, transparent, rgba(232,96,76,.42), transparent); }
.seam { display:block; margin:0; height:34px; width:auto; opacity:.92; flex:none; }

/* ── Shipping tiers — both supplied images, one card per delivery option ── */
.ship-tiers { display:grid; grid-template-columns:repeat(auto-fit, minmax(258px,1fr)); gap:14px; margin:1.1rem 0; }
.ship-t { background:#fff; border:1px solid var(--cp-bd); border-radius:20px; overflow:hidden; box-shadow:0 2px 12px rgba(60,30,10,.05); }
.ship-t img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
/* Qualified with `.cpair p` on purpose: a bare `.ship-tier{color}` loses to the page's own
   `.cpair p` rule — the exact §1l collision that rendered this text at 1.19:1 elsewhere. */
.cpair p.ship-tier { margin:13px 15px 0; font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:var(--cp-green); font-weight:700; max-width:none; }
.cpair p.ship-fig { margin:2px 15px 0; font-family:var(--font-lora, Georgia, serif); font-size:1.55rem; color:var(--cp-claytext); max-width:none; }
.cpair p.ship-b { margin:5px 15px 15px; font-size:.86rem; color:var(--cp-mid); max-width:none; }

/* ── Framed video (kit .fs-video), never a bare <video> ── */
.fs-video { margin:1.2rem 0; max-width:760px; background:#20342b; border-radius:20px; overflow:hidden; }
.fs-video video { width:100%; height:auto; display:block; aspect-ratio:16/9; object-fit:cover; background:#20342b; }
.fs-video figcaption { padding:12px 16px; font-size:.86rem; color:#dcefe4; line-height:1.55; }
.fsv-tag { display:inline-block; font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:#c9f2db; margin-right:8px; }

/* ── Tables: F pairing routes + A comparison ── */
.tF-wrap, .tA-wrap { overflow-x:auto; margin:1rem 0; }
.tF, .tA { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--cp-bd); border-radius:14px; overflow:hidden; font-size:.84rem; }
.tF caption, .tA caption { caption-side:top; text-align:left; background:var(--cp-green); color:#fff; padding:8px 14px; font-size:var(--fs-micro); letter-spacing:.1em; text-transform:uppercase; }
.tF th, .tF td, .tA th, .tA td { padding:10px 13px; border-bottom:1px solid var(--cp-bd); text-align:left; vertical-align:top; color:var(--cp-mid); }
.tF thead th, .tA thead th { background:#f6efe8; color:var(--cp-ink); font-size:var(--fs-micro); letter-spacing:.05em; text-transform:uppercase; }
.tF tbody th, .tA tbody th { color:var(--cp-ink); font-weight:700; }
.tF tbody tr:first-child th { box-shadow:inset 3px 0 0 var(--cp-clay); }

/* ── Geo cards ── */
/* Named areas, because `grid-row:1/span 2` on the arrow alone let auto-placement drop it
   into column 1 and collapse the 1fr label track to one word per line. */
.geo-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(248px,1fr)); gap:10px; margin:1rem 0; }
.geo-cards a { display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"k a" "n a";
  gap:2px 10px; background:#fff; border:1px solid var(--cp-bd); border-radius:14px; padding:11px 13px;
  text-decoration:none; min-height:44px; align-items:center;
  transition:border-color .15s cubic-bezier(.4,0,.2,1), transform .15s cubic-bezier(.4,0,.2,1); }
.geo-cards a:hover { border-color:var(--cp-clay); transform:translateY(-2px); }
.geo-k { grid-area:k; color:var(--cp-green); font-weight:700; font-size:.84rem; line-height:1.3; }
.geo-n { grid-area:n; font-size:var(--fs-micro); color:var(--cp-mid); line-height:1.3; }
.geo-a { grid-area:a; align-self:center; color:var(--cp-claytext); font-weight:700; font-size:1rem; }

/* ── Reviews ── */
.quotes { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px,1fr)); gap:16px; margin:1rem 0; }
.quote-c { background:#fff; border:1px solid var(--cp-bd); border-radius:20px; padding:16px; margin:0; }
.quote-c img { width:64px; height:64px; border-radius:50%; object-fit:cover; }
.quote-c blockquote { margin:.6rem 0; padding:0; border:0; }
.quote-c blockquote p { font-size:.84rem; max-width:none; }
.quote-c figcaption { font-size:var(--fs-micro); color:var(--cp-claytext); font-weight:700; }

/* ── Read cards + xsell ── */
.read-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:14px; margin:.8rem 0; }
.read-cards a { background:#fff; border:1px solid var(--cp-bd); border-radius:16px; overflow:hidden; text-decoration:none; display:block; }
.read-cards img { width:100%; height:130px; object-fit:cover; display:block; }
.read-cards span { display:block; padding:10px 12px; color:var(--cp-green); font-weight:700; font-size:.82rem; }
.xsell { background:#f6efe8; border:1px solid var(--cp-bd); border-radius:16px; padding:14px 16px; margin:1rem 0; }
.xsell-k { font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; color:var(--cp-mid); margin:0 0 6px; }
.xsell p { font-size:.84rem; margin:.35rem 0; }

/* ── FAQ-B refreshed, two-column ── */
.faqB { columns:2; column-gap:16px; margin:1rem 0; }
.faqB-i { break-inside:avoid; background:#fff; border:1px solid var(--cp-bd); border-radius:14px; padding:11px 14px; margin:0 0 10px; }
.faqB-i summary { cursor:pointer; font-weight:600; color:var(--cp-ink); font-size:.86rem; list-style:none; min-height:24px; }
.faqB-i summary::-webkit-details-marker { display:none; }
.faqB-i summary::after { content:"+"; float:right; color:var(--cp-claytext); font-weight:700; }
.faqB-i[open] summary::after { content:"–"; }
.faqB-i p { font-size:.82rem; margin:.5rem 0 0; }

/* ── Contact form ── */
.fs-form { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:18px; margin:1rem 0; }
.form-side { background:#20342b; color:#dcefe4; border-radius:20px; padding:16px 18px; }
.fsx-k { font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; color:#9fc7b0; margin:0 0 8px; }
.fsx-list { list-style:none; margin:0; padding:0; }
.fsx-list li { display:flex; justify-content:space-between; gap:10px; padding:6px 0; border-bottom:1px dashed #3b5a49; font-size:.8rem; }
.fsx-list li:last-child { border-bottom:0; }
.fsx-list li span:last-child { color:#f5b8a8; font-weight:700; white-space:nowrap; }
.fsx-ship { font-size:var(--fs-micro); color:#c9f2db; margin:10px 0 4px; }
.fsx-note { font-size:var(--fs-micro); color:#c9f2db; margin:0; }
.fs-fields { background:#fff; border:1px solid var(--cp-bd); border-radius:20px; padding:16px 18px; }
.fld, .fld2 label { display:block; font-size:var(--fs-micro); color:var(--cp-ink); font-weight:600; margin-bottom:10px; }
.fld2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.fs-fields input, .fs-fields select, .fs-fields textarea { width:100%; margin-top:4px; border:1.5px solid var(--cp-bd); border-radius:10px; background:#fff9f6; padding:9px 11px; font:inherit; font-size:16px; color:var(--cp-ink); }  /* 16px floor — under it iOS Safari auto-zooms on focus */
.fs-fields input:focus, .fs-fields select:focus, .fs-fields textarea:focus { outline:none; border-color:var(--cp-clay); box-shadow:0 0 0 3px rgba(232,96,76,.1); }
.fs-fields .btn-clay { border-radius:12px; margin-top:4px; }
.fs-fine { font-size:var(--fs-micro); color:var(--cp-mid); margin:.6rem 0 0; }

/* ── §1l specificity guard — `.cpair p` (0,1,1) outranks a bare component class (0,1,0).
   Measured in Playwright: .tdial-k and .fsx-ship were rendering at 1.72:1 on the dark
   panels because the page rule silently won. Qualify every component paragraph colour. ── */
.cpair p.tdial-k { color:#9fc7b0; }
.cpair p.fsx-k { color:#9fc7b0; }
.cpair p.fsx-ship, .cpair p.fsx-note { color:#c9f2db; }
.cpair p.rcard-sub { color:var(--cp-green); }
.cpair p.xsell-k, .cpair p.availB-k { color:var(--cp-mid); }
.cpair p.k2-note { color:#7a4636; }
.cpair p.k1-h { color:#fff; }
.cpair p.fs-fine { color:var(--cp-mid); }
.cpair p.availB-ship { color:var(--cp-mid); }
/* Same collision, the max-width axis: `.cpair p{max-width:70ch}` (0,1,1) beat the bare
   component classes (0,1,0), so the receipt's green header band stopped at 443px inside
   an 880px card. Measured, not inferred. */
.cpair p.k1-h, .cpair p.xsell-k, .cpair p.fsx-k, .cpair p.availB-k,
.cpair p.tdial-k, .cpair p.k2-tag { max-width:none; }

/* ── §1k drift fix: these three classes shipped in markup with no rule ── */
.phero-copy { min-width:0; }
/* The BLUF block is what answer engines extract — give it visible weight. */
.cpair p.bluf { background:#fff; border:1px solid var(--cp-bd); border-left:0; border-radius:14px; padding:14px 16px; margin:.6rem 0 1rem; font-size:clamp(.95rem,1.7vw,1.06rem); color:var(--cp-ink); box-shadow:0 2px 12px rgba(60,30,10,.05); }
/* OG photos take the taller 4:5 frame on mobile; infographics never do (they lose baked-in text). */
@media (max-width:640px) { .cpair .sec-img.og-photo { aspect-ratio:4/5; } }
.cpair .quote-c blockquote p { color:var(--cp-ink); }

/* Body links underlined + external arrow */
.cpair-main p a { color:var(--cp-claytext); text-decoration:underline; text-underline-offset:2px; }
/* Buttons living inside a <p> must not inherit the body-link colour — measured at 1.2:1
   (clay text on clay fill) on all six mid-page CTAs before this rule existed. */
.cpair-main p a.btn-clay { color:#fff; text-decoration:none; }
.cpair-main p a.btn-ghost { color:var(--cp-claytext); text-decoration:none; }
.cpair-main p a.btn-ghost:hover { color:#fff; }
.cpair-main p a[target="_blank"]::after { content:"\2197"; margin-left:2px; }

/* ── Readable floors ──────────────────────────────────────────────────────────
   A Playwright sweep at 375px found 108 text nodes rendering under 12.5px, down to
   10.6px. PRODUCT.md notes the audience skews older and DESIGN.md §Accessibility
   says text size matters more than usual here. The global --fs-h5 clamp bottoms out
   at 11px, so this is a site-wide condition — raised page-scoped here and logged to
   the backlog. Every desktop MAXIMUM below is unchanged, so the page still matches
   its siblings at 1280. ─────────────────────────────────────────────────────── */
.cpair .cag-h5 { font-size:clamp(.875rem, 1.1vw, .95rem); }
.cpair .cag-h6 { font-size:clamp(.85rem, 1.1vw, .9rem); }
.cpair .cs-l { font-size:clamp(0.79rem,2.2vw,0.82rem); }
.cpair .phero-ribbon li { font-size:clamp(0.79rem,2vw,0.82rem); }
.cpair .phero .eyebrow { font-size:var(--fs-micro); }
/* Letterspaced uppercase chrome. DESIGN.md's --fs-eyebrow bottoms out at 10px; that is
   what read as "too tiny", so the floor here is 12px and the ceiling is unchanged.
   `.tdial-k` is deliberately NOT in this list: it belongs to the desktop dial, whose row
   metrics are sized to fit 18 stops without a scrollbar, and which is display:none at
   every width where the complaint applies. */
.cpair .xsell-k, .cpair .availB-k,
.cpair .fsx-k, .cpair .k1-h, .cpair .k2-tag { font-size:clamp(0.79rem,1vw,0.82rem); }
.cpair .availB-ship, .cpair .fsx-ship, .cpair .fsx-note { font-size:.8rem; }
/* Route label: quieter than it was (.75rem opaque pill), still above this page's 11.5px
   readable floor — it is a caption, not body copy. */
.cpair .rbadge { font-size:var(--fs-micro); }
.cpair .rcard-split { font-size:var(--fs-micro); }
.cpair .fsv-tag { font-size:var(--fs-micro); }
.cpair p.ship-tier { font-size:var(--fs-micro); }
.cpair .tF caption, .cpair .tA caption { font-size:var(--fs-micro); }
.cpair .facet { font-size:.82rem; }
.cpair .fsx-list li { font-size:.85rem; }
.cpair .fs-fine { font-size:var(--fs-micro); }
.cpair .fld, .cpair .fld2 label { font-size:.82rem; }
.cpair .quote-c figcaption { font-size:.82rem; }
.cpair .tF, .cpair .tA { font-size:.88rem; }
.cpair .tF thead th, .cpair .tA thead th { font-size:var(--fs-micro); }
.cpair .k1-list dt, .cpair .k1-list dd { font-size:.88rem; }
.cpair .faqB-i summary { font-size:.9rem; }
.cpair .faqB-i p { font-size:.86rem; }
.cpair .quote-c blockquote p { font-size:.88rem; }
/* NOT a defect, do not "fix" it: my own right-edge probe flagged `.bc-pill` at 424px in
   a 375px viewport. `.bc-pill-wrap` is an intentional `overflow-x:auto` scroller with a
   trailing fade mask, added deliberately so long trails swipe instead of clipping. The
   probe was missing it from its scroller exclusion list, exactly the failure class in
   skills/cag-gate-integrity.md. No rule belongs here. */

/* ── Tablet ── */
@media (max-width:1024px) {
  .cpair-body { grid-template-columns:1fr; }
  .tdial { display:none; }
  .railA { display:block; position:sticky; top:var(--hdr); z-index:40; background:rgba(250,247,244,.985); border-bottom:1px solid var(--cp-bd); box-shadow:0 6px 14px rgba(60,30,10,.07); }
  .railA ul { display:flex; gap:10px; overflow-x:auto; list-style:none; margin:0; padding:9px clamp(16px,4vw,48px); scrollbar-width:none; }
  .railA ul::-webkit-scrollbar { display:none; }
  .railA a { display:inline-block; white-space:nowrap; font-size:.82rem; color:var(--cp-green); background:#eaf4ef; border-radius:50px; padding:7px 13px; text-decoration:none; min-height:24px; }
  /* Anchors must clear the header AND the rail that sits under it, not the header alone. */
  .cpair-main section { scroll-margin-top:calc(var(--hdr) + var(--rail-h) + 14px); }
  .counter-row { grid-template-columns:repeat(3, minmax(0,1fr)); }
  .fs-form { grid-template-columns:1fr; }
  .faqB { columns:1; }
}

/* ── Mobile ── */
@media (max-width:980px) {
  .phero-grid { grid-template-columns:1fr; max-height:none; min-height:0; gap:16px; }
  .phero-duo { order:-1; position:static; padding-bottom:0; display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .duo-b { position:static; width:auto; transform:rotate(1.2deg); }
  .phero-ribbon { grid-template-columns:repeat(2, minmax(0,1fr)); }
  .availB { grid-template-columns:1fr; }
  .availB-rail { position:static; display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; }
  .availB-k, .availB-ship { display:none; }
  .facet { width:auto; white-space:nowrap; margin-bottom:0; }
  .availB-grid { grid-template-columns:repeat(2, minmax(0,1fr)); }
}
@media (max-width:640px) {
  .counter-row { grid-template-columns:repeat(2, minmax(0,1fr)); }
  /* Content-width pills stacked in a column read as two ragged left-aligned blocks.
     Equal full-width rows instead — tidier, and a bigger target for each. */
  .phero-cta { display:grid; grid-template-columns:1fr; gap:9px; }
  .phero-cta a { text-align:center; }
  /* ONE card per row, photo first at full card width, every detail line stacked beneath.
     Two-up left ~136px of body width (which is why the description used to be
     display:none), and the horizontal split that replaced it squeezed the photo into a
     ~127px column and cut the birds' heads in half. Full width solves both: the masters
     are 640x480 and this box is 4:3, so `cover` crops nothing — the whole bird, face
     included, is inside the frame — and the text gets the full 343px measure. */
  .availB-grid { grid-template-columns:1fr; gap:14px; }
  .rcard-photo::after { height:76px; }
  .rbadge { left:14px; right:14px; bottom:10px; font-size:var(--fs-micro); letter-spacing:.08em; }
  .rcard-body { padding:14px 16px 16px; gap:5px; }
  .rcard-name { font-size:1.14rem; }
  .cpair p.rcard-price { font-size:1.1rem; }
  .cpair p.rcard-sub { font-size:.82rem; }
  .cpair p.rcard-blurb { font-size:.86rem; -webkit-line-clamp:3; }
  .cpair p.rcard-trust, .cpair p.rcard-ship { font-size:var(--fs-micro); }
  .rcard .rcta { align-self:stretch; text-align:center; padding:.68rem 1rem; font-size:.88rem; }
  .fld2 { grid-template-columns:1fr; }
  /* mobile table stacking — one card per row */
  .tF thead, .tA thead { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  .tF caption, .tA caption { display:block; border-radius:10px 10px 0 0; }
  .tF tr, .tA tr { display:block; border:1px solid var(--cp-bd); border-radius:12px; margin-bottom:10px; background:#fff; overflow:hidden; }
  .tF td, .tF tbody th, .tA td, .tA tbody th { display:block; border-bottom:1px dashed var(--cp-bd); padding:9px 13px; }
  .tF tbody th, .tA tbody th { background:#f6efe8; font-size:.95rem; }
  .tF td::before, .tA td::before { content:attr(data-label); display:block; font-size:var(--fs-micro); letter-spacing:.08em; text-transform:uppercase; color:var(--cp-mid); margin-bottom:2px; }
  .tF tbody tr:first-child th { box-shadow:none; }
  /* The five-fact receipt: two columns in a 343px box crushes both. Stack them. */
  .k1-list > div { grid-template-columns:1fr; gap:2px; padding:9px 0; }
  .k2 { grid-template-columns:auto minmax(0,1fr); align-items:baseline; gap:2px 8px; }
  .k2-note { max-width:none; }
  .sec-img { border-radius:12px; }
  /* Scene photos (a room, people, several birds) take the wider 5:4 mobile frame;
     single-bird portraits keep the taller 4:5 above. Infographics take neither. */
  .cpair .sec-img.og-photo.og-scene { aspect-ratio:5/4; }   /* beats .og-photo's 4:5 on specificity, not on source order */
  .cpair .sec-img.inf-img { width:100vw; margin-left:calc(50% - 50vw); max-width:none; border-radius:0; border-left:0; border-right:0; }
  .cpair .sec-img.inf-tall { width:auto; margin-left:0; max-width:100%; border-radius:12px; border:1px solid var(--cp-bd); }
  .ship-tiers { gap:12px; }
}
@media (prefers-reduced-motion:reduce) { * { transition:none !important; } }
</style>
</BaseLayout>
