.cpair .note { font-size:.92rem; }

/* ── Hero-A "Bonded Duo" ── */
.phero { padding:clamp(20px, 3vw, 30px) 0 clamp(18px, 2.6vw, 26px); }
.hero-duo .phero-grid { align-items:center; }
.phero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); gap:clamp(20px, 3vw, 40px); align-items:center; min-height:350px; max-height:420px; }
.phero .eyebrow { font-size:var(--fs-micro); letter-spacing:.14em; color:var(--cp-claytext); font-weight:600; margin:0 0 .5rem; }
.phero .cag-h1 { font-size:clamp(1.35rem, 2.6vw, 1.95rem); line-height:1.14; margin:0 0 .6rem; color:var(--cp-ink); }
.phero .lead { font-size:.88rem; margin:0 0 1rem; }
.phero-cta { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:.85rem; }
.phero-ribbon { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:6px; list-style:none; padding:0; margin:0; }
.phero-ribbon li { font-size:var(--fs-micro); color:var(--cp-green); background:#eaf4ef; border-radius:50px; padding:5px 9px; text-align:center; font-weight:600; }
/* Bonded Duo: one anchor photo + one overlapping inset. Absolute positioning is
   UNWOUND below 980px (trap #1 — an un-unwound absolute hero collapses on mobile). */
.phero-duo { position:relative; padding-bottom:26px; padding-right:10px; }
.phero-duo figure { margin:0; border-radius:16px; overflow:hidden; border:1px solid var(--cp-bd); box-shadow:0 3px 14px rgba(60,30,10,.07); background:#fff; }
.phero-duo img { width:100%; height:auto; object-fit:cover; display:block; aspect-ratio:16/10; }
.duo-a { transform:rotate(-1deg); }
.duo-b { position:absolute; right:-18px; bottom:-16px; width:36%; transform:rotate(2.5deg); box-shadow:0 6px 20px rgba(60,30,10,.18) !important; }

/* ── Counter strip, 6 cards, CLS-safe ── */
.counter-wrap { padding:6px 0 18px; }
