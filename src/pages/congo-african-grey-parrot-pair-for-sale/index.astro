        <figure class="sec-img-wrap">
          <img class="sec-img inf-img" src={`${IMG}/three-routes-to-an-african-grey-pair.webp`} width="1376" height="768" style={"aspect-ratio:1376/768"}
               alt="Ready-made pair, build your own, and proven breeding stock compared as three separate purchases"
               loading="lazy" decoding="async"  srcset={`${String(`${IMG}/three-routes-to-an-african-grey-pair.webp`).replace(/(-\d{2,4})?(\.[a-zA-Z0-9]+)$/, '-480$2')} 480w, ${`${IMG}/three-routes-to-an-african-grey-pair.webp`} 1376w`} sizes="(max-width:1024px) 100vw, 59.4vw" />
