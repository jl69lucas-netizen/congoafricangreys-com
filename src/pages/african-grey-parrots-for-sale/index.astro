---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatementLabel from '../../components/cag-library/StatementLabel.astro';
import clutch from '../../../data/clutch-inventory.json';
import prices from '../../../data/price-matrix.json';
import fin from '../../../data/financial-entities.json';
import locations from '../../../data/locations.json';

// ============================================================================
//  /african-grey-parrots-for-sale/ — the for-sale cluster HUB
//  Built from data/pages/african-grey-parrots-for-sale/board.json (Page Board, approved
//  on the board 2026-09-12). Headings are the record's; picks are approval.picks:
//    hero-c-mosaic-metrics#inventory-tiles · dial-2-dark-aviary · rail-a-price-chip
//    · birds: avail-a-grid (plain grid, no facet sidebar) · which: table-a-stacking
//    · price: k2-price-tag · route: timeline-strip (derived from the T5 stepper)
//    · papers: lab-report-table · who: split-feature · next: toc-t3-boarding-pass#spoke-index
//    · faq-c#spoke-links · takeaway k1-receipt + k2-price-tag
//  H6 prefixes reserved to this page: "Inventory Note:" · "Across the Cluster:" · "Before You Reserve:"
//  The hub enumerates NO states — the near-me router owns the grid (plan §0g). One link to it.
//  Prose written fresh from the record; sibling pages were read for shells and CSS only.
//  No reviews (all 17 in data/reviews.json are spent elsewhere). 3-3-3 stays out of the FAQ (locked).
// ============================================================================

const title = "African Grey Parrots for Sale in the USA | Congo & Timneh | C.A.Gs";
const description = "African Grey parrots for sale from the aviary that raised them: six Congo and Timneh birds with printed prices, PCR screening, DNA sexing and CITES paperwork, shipped to every state.";
const canonical = "https://congoafricangreys.com/african-grey-parrots-for-sale/";

const IMG = "/images/hub-page/";
const site = "https://congoafricangreys.com";
const seam = "/cag-fs-seam-emblem.webp";

const deposit = (prices as any).deposit_display;             // $200
const airport = (prices as any).airport_pickup_display;       // $185
const home = (prices as any).home_delivery_display;           // $350
const cabin = (fin as any).purchase_costs.delivery_options.flight_nanny.display; // from $750
const congoRange = (prices as any).variants.congo_african_grey.price_display;    // $1,700–$3,500
const timnehRange = (prices as any).variants.timneh_african_grey.price_display;  // $1,500–$1,600
const floor = timnehRange.split("–")[0];                       // $1,500
const congoFloor = congoRange.split("–")[0];                   // $1,700
const ceiling = congoRange.split("–")[1];                      // $3,500
const timnehCeiling = timnehRange.split("–")[1];               // $1,600
const congoWeight = (prices as any).variants.congo_african_grey.weight_grams;   // 400–600
const timnehWeight = (prices as any).variants.timneh_african_grey.weight_grams; // 275–375

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
];

// ---- Live inventory only. Sold birds never render and are never InStock. ----
const available = ((clutch as any).birds as any[]).filter((b) => b.status === "available");
const isTimneh = (b: any) => b.variant === "timneh_african_grey";
const subLabel = (b: any) => (isTimneh(b) ? "Timneh" : "Congo");
const groupKey = (b: any) => (b.sex === "pair" ? "pair" : isTimneh(b) ? "timneh" : "congo");
const groupCount = (k: string) => available.filter((b) => groupKey(b) === k).length;
const shortName = (b: any) => b.name.replace(" (Pair)", "");
const birdCount = available.length;
const birdWord = ["zero","one","two","three","four","five","six","seven","eight","nine"][birdCount] ?? String(birdCount);
const congoBirds = available.filter((b) => groupKey(b) === "congo");
const timnehBirds = available.filter((b) => groupKey(b) === "timneh");
const pairBirds = available.filter((b) => groupKey(b) === "pair");
const lowPrice = Math.min(...available.map((b) => b.price));
const highPrice = Math.max(...available.map((b) => b.price));

// ---- Photographs: this page's own crops from assets/brand (contact sheet 2026-09-12). Alts unique. ----
const birdImg: Record<string, { src: string; alt: string; pos: string }> = {
  "Bery": { src: IMG + "bery-congo-hen-hub-card", pos: "center 45%", alt: "Bery, a one year old Congo hen, held against a soft grey blanket" },
  "Amie": { src: IMG + "amie-congo-hen-hub-card", pos: "center 45%", alt: "Amie as a three month old Congo chick cupped in a hand" },
  "Roys": { src: IMG + "roys-congo-cock-hub-card", pos: "center 35%", alt: "Roys at four months, his head turned to the camera" },
  "Jins & Jeni (Pair)": { src: IMG + "jins-jeni-congo-companion-pair-hub-card", pos: "center 50%", alt: "Jins and Jeni side by side over a shared bowl" },
  "Elad": { src: IMG + "elad-timneh-cock-hub-card", pos: "center 45%", alt: "Elad the Timneh cock leaning into a scratch under his chin" },
  "Evie": { src: IMG + "evie-timneh-hen-hub-card", pos: "center 35%", alt: "Evie the Timneh hen on a wrist, the maroon of her tail just showing" },
};
// One line per bird: what this bird is like to live with — the hub's angle is the bird itself.
const birdBlurb: Record<string, string> = {
  "Bery": "Past the baby stage and already steady in a household. The one to choose if you want a grown hen who has done her settling here.",
  "Amie": "Still on the last of her hand-feedings and eating on her own more each week. Ready when weaned, not before.",
  "Roys": "The bold one of the clutch. Investigates first, retreats never. Best matched to a house with a routine he can join.",
  "Jins & Jeni (Pair)": "Two unrelated Congos who keep each other company. Sold together so neither goes alone.",
  "Elad": "A weaned Timneh cock, smaller and quicker to trust than his Congo cousins.",
  "Evie": "A watchful Timneh hen. She learns a household by observing it first, then joins in.",
};

// ---- Counter strip — every figure from a data file or the location registry. ----
const states = (locations as any).live_states as any[];      // 25 incl. the CA buy page
const metros = (locations as any).cities as any[];           // 15
const counters = [
  { n: String(birdCount), l: "Greys with a price today" },
  { n: floor, l: "Lowest card price" },
  { n: ceiling, l: "Ceiling: the companion pair" },
  { n: deposit, l: "Deposit that holds a bird" },
  { n: airport, l: "Airport cargo, any state" },
  { n: home, l: "Delivered to your door" },
  { n: "72h", l: "Written health guarantee" },
  { n: String(states.length + metros.length), l: "State and metro pages" },
];

// ---- One spine drives Dial 2 and Rail A. IDs are the record's section ids. ----
const sections = [
  { n: "01", id: "birds", label: "The birds", tag: birdCount + " now" },
  { n: "02", id: "which", label: "Congo or Timneh", tag: "Pick" },
  { n: "03", id: "price", label: "Price", tag: floor + "+" },
  { n: "04", id: "route", label: "Travel", tag: "3 steps" },
  { n: "05", id: "papers", label: "Paperwork", tag: "6 docs" },
  { n: "06", id: "who", label: "Who we are", tag: "Texas" },
  { n: "07", id: "next", label: "Next page", tag: "Index" },
  { n: "08", id: "faq", label: "Questions", tag: "12 Q" },
  { n: "09", id: "reserve", label: "Reserve", tag: "24h" },
];
const N = sections.length;

// ---- Table A: the Congo / Timneh fork, every figure from price-matrix.json. ----
const forkRows = [
  { k: "Adult weight", congo: congoWeight + " g", timneh: timnehWeight + " g", read: "Timneh is about a third smaller" },
  { k: "Tail", congo: "Bright red", timneh: "Dark maroon", read: "The quickest visual tell" },
  { k: "Beak", congo: "All black", timneh: "Horn-coloured upper mandible", read: "Visible from across a room" },
  { k: "Our price band", congo: congoRange, timneh: timnehRange, read: "Timneh sets the floor, the pair sets the ceiling" },
  { k: "Available now", congo: String(congoBirds.length + pairBirds.length * 2) + " birds", timneh: String(timnehBirds.length) + " birds", read: "Counted from the cards above" },
];

// ---- Lab-report table for the papers section. Every row is a document we actually hand over. ----
const docRows = [
  { f: "CITES paperwork", w: "Confirms the bird was hatched in captivity in the United States, with our aviary named", why: "The species is listed on the strictest treaty appendix; a bird hatched here needs this on file to be traded lawfully" },
  { f: "Hatch certificate and closed band", w: "Hatch date, parentage, and the number on the ring fitted as a chick", why: "Ties this bird to this aviary for life; the ring cannot be fitted to an adult" },
  { f: "PCR disease screening", w: "PBFD, Avian Polyomavirus and psittacosis results from a laboratory", why: "Screening before sale, with results in writing, not a verbal assurance" },
  { f: "DNA sex certificate", w: "Male or female, from a feather or blood sample, for every single bird", why: "Greys cannot be sexed by eye; the certificate is the only proof" },
  { f: "Avian veterinary certificate", w: "A health certificate issued before travel", why: "The one document the airline asks to see on the crate" },
  { f: "Written 72-hour guarantee", w: "The term, in writing, that starts when you take possession", why: "So the promise outlives the phone call" },
];

// ---- Spoke index: every spoke in the cluster, one boarding-pass row each. Anchors vary by design. ----
const spokes = [
  { n: "01", href: "/congo-african-grey-for-sale/", label: "Congo African Greys", tag: "Subspecies" },
  { n: "02", href: "/timneh-african-grey-for-sale/", label: "Timneh African Greys", tag: "Subspecies" },
  { n: "03", href: "/baby-african-grey-parrot-for-sale/", label: "Baby greys, still weaning", tag: "Age" },
  { n: "04", href: "/congo-african-grey-parrot-pair-for-sale/", label: "A Congo companion pair", tag: "Two birds" },
  { n: "05", href: "/african-grey-breeding-pair-for-sale/", label: "Breeding pairs", tag: "Aviculture" },
  { n: "06", href: "/african-greys-for-sale-with-health-guarantee/", label: "The health guarantee, in full", tag: "Guarantee" },
  { n: "07", href: "/dna-tested-african-grey-for-sale/", label: "DNA-tested greys", tag: "Proof" },
  { n: "08", href: "/hand-raised-african-grey-parrot-for-sale/", label: "Hand-raised, explained", tag: "Method" },
  { n: "09", href: "/captive-bred-african-grey-parrot/", label: "Hatched here, not trapped", tag: "Legality" },
  { n: "10", href: "/cites-african-grey-documentation/", label: "The paperwork page", tag: "Documents" },
  { n: "11", href: "/african-grey-parrot-bird-eggs-for-sale-usa/", label: "Fertile eggs", tag: "Eggs" },
  { n: "12", href: "/african-grey-parrot-adoption-cost/", label: "Adoption and first-year cost", tag: "Cost" },
  { n: "13", href: "/buy-african-grey-parrots-with-shipping/", label: "Buying with shipping", tag: "Online" },
  { n: "14", href: "/african-grey-parrots-for-sale-near-me/", label: "Your state or metro", tag: "Near you" },
  { n: "15", href: "/african-grey-parrot-price/", label: "Price guide", tag: "Cost" },
  { n: "16", href: "/how-to-avoid-african-grey-parrot-scams/", label: "Spotting a fake listing", tag: "Caution" },
  { n: "17", href: "/african-grey-parrot-breeders-comparison/", label: "Breeders compared", tag: "Compare" },
  { n: "18", href: "/african-grey-reviews/", label: "What buyers wrote", tag: "Reviews" },
];

// ---- Keep reading — thumbs are cut from each TARGET page's own hero (bake_read_card_thumbs.py). ----
const readMore = [
  { href: "/congo-african-grey-for-sale/", img: IMG + "read-congo-african-grey-for-sale-hero", kicker: "Subspecies", title: "Congo African Greys for sale", sub: "The larger grey with the red tail, priced bird by bird." },
  { href: "/buy-african-grey-parrots-with-shipping/", img: IMG + "read-buy-african-grey-parrots-with-shipping-hero", kicker: "Buying online", title: "Buying an African Grey with shipping", sub: "The proof-of-price page: what the number covers and how the bird travels." },
  { href: "/african-grey-parrots-for-sale-near-me/", img: IMG + "read-african-grey-parrots-for-sale-near-me-hero", kicker: "Near you", title: "African Greys for sale near you, state by state", sub: "The only page on this site that lists every state and metro we serve." },
  { href: "/how-to-avoid-african-grey-parrot-scams/", img: IMG + "read-how-to-avoid-african-grey-parrot-scams-hero", kicker: "Caution", title: "How to avoid an African Grey scam", sub: "The tests that remove nearly every fake listing before money moves." },
];

// ---- QAB — 12 questions from the PAA set, the related-search block and the query bucket. ----
const faqs = [
  { q: "How much does an African Grey parrot cost from you?", a: "Between " + floor + " and " + ceiling + ". The low end is a Timneh hen, the top is the two-bird companion pair, and every price is printed on the bird's card on this page rather than quoted after you enquire. A single Congo runs " + congoRange + " depending on age and sex. Shipping is a separate line: " + airport + " to your nearest cargo airport or " + home + " to your door." },
  { q: "How much does a pair of African Grey parrots cost?", a: "Our companion pair, Jins and Jeni, is " + ceiling + " for both birds. They are unrelated Congos who keep each other company, which is why we sell them together rather than as two singles. A breeding pair is a different purchase with its own page, and the price there depends on proven history rather than age." },
  { q: "Why are some African Greys advertised for $200 or $500?", a: "Because the listing is not selling a bird. A captive-bred grey costs a breeder months of hand-feeding, laboratory screening and paperwork before it can leave, and none of that fits inside a few hundred dollars. The listings at that price ask for a deposit first and then find a reason the bird cannot ship. Our page on fake listings walks through the pattern; the short version is that a real seller has an address, a searchable licence and a bird you can watch on a video call today." },
  { q: "Is an African Gray the same as an African Grey?", a: "Yes. One is the American spelling, the other the British, and there is only one bird behind both. The two that actually differ are Congo and Timneh, and the comparison table on this page shows how to tell them apart at a glance." },
  { q: "Can I legally own an African Grey parrot in the United States?", a: "Yes, as a pet owner buying a captive-bred bird with its paperwork. The international treaty listing restricts commercial trade in wild-caught greys; it does not stop you owning a bird hatched here. Every bird on this page comes with the captive-bred documentation that shows exactly that." },
  { q: "What documents come with the bird?", a: "Six: the treaty paperwork, the hatch certificate with the band number, the laboratory results, the sex certificate, the veterinary certificate that travels on the crate, and the written 72-hour guarantee. The papers section above lists what each one holds and why it exists." },
  { q: "How does the bird get to my state?", a: "Three ways. Inside a two to three hour drive of us you collect the bird here for nothing. Everywhere else it flies as live-animal cargo to your nearest major airport for " + airport + ", or to your door for " + home + ". A nanny's cabin seat costs " + cabin + " and is priced route by route. We book the flight, and the bird travels with its health certificate." },
  { q: "What does the " + deposit + " deposit do?", a: "It removes one named bird from this page for as long as you need to book travel, and we subtract it from what you pay at collection. It never buys a photograph: we set up a video call first so you are reserving a bird you have watched move, not a listing image." },
  { q: "Should I adopt an African Grey instead of buying one?", a: "If a rescue near you has a grey whose history suits your household, that is a good home for that bird and we will say so. What a rescue cannot usually give you is a known parentage and a bird that has only ever lived in one house. Our adoption page sets the two routes side by side with the costs." },
  { q: "Is a Congo or a Timneh better for a first bird?", a: "Timnehs are smaller and, in our nursery, quicker to trust a new person. Congos are larger, louder and more particular about who they bond with. Neither is wrong for a first home; the honest advice is to pick by the household you have, not the bird you imagined. The fork section on this page is written for exactly that decision." },
  { q: "What if the bird arrives unwell?", a: "Phone us that day, before anything else. The written 72-hour term runs from possession, and hearing from you inside it is what lets us book an avian vet in your area before it closes. Transit-related problems are covered separately for the first 24 hours." },
  { q: "How long will an African Grey live?", a: "40 to 60 years with proper care, which is the reason we screen buyers as carefully as buyers screen us. A grey bought this year is a companion for a working life. The form at the bottom asks about your experience and your plans because the bird is going to outlast most of them." },
];

const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

// One Product per real available bird, inside an ItemList. Sold birds are absent entirely.
const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  name: "African Grey parrots for sale from C.A.Gs",
  itemListElement: available.map((b, i) => ({ "@type": "ListItem", position: i + 1,
    item: { "@type": "Product",
      name: shortName(b) + " — " + subLabel(b) + " African Grey" + (b.sex === "pair" ? " companion pair" : ""),
      category: "Companion parrot",
      image: site + birdImg[b.name].src + ".webp",
      brand: { "@type": "Organization", name: "C.A.Gs" },
      offers: { "@type": "Offer", price: String(b.price), priceCurrency: "USD",
        availability: "https://schema.org/InStock", url: site + b.slug, areaServed: "US",
        seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } } } })) };

// The hub takes AggregateOffer over the whole set — never a per-bird Offer at page level.
const hubSchema = {
  "@context": "https://schema.org", "@type": "Product",
  name: "African Grey Parrots for Sale in the USA — Congo and Timneh, Documented",
  image: [site + IMG + "african-grey-parrots-for-sale-hero.webp", site + IMG + "congo-vs-timneh-side-by-side-chart-hub.webp"],
  description: "Congo and Timneh African Grey parrots hatched at a family aviary in Midland, Texas, with printed prices, laboratory screening, sex certificates and treaty paperwork, collected in person or flown to every state.",
  category: "Companion parrot",
  brand: { "@type": "Organization", name: "C.A.Gs" },
  offers: { "@type": "AggregateOffer", lowPrice: String(lowPrice), highPrice: String(highPrice), priceCurrency: "USD",
    offerCount: String(birdCount), availability: "https://schema.org/InStock", url: canonical, areaServed: "US",
    seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } },
};

const shipNodes = [
  { "@type": "OfferShippingDetails", "@id": canonical + "#ship-airport", name: "Airport cargo pickup",
    shippingRate: { "@type": "MonetaryAmount", value: String((fin as any).purchase_costs.delivery_options.airport_pickup.cost), currency: "USD" },
    shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" } },
  { "@type": "OfferShippingDetails", "@id": canonical + "#ship-home", name: "Home delivery",
    shippingRate: { "@type": "MonetaryAmount", value: String((fin as any).purchase_costs.delivery_options.home_delivery.cost), currency: "USD" },
    shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" } },
];
const shipRefs = shipNodes.map((s) => ({ "@id": s["@id"] }));
(hubSchema.offers as any).shippingDetails = shipRefs;
itemListSchema.itemListElement.forEach((li: any) => { li.item.offers.shippingDetails = shipRefs; });
const schemaGraph = JSON.stringify({ "@context": "https://schema.org", "@graph": [hubSchema, itemListSchema, faqSchema, ...shipNodes] });
const ogExtra = `<meta property="og:image" content="${site}${IMG}african-grey-parrots-for-sale-hero.webp">`;
const tick = `<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const heroSrcset = IMG + "african-grey-parrots-for-sale-hero-400.webp 400w, " + IMG + "african-grey-parrots-for-sale-hero-760.webp 760w, " + IMG + "african-grey-parrots-for-sale-hero.webp 1280w";
const heroSizes = "(max-width: 700px) 100vw, (max-width: 980px) 44vw, 520px";
const p = "hub";
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="product" hideGlobalCta={true} schemaJson={schemaGraph} heroPreload={IMG + "african-grey-parrots-for-sale-hero.webp"} heroPreloadSrcset={heroSrcset} heroPreloadSizes={heroSizes} extraHeadHtml={ogExtra}>

  <main class="hub">
    <div class="hub-container"><Breadcrumb items={breadcrumbs} /></div>

    <!-- ===================== HERO-C · MOSAIC METRICS, REFRESHED TO INVENTORY TILES ===================== -->
    <header class="hero">
      <div class="hero-grid hub-container">
        <div class="hero-copy">
          <p class="eyebrow">C.A.Gs · Midland, Texas · hatched here since 2014</p>
          <ul class="hero-metrics" aria-label="The aviary at a glance">
            <li><b>{birdCount}</b><span>birds with a printed price</span></li>
            <li><b>{floor}</b><span>floor, a Timneh hen</span></li>
            <li><b>{airport}</b><span>flies to any state</span></li>
          </ul>
          <h1>African Grey Parrots for Sale in the USA: Congo and Timneh, <em>Documented</em></h1>
          <p class="lead text-cream">Every grey on this page hatched in our house, was hand-fed at our table and has a laboratory file with its name on it. Pick the bird, read the price beside it, then decide between collecting it here and having it flown to you.</p>
          <div class="hero-cta">
            <a class="btn btn-clay" href="#birds">See the {birdWord} birds</a>
            <a class="btn btn-ghost" href="#price">How we price them</a>
          </div>
        </div>
        <div class="hero-field">
          <figure class="field-photo">
            <img src={IMG + "african-grey-parrots-for-sale-hero.webp"} srcset={heroSrcset} sizes={heroSizes} width="1280" height="720" fetchpriority="high" decoding="async" alt="Congo and Timneh African Greys from our aviary, photographed on their perches">
            <figcaption><b>Raised here, not resold</b><span>Congo and Timneh, one aviary</span></figcaption>
          </figure>
          <nav class="tile-field" id="inventory-tiles" aria-label="Live inventory at a glance">
            <a href="#birds"><b>{groupCount("congo")}</b><span>Congo singles</span></a>
            <a href="#birds"><b>{groupCount("timneh")}</b><span>Timneh singles</span></a>
            <a href="#birds"><b>{groupCount("pair")}</b><span>Companion pair</span></a>
            <a class="tile-more" href="#birds">{birdCount} reservable <span aria-hidden="true">→</span></a>
          </nav>
        </div>
      </div>
    </header>

    <!-- ===================== COUNTER STRIP · 8 ===================== -->
    <section class="counter" aria-label="The numbers on this page">
      <div class="hub-container counter-grid">
        {counters.map((c) => (<div class="cstat"><span class="cn">{c.n}</span><span class="cl">{c.l}</span></div>))}
      </div>
    </section>

    <!-- ===================== RAIL A · PRICE CHIP (mobile) ===================== -->
    <nav class="railA" aria-label="Jump to a section">
      <ul>{sections.map((s) => (
        <li><a href={"#" + s.id} data-dial={s.id}><span class="p">{s.n}</span>{s.label}</a></li>))}
      </ul>
    </nav>

    <div class="hub-container body-grid">
      <!-- ===================== DIAL 2 · DARK AVIARY (desktop) ===================== -->
      <aside class="bdial-wrap" aria-label="Section progress">
        <nav class="bdial" style="--p:10">
          <div class="bdial-ring"><div><b id="dialNum">01</b><span>of {N}</span></div></div>
          <div class="bdial-list">
            {sections.map((s, i) => (
              <a href={"#" + s.id} data-dial={s.id} class={i === 0 ? "on" : ""}>
                <span class="num">{s.n}</span><span class="dh">{s.label}</span>
                {s.tag && <span class="tag">{s.tag}</span>}
              </a>
            ))}
          </div>
        </nav>
      </aside>

      <div class="content">

        <!-- ===================== K1 · RECEIPT CARD ===================== -->
        <aside class="k1" aria-label="What this page asserts">
          <div class="k1-head"><b>What you are looking at</b><span>the hub, in six lines</span></div>
          <dl class="k1-rows">
            <div><dt>The birds</dt><dd>{birdCount} greys reservable today: {congoBirds.length} Congo singles, {timnehBirds.length} Timneh singles and {pairBirds.length} companion pair, each with its <a href="#birds">price printed on the card</a>.</dd></div>
