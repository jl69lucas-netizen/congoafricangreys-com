  .hub .bdial-ring b{font-size:15px;color:#a7e0c2;display:block;line-height:1;}
  .hub .bdial-ring span{font-size:var(--fs-micro);color:#9fc7b0;letter-spacing:.02em;text-transform:uppercase;}
  .hub .bdial-list{display:grid;grid-template-columns:1fr;gap:1px;border-top:1px dashed #38614c;padding-top:8px;}
  .hub .bdial-list a{display:flex;gap:7px;align-items:baseline;color:#cfe3d8;text-decoration:none;font-size:var(--fs-micro);line-height:1.25;padding:5px 7px;border-radius:8px;transition:background-color .15s,color .15s;}
  .hub .bdial-list a:hover{background:#26503f;color:#fff;}
  .hub .bdial-list a.on{background:#2e5c48;color:#fff;font-weight:600;}
  .hub .bdial-list .num{font-family:var(--font-lora,'Newsreader',serif);font-weight:700;color:#9fc7b0;width:16px;flex:none;font-size:var(--fs-micro);font-variant-numeric:tabular-nums;}
  .hub .bdial-list a.on .num{color:#a7e0c2;}
  .hub .bdial-list .dh{min-width:0;}
  .hub .bdial-list .tag{margin-left:auto;font-size:var(--fs-micro);font-weight:600;letter-spacing:.02em;color:#1c3a2e;background:#8fd3ac;border-radius:50px;padding:1px 6px;white-space:nowrap;}

  /* ---- Sections, H2 clay tick, images, tickets, seam ---- */
  .hub .content .sec>h2{position:relative;padding-left:14px;}
  .hub .content .sec>h2::before{content:"";position:absolute;left:0;top:.24em;bottom:.24em;width:3px;border-radius:2px;background:var(--clay);}
  .hub .sec{scroll-margin-top:calc(var(--hdr) + 16px);padding:6px 0 10px;}
  .hub .sec-img{display:block;width:100%;max-width:760px;aspect-ratio:1408/768;object-fit:cover;height:auto;border-radius:14px;border:1px solid var(--bd);margin:1rem 0 1.1rem;box-shadow:0 4px 16px rgba(60,30,10,.06);}
  .hub .ticket{margin:1.2rem 0 .2rem;}
  .hub .ticket-cta{display:inline-flex;align-items:center;justify-content:center;text-align:center;text-wrap:balance;gap:.5rem;background:#fff;border:1.5px solid var(--clay);color:var(--clay-ink);font-weight:700;padding:.55rem 1.05rem;border-radius:50px;text-decoration:none;transition:background .18s;}
  .hub .ticket-cta span{transition:transform .18s;}
  .hub .ticket-cta:hover{background:#fff3ef;}
  .hub .ticket-cta:hover span{transform:translateX(3px);}
  .hub .seam-wrap{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin:30px auto 26px;max-width:560px;}
  .hub .seam-wrap::before,.hub .seam-wrap::after{content:"";height:1px;border-radius:1px;}
  .hub .seam-wrap::before{background:linear-gradient(to right,transparent,rgba(232,96,76,.34));}
  .hub .seam-wrap::after{background:linear-gradient(to left,transparent,rgba(232,96,76,.34));}
  .hub .seam{display:block;height:34px;width:auto;opacity:.92;margin:0;}

  /* ---- K1 receipt ---- */
  .hub .k1{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:0;margin:12px 0 14px;box-shadow:0 3px 14px rgba(60,30,10,.05);overflow:hidden;}
  .hub .k1-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:var(--green-d);color:#fff;padding:.6rem 1rem;}
  .hub .k1-head b{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;}
  .hub .k1-head span{font-size:var(--fs-micro);letter-spacing:.09em;text-transform:uppercase;color:#c9e3d5;}
  .hub .k1-rows{margin:0;padding:.4rem 1rem .7rem;}
  .hub .k1-rows>div{display:grid;grid-template-columns:minmax(0,7.5rem) minmax(0,1fr);gap:.8rem;padding:.5rem 0;border-bottom:1px dashed var(--bd);}
  .hub .k1-rows>div:last-child{border-bottom:0;}
  .hub .k1-rows dt{font-size:var(--fs-micro);font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--green-d);padding-top:.15rem;}
  .hub .k1-rows dd{margin:0;font-size:.9rem;line-height:1.5;color:var(--ink);}

  /* ---- Avail-A: a plain grid, no facet sidebar ---- */
  .hub .availA-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:1rem 0;}
  .hub .bcard{border:1px solid var(--bd);border-radius:14px;overflow:hidden;background:#fff;display:flex;flex-direction:column;}
  .hub .bphoto{position:relative;aspect-ratio:1/1;overflow:hidden;}
  .hub .bphoto img{width:100%;height:100%;object-fit:cover;}
  .hub .bphoto::after{content:"";position:absolute;inset:auto 0 0 0;height:44%;background:linear-gradient(to top,rgba(28,18,12,.42),transparent);pointer-events:none;}
  .hub .bbadge{position:absolute;bottom:8px;left:8px;z-index:2;background:rgba(255,255,255,.94);color:var(--green-d);font-size:var(--fs-micro);font-weight:700;padding:.18rem .5rem;border-radius:50px;text-transform:uppercase;letter-spacing:.03em;box-shadow:0 1px 4px rgba(0,0,0,.18);}
  .hub .bbadge.timneh{color:var(--clay-ink);}
  .hub .bbadge.pair{color:#1f4f6d;}
  .hub .binfo{padding:11px 12px 13px;display:flex;flex-direction:column;gap:.45rem;flex:1;}
  .hub .brow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.4rem;align-items:baseline;min-height:2.65rem;}
  .hub .brow h3{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;line-height:1.16;margin:0;text-transform:uppercase;letter-spacing:.02em;color:var(--green-d);min-width:0;overflow-wrap:anywhere;}
  .hub .bprice{font-weight:700;color:var(--clay-ink);font-size:.98rem;white-space:nowrap;font-variant-numeric:tabular-nums;}
  .hub .bblurb{font-size:.8rem;color:var(--muted);line-height:1.45;margin:0;flex:1;}
  .hub .bchips{display:flex;gap:.3rem;flex-wrap:wrap;min-height:1.4rem;align-content:start;}
  .hub .bchips span{font-size:var(--fs-micro);background:var(--cream);border:1px solid var(--bd);color:var(--green-d);padding:.1rem .4rem;border-radius:50px;font-weight:600;}
  .hub .bship{font-size:var(--fs-micro);color:var(--muted);margin:0;line-height:1.4;}
  .hub .bctas{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-top:auto;flex-wrap:wrap;}
  .hub .bfull{justify-content:center;font-size:.8rem;padding:.5rem .95rem;white-space:nowrap;gap:.3rem;}
  .hub .bmore{font-size:var(--fs-micro);font-weight:600;color:var(--green-d);text-decoration:underline;text-underline-offset:2px;}

  /* ---- HTML infographics (CSS-only; values from the data files) ---- */
  .hub .inf{margin:1.1rem 0 1.2rem;max-width:760px;border:1px solid var(--bd);border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 4px 16px rgba(60,30,10,.06);}
  .hub .inf-cap{font-size:var(--fs-micro);font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#fff;background:var(--green-d);padding:.5rem .9rem;}
  .hub .inf-inv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;}
  .hub .inf-cell{display:flex;flex-direction:column;gap:2px;padding:14px 16px;border-right:1px solid var(--bd);border-bottom:1px solid var(--bd);}
  .hub .inf-cell:nth-child(3n){border-right:0;}
  .hub .inf-cell:nth-last-child(-n+3){border-bottom:0;}
  .hub .inf-cell b{font-family:var(--font-lora,'Newsreader',serif);font-size:1.3rem;color:var(--clay-ink);line-height:1.1;font-variant-numeric:tabular-nums;}
  .hub .inf-cell span{font-size:var(--fs-micro);color:var(--muted);line-height:1.3;}
  .hub .rc{margin:0;padding:.4rem 1rem .6rem;font-variant-numeric:tabular-nums;}
  .hub .rc>div{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;padding:.5rem 0;border-bottom:1px dashed var(--bd);}
  .hub .rc>div:last-child{border-bottom:0;}
  .hub .rc dt{font-size:.9rem;color:var(--ink);margin:0;}
  .hub .rc dd{margin:0;font-weight:700;color:var(--clay-t);white-space:nowrap;}
  .hub .rc .rc-in dd{color:var(--green-d);}
  .hub .rc .rc-total{background:#f4faf6;margin:0 -1rem;padding:.6rem 1rem;}
  .hub .rc .rc-total dt{font-weight:700;color:var(--green-d);}
  .hub .rc .rc-total dd{color:var(--green-d);}

  /* ---- Table A (fork) ---- */
  .hub .otA{border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(60,30,10,.08);border:1px solid var(--bd);margin:6px 0 18px;}
  .hub .otA table{border-collapse:collapse;width:100%;}
  .hub .otA th{background:var(--clay-ink);color:#fff;padding:12px 14px;text-align:left;font-size:.8rem;font-weight:600;}
  .hub .otA td{background:#fff;padding:12px 14px;border-bottom:1px solid #f3e6de;font-size:.86rem;vertical-align:top;}
  .hub .otA tr:nth-child(even) td{background:#fdf4ef;}
  .hub .otA td:first-child b{font-family:var(--font-lora,'Newsreader',serif);font-size:.98rem;}

  /* ---- K2 price tag ---- */
  .hub .k2{display:grid;grid-template-columns:minmax(0,220px) 1fr;gap:0;border:1px solid var(--bd);border-radius:16px;overflow:hidden;margin:4px 0 16px;max-width:600px;box-shadow:0 6px 20px rgba(60,30,10,.08);}
  .hub .k2-tag{background:linear-gradient(135deg,#bd4129,#9c3a23);color:#fff;padding:20px 22px;display:flex;flex-direction:column;justify-content:center;gap:4px;}
  .hub .k2-eyebrow{font-size:var(--fs-micro);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#f6d3c6;}
  .hub .k2-price{font-family:var(--font-lora,'Newsreader',serif);font-size:2.1rem;line-height:1;font-weight:600;}
  .hub .k2-price small{font-size:1rem;}
  .hub .k2-sub{font-size:var(--fs-micro);color:#f6d3c6;}
  .hub .k2-list{list-style:none;margin:0;padding:12px 20px;display:flex;flex-direction:column;justify-content:center;background:#fff;}
  .hub .k2-list li{display:flex;justify-content:space-between;gap:14px;font-size:.86rem;padding:7px 0;border-bottom:1px dotted #e6dad0;}
  .hub .k2-list li:last-child{border-bottom:none;}
  .hub .k2-list b{color:var(--clay-t);white-space:nowrap;}

  /* ---- Timeline strip (a three-step sequence, from the T5 stepper's bones) ---- */
  .hub .tstrip{list-style:none;margin:1rem 0 .4rem;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;counter-reset:none;}
  .hub .tstrip li{position:relative;display:flex;gap:.7rem;align-items:flex-start;background:#fff;border:1px solid var(--bd);border-radius:14px;padding:12px 14px;box-shadow:0 3px 12px rgba(60,30,10,.05);}
  .hub .tstrip li + li::before{content:"";position:absolute;left:-10px;top:50%;width:10px;border-top:2px dashed var(--clay);}
  .hub .ts-n{flex:none;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--clay-ink);color:#fff;font-family:var(--font-lora,'Newsreader',serif);font-weight:700;font-size:.95rem;}
  .hub .ts-txt{display:flex;flex-direction:column;gap:2px;min-width:0;}
  .hub .ts-txt b{font-size:.92rem;color:var(--green-d);line-height:1.25;}
  .hub .ts-txt span{font-size:var(--fs-micro);color:var(--muted);line-height:1.4;}

  /* ---- Lab-report table (papers) ---- */
  .hub .tblwrap{overflow-x:auto;margin:1rem 0;}
  .hub .tblD{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;}
  .hub .tblD-cap{caption-side:top;text-align:left;font-size:var(--fs-micro);font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#fff;background:var(--green-d);padding:.5rem .9rem;}
  .hub .tblD th{background:var(--cream);color:var(--green-d);text-align:left;padding:.6rem .8rem;font-weight:700;font-size:.8rem;border-bottom:2px solid var(--bd);}
  .hub .tblD td{padding:.62rem .8rem;border-bottom:1px solid var(--bd);vertical-align:top;}
  .hub .tblD tr:last-child td{border-bottom:0;}
  .hub .tblD td:first-child{font-weight:700;color:var(--green-d);}
  .hub .tblD td:last-child{color:var(--muted);}
  .hub .tblD .fnum{display:inline-block;min-width:1.6rem;color:var(--clay-t);font-variant-numeric:tabular-nums;}

  /* ---- Split feature (who) ---- */
  .hub .split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:26px;align-items:start;margin:1rem 0 .4rem;}
  .hub .split-image{margin:0;position:sticky;top:calc(var(--hdr) + 16px);}
  .hub .split-image img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:14px;border:1px solid var(--bd);box-shadow:0 4px 16px rgba(60,30,10,.06);}
  .hub .split-image figcaption{font-size:.8rem;color:var(--muted);font-style:italic;margin:.5rem 0 0;}
  .hub .split-text h3{margin-top:.2rem;}
  .hub .split-list{list-style:none;margin:.2rem 0 1rem;padding:0;display:grid;gap:.45rem;}
  .hub .split-list li{display:grid;grid-template-columns:1.2rem 1fr;gap:.55rem;align-items:start;font-size:.92rem;line-height:1.5;}
  .hub .split-list svg{color:var(--green);margin-top:.18rem;}

  /* ---- T3 boarding pass, refreshed to a spoke index ---- */
  .hub .bpass{background:#fff;border:1px solid var(--bd);border-radius:16px;margin:12px 0 4px;box-shadow:0 3px 12px rgba(60,30,10,.05);overflow:hidden;}
  .hub .bpass-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:var(--green-d);color:#fff;padding:.55rem 1rem;}
  .hub .bp-k{font-size:var(--fs-micro);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#c9e3d5;}
  .hub .bp-route{font-family:var(--font-lora,'Newsreader',serif);font-size:1rem;letter-spacing:.06em;}
  .hub .bpass-stops{list-style:none;margin:0;padding:10px 12px 12px;display:grid;grid-template-columns:repeat(6,1fr);gap:8px;}
  .hub .bpass-stops a{display:grid;grid-template-rows:auto auto auto;gap:2px;text-decoration:none;background:var(--cream);border:1px solid var(--bd);border-radius:10px;padding:8px 10px 9px;min-height:64px;transition:border-color .15s,background-color .15s,transform .15s;}
  .hub .bpass-stops a:hover{border-color:var(--clay);background:#fff6f2;transform:translateY(-1px);}
  .hub .bp-n{font-family:var(--font-lora,'Newsreader',serif);font-weight:700;font-size:.95rem;color:var(--clay-t);line-height:1;font-variant-numeric:tabular-nums;}
  .hub .bp-l{font-size:.8rem;font-weight:600;color:var(--green-d);line-height:1.25;}
  .hub .bp-t{font-size:var(--fs-micro);color:var(--muted);}

  /* ---- FAQ-C, dark register, index chip instead of the $ glyph ---- */
  .hub .faqC{margin:8px 0 6px;border-radius:16px;overflow:hidden;box-shadow:0 8px 26px rgba(34,20,10,.14);}
  .hub .faqC-item{background:#221f1d;border-bottom:1px solid rgba(255,255,255,.08);}
  .hub .faqC-item:last-child{border-bottom:none;}
  .hub .faqC-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:16px 20px;color:#fff;}
  .hub .faqC-item summary::-webkit-details-marker{display:none;}
  .hub .faqC-n{font-family:var(--font-lora,'Newsreader',serif);font-weight:700;color:#f08070;font-size:.95rem;min-width:26px;font-variant-numeric:tabular-nums;}
  .hub .faqC-q{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;font-weight:600;flex:1;line-height:1.3;}
  .hub .faqC-x{position:relative;width:16px;height:16px;flex:none;}
  .hub .faqC-x::before,.hub .faqC-x::after{content:"";position:absolute;background:#f08070;border-radius:2px;transition:transform .2s;}
  .hub .faqC-x::before{top:7px;left:0;width:16px;height:2px;}
  .hub .faqC-x::after{left:7px;top:0;width:2px;height:16px;}
  .hub .faqC-item[open] .faqC-x::after{transform:scaleY(0);}
  .hub .faqC-item p{color:rgba(255,255,255,.86);font-size:.9rem;margin:0;padding:0 20px 18px 60px;max-width:70ch;line-height:1.6;}

  /* ---- Reserve form ---- */
  .hub .cta-form{display:grid;grid-template-columns:.85fr 1.15fr;gap:0;border:1px solid var(--bd);border-radius:16px;overflow:hidden;margin:1rem 0;}
  .hub .form-side{background:var(--green-d);color:#eaf3ee;padding:22px;}
  .hub .form-side h3{color:#fff;margin:0 0 .4rem;}
  .hub .form-side p{color:#d7e7de;font-size:.86rem;}
  .hub .form-birds{list-style:none;margin:.8rem 0;padding:0;}
  .hub .form-birds li{display:flex;justify-content:space-between;gap:.6rem;padding:.4rem 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:.85rem;}
  .hub .form-birds b{color:#fff;}
  .hub .form-ship{font-size:var(--fs-micro);color:#c9f2db;}
  .hub .form-ship b{color:#fff;}
  .hub .form-main{padding:22px;background:#fff;display:grid;gap:1rem;}
  .hub .form-main label{display:grid;gap:.25rem;min-width:0;font-size:.82rem;font-weight:600;color:var(--green-d);}
  .hub .form-main input,.hub .form-main select,.hub .form-main textarea{font:inherit;font-size:16px;font-weight:400;padding:.55rem .65rem;border:1px solid var(--bd);border-radius:10px;background:var(--cream);color:var(--ink);width:100%;max-width:100%;box-sizing:border-box;min-width:0;}
  .hub .f2{display:grid;grid-template-columns:1fr 1fr;gap:1rem .7rem;}
  .hub .screen-head{border-top:1px dashed var(--bd);padding-top:.8rem;}
  .hub .screen-title{font-weight:700;color:var(--green-d);font-size:.92rem;margin:0 0 .2rem;}
  .hub .screen-why{font-size:var(--fs-micro);color:var(--muted);margin:0;}
  .hub .btn-submit{border-radius:12px;justify-content:center;margin-top:.3rem;}
  .hub .req{color:#b04228;font-weight:700;}
  .hub .fset{border:0;padding:0;margin:0;min-width:0;display:grid;gap:.35rem;}
  .hub .fset legend{padding:0;font-size:.82rem;font-weight:600;color:var(--green-d);}
  .hub .rad{display:flex;flex-wrap:wrap;gap:.6rem;}
  .hub .rad label{display:flex;align-items:center;gap:.5rem;min-height:44px;padding:.55rem 1.1rem;border:1.5px solid #ede5dc;border-radius:50px;background:#fff9f6;cursor:pointer;}
  .hub .rad label:has(input:checked){border-color:#e8604c;background:rgba(232,96,76,.06);color:#b04228;}
  .hub .dlv{display:grid;gap:.5rem;}
  .hub .dlv label{display:grid;grid-template-columns:auto 1fr;column-gap:.6rem;row-gap:.1rem;align-items:start;padding:.6rem .85rem;border:1.5px solid #ede5dc;border-radius:12px;background:#fff9f6;cursor:pointer;}
  .hub .dlv label:has(input:checked){border-color:#e8604c;background:rgba(232,96,76,.05);}
  .hub .dlv input{grid-row:span 2;margin-top:3px;}
  .hub .dlv .t{font-weight:700;}
  .hub .dlv .d{grid-column:2;font-weight:400;font-size:.8rem;color:var(--muted);line-height:1.45;}
  .hub .rad input,.hub .dlv input{width:auto;padding:0;border:0;border-radius:0;background:none;box-shadow:none;accent-color:#e8604c;}
  .hub .form-note{font-size:var(--fs-micro);color:var(--muted);font-weight:400;margin:0;}
  .hub .hp{position:absolute;left:-9999px;}

  /* ---- Further reading ---- */
  .hub .reading{margin:1.4rem 0 .2rem;}
  .hub .reading-h{font-family:var(--font-lora,'Newsreader',serif);font-size:1.08rem;color:var(--green-d);margin:0 0 .7rem;}
  .hub .read-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .hub .read-card{display:grid;grid-template-columns:120px minmax(0,1fr);gap:12px;border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:var(--ink);transition:border-color .15s,transform .15s;}
  .hub .read-card img{width:120px;height:100%;object-fit:cover;}
  .hub .rc-body{padding:10px 12px 10px 0;display:flex;flex-direction:column;gap:.2rem;}
  .hub .rc-k{font-size:var(--fs-micro);text-transform:uppercase;letter-spacing:.04em;color:var(--clay-t);font-weight:700;}
  .hub .rc-body b{color:var(--green-d);font-size:.92rem;line-height:1.25;}
  .hub .rc-s{font-size:var(--fs-micro);color:var(--muted);line-height:1.4;}
  .hub .read-card:hover{border-color:var(--clay);transform:translateY(-1px);}

  /* ===== Tablet ===== */
  @media(max-width:980px){
    .hub .counter-grid{grid-template-columns:repeat(4,1fr);}
    .hub .bdial-wrap{display:none;}
    .hub .body-grid{grid-template-columns:minmax(0,1fr);}
    .hub .railA{display:block;position:sticky;top:var(--hdr);z-index:40;background:rgba(250,247,244,.985);border-bottom:1px solid var(--bd);box-shadow:0 6px 14px rgba(60,30,10,.07);}
    .hub .railA ul{display:flex;gap:7px;overflow-x:auto;list-style:none;margin:0;padding:.45rem .75rem;scroll-behavior:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
    .hub .railA ul::-webkit-scrollbar{display:none;}
    .hub .railA a{display:inline-flex;align-items:center;gap:.35rem;font-size:var(--fs-micro);font-weight:600;color:var(--clay-t);border:1.5px solid var(--clay);border-radius:50px;padding:7px 14px;text-decoration:none;background:#fff;white-space:nowrap;scroll-margin-inline:20px;min-height:36px;}
