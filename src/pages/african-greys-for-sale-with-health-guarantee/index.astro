.hgar .dial{position:relative;}
.hgar .dial-card{position:sticky;top:calc(var(--hdr) + 16px);display:flex;flex-direction:column;gap:10px;align-items:stretch;background:#fff;border:1px solid var(--bd);border-radius:16px;padding:12px 10px;box-shadow:0 3px 12px rgba(60,30,10,.05);max-height:calc(100vh - var(--hdr) - 32px);overflow-y:auto;scrollbar-width:thin;}
.hgar .ring{--p:6;width:64px;height:64px;border-radius:50%;margin:2px auto 0;flex:none;background:conic-gradient(var(--clay-ink) calc(var(--p) * 1%),#f3ddd5 0);display:grid;place-items:center;}
.hgar .ring-in{width:50px;height:50px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center;}
.hgar .ring-n{font-family:var(--font-lora,'Newsreader',serif);font-size:15px;font-weight:700;color:var(--clay-ink);line-height:1;}
.hgar .ring-of{font-size:7px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;}
.hgar .dial-list{list-style:none;margin:0;padding:8px 0 0;border-top:1px dashed var(--bd);display:grid;grid-template-columns:1fr;gap:1px;}
.hgar .dial-list a{display:flex;gap:7px;align-items:baseline;padding:5px 7px;border-radius:8px;text-decoration:none;color:#4a423b;font-size:.74rem;line-height:1.25;transition:background-color .15s,color .15s;}
.hgar .dial-list a:hover{background:#faf3ee;color:#2a2622;}
.hgar .dial-list a.on{background:#faece7;color:#2a2622;font-weight:600;}
/* light card -> muted #6b625a numerals. NOT the #9fc7b0 dark-card value. */
.hgar .dial-list .di{font-family:var(--font-lora,'Newsreader'),serif;font-weight:700;color:var(--muted);width:16px;flex:none;font-size:.7rem;font-variant-numeric:tabular-nums;}
.hgar .dial-list a.on .di{color:var(--clay-t);}
.hgar .dial-list .dh{min-width:0;}
.hgar .dial-list .dt{margin-left:auto;font-size:.56rem;font-weight:600;letter-spacing:.02em;color:var(--green-d);background:#eef5f1;border-radius:50px;padding:1px 6px;white-space:nowrap;}

/* Rail A (mobile) hidden on desktop */
.hgar .railA{display:none;}

/* Section images */
.hgar .sec-img{display:block;width:100%;max-width:760px;aspect-ratio:1408/768;object-fit:cover;height:auto;border-radius:14px;border:1px solid var(--bd);margin:1rem 0 1.1rem;box-shadow:0 4px 16px rgba(60,30,10,.06);}
.hgar .sec{scroll-margin-top:calc(var(--hdr) + 16px);padding:6px 0 10px;}

/* Ticket CTA */
.hgar .ticket{margin:1.2rem 0 .2rem;}
.hgar .ticket-cta{display:inline-flex;align-items:center;justify-content:center;text-align:center;text-wrap:balance;gap:.5rem;background:#fff;border:1.5px solid var(--clay);color:var(--clay-ink);font-weight:700;padding:.55rem 1.05rem;border-radius:50px;text-decoration:none;transition:background .18s;}
.hgar .ticket-cta span{transition:transform .18s;}
.hgar .ticket-cta:hover{background:#fff3ef;}
.hgar .ticket-cta:hover span{transform:translateX(3px);}

/* K1 Receipt card — this page's primary takeaway */
.hgar .k1{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:0;margin:12px 0 14px;box-shadow:0 3px 14px rgba(60,30,10,.05);overflow:hidden;}
.hgar .k1-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:var(--green-d);color:#fff;padding:.6rem 1rem;}
.hgar .k1-head b{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;}
.hgar .k1-head span{font-size:.66rem;letter-spacing:.09em;text-transform:uppercase;color:#c9e3d5;}
.hgar .k1-rows{margin:0;padding:.4rem 1rem .7rem;}
.hgar .k1-rows>div{display:grid;grid-template-columns:minmax(0,7.5rem) minmax(0,1fr);gap:.8rem;padding:.5rem 0;border-bottom:1px dashed var(--bd);}
.hgar .k1-rows>div:last-child{border-bottom:0;}
/* The label was var(--muted) against a var(--ink) value — different, but backwards:
   quieter than the thing it labels, so the receipt read as one grey slab and the rows
   could not be scanned. Green makes the label lead the eye into its row, and keeps it
   distinct from the clay used for prices and CTAs elsewhere on the page. */
.hgar .k1-rows dt{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--green-d);padding-top:.15rem;}
.hgar .k1-rows dd{margin:0;font-size:.9rem;line-height:1.5;color:var(--ink);}

/* K5 capsule strip — second takeaway */
.hgar .k5{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0 8px;}
.hgar .k5 .cap{display:flex;flex-direction:column;gap:1px;background:#eaf4ef;border:1px solid #cfe6da;border-radius:12px;padding:8px 14px;font-size:.72rem;color:#3d5b4d;font-style:normal;margin:0;}
.hgar .k5 .cap b{font-family:var(--font-lora,'Newsreader',serif);font-size:.95rem;color:var(--green-d);}

/* T4 "Guarantee Index" — magazine index card */
.hgar .t4{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:14px 18px 16px;margin:10px 0 4px;box-shadow:0 3px 12px rgba(60,30,10,.04);}
.hgar .t4-h{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;color:var(--green-d);margin:0 0 .7rem;padding-bottom:.5rem;border-bottom:1px solid var(--bd);}
.hgar .t4-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.hgar .t4-g{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--clay-t);margin:0 0 .4rem;}
/* Guarantee index. Two defects fixed 2026-07-26:
   1. The links were 17px tall (12.8px text, no vertical padding), under the 24px axe
      target-size minimum. That is the "Touch targets do not have sufficient size or
      spacing" report — it listed these links, not the jump rail, whose pills are
      202x37 and always passed. Vertical padding does the work; the row gap shrinks to
      compensate so the block's overall height barely moves.
   2. The 2px border-left accent was a side-stripe, which the house design rules ban.
      Replaced with a hover background tint, which also gives the larger target a
      visible shape. */
.hgar .t4-col ul{list-style:none;margin:0;padding:0;display:grid;gap:.1rem;}
.hgar .t4-col a{font-size:.8rem;line-height:1.35;color:#4a423b;text-decoration:none;display:block;padding:.36rem .5rem;border-radius:8px;transition:background-color .15s,color .15s;}
.hgar .t4-col a:hover,.hgar .t4-col a:focus-visible{background:#efe8e1;color:var(--clay-ink);}

/* Table E "Guarantee Ledger" — this page's own table (green spine, 3-col ledger) */
.hgar .tblwrap{overflow-x:auto;margin:1rem 0;}
.hgar .tblE{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;}
.hgar .tblE-cap{caption-side:top;text-align:left;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#fff;background:var(--green-d);padding:.5rem .9rem;}
.hgar .tblE th{background:var(--cream);color:var(--green-d);text-align:left;padding:.6rem .8rem;font-weight:700;font-size:.8rem;border-bottom:2px solid var(--bd);}
.hgar .tblE td{padding:.62rem .8rem;border-bottom:1px solid var(--bd);vertical-align:top;}
.hgar .tblE tr:last-child td{border-bottom:0;}
.hgar .tblE td:first-child{font-weight:700;color:var(--green-d);}
.hgar .tblE td:nth-child(2){border-left:3px solid var(--green);background:#f6faf8;}
.hgar .tblE td:last-child{color:var(--muted);}

/* Table A — clay-header comparison */
.hgar .tblA{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;}
.hgar .tblA th{background:var(--clay-ink);color:#fff;text-align:left;padding:.65rem .8rem;font-weight:700;font-size:.8rem;}
.hgar .tblA td{padding:.62rem .8rem;border-bottom:1px solid var(--bd);vertical-align:top;}
.hgar .tblA tr:last-child td{border-bottom:0;}
.hgar .tblA td:first-child{font-weight:700;color:var(--green-d);}
.hgar .tblA td:nth-child(3){color:var(--muted);}

/* Avail-B — sticky sidebar faceted by availability posture */
.hgar .availB{display:grid;grid-template-columns:200px minmax(0,1fr);gap:20px;margin:1rem 0;align-items:start;}
.hgar .availB-side{position:sticky;top:calc(var(--hdr) + 16px);background:#fff;border:1px solid var(--bd);border-radius:16px;padding:14px;box-shadow:0 4px 16px rgba(60,30,10,.06);}
.hgar .side-h{font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:0 0 .6rem;}
.hgar .side-filters{display:flex;flex-direction:column;gap:4px;}
.hgar .side-f{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;background:var(--cream);border:1.5px solid var(--bd);border-radius:10px;padding:.5rem .65rem;font:inherit;font-size:.86rem;font-weight:600;color:var(--ink);cursor:pointer;text-align:left;transition:background-color .15s,border-color .15s;}
.hgar .side-f:hover{background:#fff3ef;}
.hgar .side-f.on{border-color:var(--clay-ink);color:var(--green-d);background:#fff3ef;}
.hgar .side-n{font-size:.72rem;font-weight:700;color:var(--muted);background:#fff;border-radius:50px;min-width:24px;text-align:center;padding:2px 8px;}
.hgar .side-f.on .side-n{background:var(--clay-ink);color:#fff;}
.hgar .side-ship{border-top:1px solid var(--bd);margin-top:12px;padding-top:10px;}
.hgar .rail-ship{font-size:.72rem;color:var(--muted);margin:0 0 .35rem;line-height:1.45;}
.hgar .rail-ship b{color:var(--green-d);}
.hgar .availB-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-content:start;}
.hgar .bcard{border:1px solid var(--bd);border-radius:14px;overflow:hidden;background:#fff;display:flex;flex-direction:column;}
.hgar .bcard.hide{display:none;}
.hgar .bphoto{position:relative;aspect-ratio:1/1;overflow:hidden;}
.hgar .bphoto img{width:100%;height:100%;object-fit:cover;}
.hgar .bphoto::after{content:"";position:absolute;inset:auto 0 0 0;height:44%;background:linear-gradient(to top,rgba(28,18,12,.42),transparent);pointer-events:none;}
/* default bottom-left; .badge-top is the per-bird escape hatch for a head-down bird */
.hgar .bbadge{position:absolute;top:auto;bottom:8px;left:8px;z-index:2;background:rgba(255,255,255,.94);color:var(--green-d);font-size:.6rem;font-weight:700;padding:.18rem .5rem;border-radius:50px;text-transform:uppercase;letter-spacing:.03em;box-shadow:0 1px 4px rgba(0,0,0,.18);}
.hgar .bbadge.reserve{color:var(--clay-ink);}
.hgar .bbadge.pair{color:#1f4f6d;}
.hgar .bbadge.badge-top{top:8px;bottom:auto;}
.hgar .binfo{padding:11px 12px 13px;display:flex;flex-direction:column;gap:.45rem;flex:1;}
.hgar .brow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.4rem;align-items:baseline;min-height:2.65rem;}
.hgar .brow h3{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;line-height:1.16;margin:0;text-transform:uppercase;letter-spacing:.02em;color:var(--green-d);min-width:0;overflow-wrap:anywhere;}
.hgar .bprice{font-weight:700;color:var(--clay-ink);font-size:.98rem;white-space:nowrap;}
.hgar .bblurb{font-size:.8rem;color:var(--muted);line-height:1.45;margin:0;flex:1;}
.hgar .bchips{display:flex;gap:.3rem;flex-wrap:wrap;min-height:1.4rem;align-content:start;}
.hgar .bchips span{font-size:.62rem;background:var(--cream);border:1px solid var(--bd);color:var(--green-d);padding:.1rem .4rem;border-radius:50px;font-weight:600;}
.hgar .bship{font-size:.64rem;color:var(--muted);margin:0;line-height:1.4;}
.hgar .bfull{align-self:start;justify-content:center;margin-top:auto;font-size:.8rem;padding:.5rem .95rem;white-space:nowrap;gap:.3rem;}

/* Shipping line + geo cards */
.hgar .ship-line{background:#fdf5f3;border:1px solid #f0d5cd;border-radius:10px;padding:.6rem .85rem;font-size:.9rem;margin:.9rem 0;}
.hgar .ship-line b{color:var(--green-d);}
.hgar .geo-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:1rem 0 .4rem;}
.hgar .geo-card{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:.6rem;background:#fff;border:1px solid var(--bd);border-radius:11px;padding:.6rem .8rem;text-decoration:none;color:var(--ink);transition:border-color .15s,transform .15s;}
.hgar .geo-card svg{grid-row:1/3;align-self:center;color:var(--clay);}
.hgar .geo-card .gl{font-weight:600;font-size:.85rem;color:var(--green-d);}
.hgar .geo-card .gn{font-size:.74rem;color:var(--muted);}
.hgar .geo-card:hover{border-color:var(--clay);transform:translateY(-1px);}

/* Newsletter — for-sale .fs-nl */
.hgar .fs-nl{margin:24px 0;border-radius:20px;overflow:hidden;box-shadow:0 6px 22px rgba(60,30,10,.08);}
.hgar .fs-nl.banner{background:linear-gradient(135deg,#221f1d,#2f2926);color:#fff;}
.hgar .fs-nl-inner{padding:clamp(14px,2.2vw,20px) clamp(16px,2.8vw,26px);max-width:820px;}
.hgar .fs-nl-eyebrow{color:#f08070;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 8px;}
.hgar .fs-nl-h{font-family:var(--font-lora,'Newsreader',serif);font-size:clamp(1.05rem,1.8vw,1.24rem);line-height:1.22;margin:0 0 4px;color:#fff;}
.hgar .fs-nl-sub{font-size:.84rem;line-height:1.5;margin:0 0 10px;max-width:56ch;color:rgba(255,255,255,.86);}
.hgar .fs-nl-form{display:flex;gap:8px;flex-wrap:wrap;}
.hgar .fs-nl-form input{flex:1;min-width:200px;border:1.5px solid rgba(255,255,255,.3);border-radius:50px;padding:12px 18px;font:inherit;font-size:16px;background:#fff;color:#2a2622;}
.hgar .fs-nl-form input:focus{outline:none;border-color:var(--clay);box-shadow:0 0 0 3px rgba(232,96,76,.2);}
.hgar .fs-nl-form button{border:none;cursor:pointer;}
.hgar .fs-nl-note{font-size:.74rem;color:rgba(255,255,255,.72);margin:10px 0 0;}

/* Video — for-sale .fs-video */
.hgar .fs-video{margin:1rem 0;max-width:760px;}
.hgar .fs-video-frame{position:relative;border-radius:18px;overflow:hidden;box-shadow:0 8px 26px rgba(60,30,10,.16);background:#1b1815;}
.hgar .fs-video-frame video{display:block;width:100%;height:auto;aspect-ratio:1408/768;object-fit:cover;}
.hgar .fs-video-tag{position:absolute;top:12px;left:12px;z-index:2;background:rgba(34,31,29,.82);color:#fff;font-size:.68rem;font-weight:600;letter-spacing:.04em;padding:5px 12px;border-radius:50px;pointer-events:none;}
.hgar .fs-video figcaption{font-size:.8rem;color:var(--muted);margin-top:8px;font-style:italic;}

/* Reviews */
.hgar .rev-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:1rem 0;}
.hgar .rev{margin:0;background:#fff;border:1px solid var(--bd);border-radius:14px;padding:16px;}
.hgar .rev .stars{color:var(--clay-ink);letter-spacing:2px;margin-bottom:.4rem;font-size:1.05rem;}
.hgar .rev blockquote{margin:0 0 .8rem;font-size:.9rem;line-height:1.6;color:var(--ink);}
.hgar .rev figcaption{display:flex;align-items:center;gap:.6rem;}
.hgar .rev figcaption img{width:52px;height:52px;border-radius:50%;object-fit:cover;flex:none;}
.hgar .rev figcaption b{display:block;font-size:.9rem;color:var(--green-d);}
.hgar .rev figcaption span span{font-size:.76rem;color:var(--muted);}

/* Read cards */
.hgar .read-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:1rem 0;}
.hgar .read-card{display:grid;grid-template-columns:120px minmax(0,1fr);gap:12px;border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:var(--ink);transition:border-color .15s,transform .15s;}
.hgar .read-card img{width:120px;height:100%;object-fit:cover;}
.hgar .rc-body{padding:10px 12px 10px 0;display:flex;flex-direction:column;gap:.2rem;}
.hgar .rc-k{font-size:.66rem;text-transform:uppercase;letter-spacing:.04em;color:var(--clay-t);font-weight:700;}
.hgar .rc-body b{color:var(--green-d);font-size:.92rem;line-height:1.25;}
.hgar .rc-s{font-size:.78rem;color:var(--muted);line-height:1.4;}
.hgar .read-card:hover{border-color:var(--clay);transform:translateY(-1px);}

/* FAQ-A refreshed — GREEN TICK marker (the DNA page uses a numbered clay chip) */
.hgar .faqA{margin:1rem 0 6px;display:flex;flex-direction:column;gap:8px;}
.hgar .faqA-item{background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;box-shadow:0 2px 10px rgba(60,30,10,.04);}
.hgar .faqA-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:14px 18px;color:#2a2622;}
.hgar .faqA-item summary::-webkit-details-marker{display:none;}
.hgar .faqA-t{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50px;background:#eaf4ef;border:1.5px solid var(--green);color:var(--green-d);flex:none;font-size:.8rem;}
.hgar .faqA-item[open] .faqA-t{background:var(--green);color:#fff;}
.hgar .faqA-q{font-family:var(--font-lora,'Newsreader',serif);font-size:1rem;font-weight:600;flex:1;line-height:1.32;}
.hgar .faqA-v{width:11px;height:11px;flex:none;border-right:2px solid var(--green-d);border-bottom:2px solid var(--green-d);transform:rotate(45deg) translate(-2px,-2px);transition:transform .2s;}
.hgar .faqA-item[open] .faqA-v{transform:rotate(225deg) translate(-2px,-2px);}
.hgar .faqA-item[open] summary{border-bottom:1px solid var(--bd);background:#f6faf8;}
.hgar .faqA-item p{color:#4a423b;font-size:.9rem;margin:0;padding:14px 18px 16px;max-width:none;line-height:1.62;}

/* Contact form */
.hgar .cta-form{display:grid;grid-template-columns:.85fr 1.15fr;gap:0;border:1px solid var(--bd);border-radius:16px;overflow:hidden;margin:1rem 0;}
.hgar .form-side{background:var(--green-d);color:#eaf3ee;padding:22px;}
.hgar .form-side h3{color:#fff;margin:0 0 .4rem;}
.hgar .form-side p{color:#d7e7de;font-size:.86rem;}
.hgar .form-birds{list-style:none;margin:.8rem 0;padding:0;}
.hgar .form-birds li{display:flex;justify-content:space-between;gap:.6rem;padding:.4rem 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:.85rem;}
.hgar .form-birds b{color:#fff;}
.hgar .form-ship{font-size:.78rem;color:#c9f2db;}
.hgar .form-ship b{color:#fff;}
.hgar .form-main{padding:22px;background:#fff;display:grid;gap:.7rem;}
.hgar .form-main label{display:grid;gap:.25rem;min-width:0;font-size:.82rem;font-weight:600;color:var(--green-d);}
.hgar .form-main input,.hgar .form-main select,.hgar .form-main textarea{font:inherit;font-size:16px;font-weight:400;padding:.55rem .65rem;border:1px solid var(--bd);border-radius:10px;background:var(--cream);color:var(--ink);width:100%;max-width:100%;box-sizing:border-box;min-width:0;}
.hgar .f2{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;}
.hgar .btn-submit{border-radius:12px;justify-content:center;margin-top:.3rem;}
.hgar .form-note{font-size:.74rem;color:var(--muted);font-weight:400;margin:0;}
.hgar .hp{position:absolute;left:-9999px;}

/* ===================== RESPONSIVE ===================== */
@media (max-width:980px){
  .hgar .hero-grid{grid-template-columns:minmax(0,1fr);gap:18px;}
  /* photo leads on mobile, copy follows — matching the sibling for-sale heroes */
  .hgar .hero-shot{order:-1;}
  /* Trust ribbon on mobile. The 2x2 grid centred each label, so a two-line label
     wrapped ragged and its tick floated vertically centred beside the block —
     no two ticks lined up and the strip read as scattered. One column instead:
     every label fits on a single line at 375px, the ticks form one clean vertical
     rule, and any label that does wrap hangs under itself rather than under the
     tick. Costs no height — the old rows were 67px each because they wrapped. */
  .hgar .ribbon{grid-template-columns:minmax(0,1fr);}
  .hgar .ribbon li{
    display:grid;
    grid-template-columns:1rem 1fr;
    align-items:start;
    justify-items:start;
    text-align:left;
    gap:.55rem;
    padding:10px 16px;
    line-height:1.4;
    border-right:0;
    border-bottom:1px solid var(--bd);
  }
  .hgar .ribbon li:last-child{border-bottom:0;}
  .hgar .ribbon svg{margin-top:.16rem;}
  .hgar .counter-grid{grid-template-columns:repeat(3,1fr);}
  /* minmax(0,1fr) + min-width:0 stop the 100vw full-bleed images inflating the track */
  .hgar .body-grid{grid-template-columns:minmax(0,1fr);}
  .hgar .content{min-width:0;}
  .hgar .dial{display:none;}
  .hgar .t4-grid{grid-template-columns:repeat(2,1fr);}
  .hgar .availB{grid-template-columns:minmax(0,1fr);}
  .hgar .availB-side{position:static;}
  .hgar .side-filters{flex-direction:row;flex-wrap:wrap;}
  .hgar .side-f{width:auto;}
  .hgar .availB-grid{grid-template-columns:repeat(2,1fr);}
  .hgar .rev-grid,.hgar .read-cards,.hgar .geo-cards{grid-template-columns:minmax(0,1fr);}
  .hgar .cta-form{grid-template-columns:minmax(0,1fr);}
  /* Rail A — sticky UNDER the site header (96px), clay outlined pills */
  .hgar .railA{display:block;position:sticky;top:var(--hdr);z-index:40;background:rgba(250,247,244,.985);border-bottom:1px solid var(--bd);box-shadow:0 6px 14px rgba(60,30,10,.07);}
  .hgar .railA ul{display:flex;gap:7px;overflow-x:auto;list-style:none;margin:0;padding:.45rem .75rem;scroll-behavior:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .hgar .railA ul::-webkit-scrollbar{display:none;}
  .hgar .railA a{display:inline-flex;align-items:center;gap:.35rem;font-size:.76rem;font-weight:600;color:var(--clay-t);border:1.5px solid var(--clay);border-radius:50px;padding:7px 14px;text-decoration:none;background:#fff;white-space:nowrap;scroll-margin-inline:20px;min-height:36px;}
  .hgar .railA a.on{background:var(--clay-ink);border-color:var(--clay-ink);color:#fff;}
  .hgar .railA .p{font-weight:700;font-variant-numeric:tabular-nums;}
  /* anchors must clear BOTH the header (96px) and the sticky rail (~54px) + gap */
  .hgar .sec{scroll-margin-top:calc(var(--hdr) + 66px);}
}
@media (max-width:640px){
  .hgar .hg-container{padding:0 16px;}
  .hgar .counter-grid{grid-template-columns:repeat(2,1fr);}
  .hgar .t4-grid{grid-template-columns:minmax(0,1fr);gap:12px;}
  .hgar .k1-rows>div{grid-template-columns:minmax(0,1fr);gap:.15rem;}
  .hgar .availB-grid{grid-template-columns:1fr 1fr;gap:10px;}
  .hgar .bblurb{display:none;}
  .hgar .binfo{padding:9px 9px 11px;gap:.4rem;}
  .hgar .brow{min-height:2.5rem;}
  .hgar .brow h3{font-size:.92rem;}
  .hgar .bprice{font-size:.92rem;}
  .hgar .bfull{align-self:stretch;font-size:.74rem;padding:.5rem .55rem;}
  .hgar .bchips span{font-size:.58rem;}
  .hgar .bship{font-size:.58rem;}
  .hgar .bbadge{font-size:.55rem;padding:.15rem .42rem;}
  .hgar .seam-wrap{gap:12px;margin:24px auto 22px;}
  .hgar .seam{height:30px;}
  .hgar .f2{grid-template-columns:1fr;}
  .hgar .ticket-cta{font-size:.86rem;padding:.5rem .9rem;line-height:1.35;}

  /* ===== Mobile table stacking — both tables become cards, keeping the desktop look ===== */
  .hgar .tblwrap{overflow-x:visible;}
  .hgar .tblE,.hgar .tblA{border:0;border-radius:0;overflow:visible;background:transparent;}
  .hgar .tblE-cap{border-radius:10px;margin-bottom:10px;}
  .hgar .tblE thead,.hgar .tblA thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  .hgar .tblE tbody,.hgar .tblE tr,.hgar .tblE td,
  .hgar .tblA tbody,.hgar .tblA tr,.hgar .tblA td{display:block;}
  .hgar .tblE tr,.hgar .tblA tr{border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:#fff;margin-bottom:10px;}
  .hgar .tblE tr:last-child,.hgar .tblA tr:last-child{margin-bottom:0;}
  .hgar .tblE td,.hgar .tblA td{padding:.55rem .8rem;border-bottom:1px solid var(--bd);}
  .hgar .tblE tr td:last-child,.hgar .tblA tr td:last-child{border-bottom:0;}
  .hgar .tblE td:nth-child(2){border-left:0;}
  /* first cell becomes the card's header band, mirroring the desktop header row */
  .hgar .tblE td:first-child,.hgar .tblA td:first-child{background:var(--cream);color:var(--green-d);font-weight:700;font-size:.92rem;padding:.6rem .8rem;border-bottom:2px solid var(--bd);white-space:normal;}
  .hgar .tblE td[data-label]:not(:first-child),.hgar .tblA td[data-label]:not(:first-child){display:grid;grid-template-columns:minmax(0,6.6rem) minmax(0,1fr);gap:.55rem;align-items:baseline;}
  .hgar .tblE td[data-label]:not(:first-child)::before,.hgar .tblA td[data-label]:not(:first-child)::before{content:attr(data-label);font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);line-height:1.6;}

  /* Mobile full-bleed section images.
     INFOGRAPHICS keep native 16:9 and are NEVER cover-cropped — the 5:4 cover frame
     shaved ~30% off the hand-raised set and cut its baked-in text.
     Only real OG PHOTOS take the taller 4:5 frame (IMAGE-DESIGNS §7 blurfill). */
  .hgar .sec-img{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);border-radius:0;border-left:0;border-right:0;}
  .hgar .sec-img.inf-img{aspect-ratio:1408/768;object-fit:contain;background:#fff;}
  .hgar .sec-img.og-photo{aspect-ratio:4/5;object-fit:cover;background:transparent;}
}

/* Compact newsletter band (2026-07-26). The input min-width:200px forced a wrap on
   mobile, leaving a button narrower than the field above it — a ragged left-edge
   stack. Below 560px both go full width so the block reads as one column. */
@media(max-width:560px){
  .hgar .fs-nl-form{flex-direction:column;}
  .hgar .fs-nl-form input,.hgar .fs-nl-form button{width:100%;min-width:0;}
}
</style>
</BaseLayout>
