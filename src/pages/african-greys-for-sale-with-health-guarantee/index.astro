---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import clutch from '../../../data/clutch-inventory.json';

// ============================================================================
//  /african-greys-for-sale-with-health-guarantee/ — for-sale cluster page 5
//  Tuple (distinct from egg/congo/timneh/hand-raised/dna — sessions/2026-07-19-for-sale-component-map.md):
//    Split-Hero A trust ribbon · Dial 1 clay + Rail A (guarantee palette)
//    · T4 "Guarantee Index" · K1 Receipt + K5 Capsule · NEW Table E "Guarantee
//    Ledger" + Table A · FAQ-A refreshed (green tick, not the DNA clay chevron)
//    · Avail-B faceted by AVAILABILITY POSTURE (siblings facet by sex/variant)
//  Angle: "A Guarantee You Can Actually Use" — reframe -> cover -> document -> birds
//  Blend: EEBP (spine) x PAS (trust/scam) x EEAT (guarantee blocks) x QAB (FAQ) x FAB (spec rows)
//  Voice lever: enforceable vs unenforceable. This page says WINDOW / REMEDY /
//    VOID / IN WRITING where siblings say hen-cock, hand-fed, maroon, incubation.
//  H6 prefixes reserved to this page: "In Writing:" · "From the Vet:" · "On File:"
//  Prose written fresh from sessions/2026-07-25-health-guarantee-sprint1-blueprint.md §4
//  (Write-From-Outline — nothing paraphrased from a sibling; the reviews are whitelist).
// ============================================================================

const title = "African Greys for Sale With a Health Guarantee You Can Actually Use | What Does an African Grey Health Guarantee Actually Cover? | 6 Documented Greys Reservable Today | C.A.Gs, Midland TX — 72-Hour Written Guarantee, Avian-Vet Exam, PBFD and Psittacosis PCR, CITES Papers";
const description = "African Greys for sale with a written 72-hour health guarantee whose terms we publish in full — covered conditions, remedy, and what voids it. Replacement or refund, anchored to your own avian vet's exam. USDA-licensed Midland, TX family aviary, $1,500 floor. Ask us about a grey today.";
const canonical = "https://congoafricangreys.com/african-greys-for-sale-with-health-guarantee/";

const IMG = "/images/health-guarantee-page/";
const CG = "/images/congo-page/";
const TG = "/images/timneh-page/";
const site = "https://congoafricangreys.com";
const seam = "/cag-fs-seam-emblem.webp";
const deposit = "$200";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
  { name: "African Greys for Sale With a Health Guarantee", url: "/african-greys-for-sale-with-health-guarantee/" },
];

// Real inventory. Avail-B facets by AVAILABILITY POSTURE on this page — the filter
// itself carries the argument that the same written guarantee travels with every
// grey regardless of how soon it can leave.
const available = ((clutch as any).birds as any[]).filter((b) => b.status === "available");
const postureKey = (b: any) => (b.sex === "pair" ? "pair" : b.age_at_listing === "1 year" ? "ready" : "reserve");
const postureLabel = (b: any) =>
  b.sex === "pair" ? "Pair · ships together" : b.age_at_listing === "1 year" ? "Ready now" : "Reserve & wean";
const subLabel = (b: any) => (b.variant === "timneh_african_grey" ? "Timneh" : "Congo");
const postureCount = (k: string) => available.filter((b) => postureKey(b) === k).length;

// `badge:"top"` lifts the posture pill off a head-down bird's face (the Roys lesson).
const birdImg: Record<string, { src: string; alt: string; pos: string; badge?: "top" }> = {
  "Bery": { src: CG + "bery-congo-african-grey-female-card.webp", pos: "center 30%",
    alt: "Bery, an adult Congo hen whose written health guarantee travels home with her" },
  "Amie": { src: CG + "amie-congo-african-grey-female-card.webp", pos: "center 28%",
    alt: "Amie, a young Congo grey cleared at her pre-sale avian-vet examination" },
  "Roys": { src: CG + "roys-congo-african-grey-male-card.webp", pos: "center 30%", badge: "top",
    alt: "Roys, a Congo cock PCR-screened for beak and feather disease before we listed him" },
  "Jins & Jeni (Pair)": { src: CG + "jins-jeni-congo-african-grey-pair-card.webp", pos: "center 32%",
    alt: "Jins and Jeni, a companion pair of grey parrots each covered by their own written terms" },
  "Elad": { src: TG + "elad-timneh-african-grey-male-card.webp", pos: "center 34%",
    alt: "Elad, a maroon-tailed Timneh with his veterinary certificate already on file" },
  "Evie": { src: TG + "evie-timneh-african-grey-female-card.webp", pos: "center 38%",
    alt: "Evie, a Timneh grey whose paperwork folder rides in the crate beside her" },
};
const birdBlurb: Record<string, string> = {
  "Bery": "Settled Congo hen, already past every milestone the window is designed to catch.",
  "Amie": "Congo hen still weaning; her window opens the day she reaches you, not today.",
  "Roys": "Congo cock, screened and cleared, waiting out the last few weeks of weaning.",
  "Jins & Jeni (Pair)": "Two greys, two sets of terms, one crate — they do not separate.",
  "Elad": "Timneh cock out of Levi and Rily, examined and papered before he was listed.",
  "Evie": "Timneh hen, unhurried and deliberate, cleared at her pre-sale examination.",
};

// Counter strip — 6 (this page's approved count), every figure Ledger-bound.
const counters = [
  { n: "72 Hours", l: "Written health window" },
  { n: "24 Hours", l: "Shipping-arrival window" },
  { n: "3 Screens", l: "PBFD, polyoma, psittacosis" },
  { n: "$1,500", l: "Honest floor price" },
  { n: "12+ Yrs", l: "Aviary in Midland, TX" },
  { n: "24h", l: "We answer, personally" },
];

// Dial 1 spine. IDs map to the approved H1–H6 outline (blueprint §4).
const sections = [
  { n: "01", id: "covers", label: "What the guarantee covers", tag: "Terms" },
  { n: "02", id: "window", label: "72 hours vs a full year", tag: "Reframe" },
  { n: "03", id: "claim", label: "If your grey falls ill", tag: "3 steps" },
  { n: "04", id: "available", label: "Greys you can reserve", tag: available.length + " birds" },
  { n: "05", id: "documents", label: "The paperwork behind it", tag: "5 docs" },
  { n: "06", id: "screening", label: "One exam, three screens", tag: "PCR" },
  { n: "07", id: "scam", label: "Legit breeder or scam", tag: "Red flags" },
  { n: "08", id: "ask", label: "What to ask before paying", tag: "5 Q" },
  { n: "09", id: "floor", label: "Why the floor is $1,500", tag: "$1,500" },
  { n: "10", id: "legal", label: "Owning one legally", tag: "CITES" },
  { n: "11", id: "shipping", label: "Getting your grey home", tag: "$185/$350" },
  { n: "12", id: "compare", label: "Us vs page-one sellers", tag: "Receipts" },
  { n: "13", id: "reviews", label: "What buyers told us", tag: "5★" },
  { n: "14", id: "video", label: "Our greys on camera", tag: "Video" },
  { n: "15", id: "reading", label: "Read next", tag: "" },
  { n: "16", id: "faq", label: "Questions buyers ask", tag: "10 Q" },
  { n: "17", id: "reserve", label: "Ask about a grey", tag: "24h" },
];
const N = sections.length;

// T4 "Guarantee Index" — magazine index card, regrouped along the angle's arc.
const indexGroups = [
  { g: "The terms", items: [ { h: "#covers", t: "What is covered, and what voids it" }, { h: "#window", t: "Is seventy-two hours long enough?" }, { h: "#claim", t: "How a claim actually runs" } ] },
  { g: "The proof", items: [ { h: "#documents", t: "Five documents in the folder" }, { h: "#screening", t: "One exam, three PCR screens" }, { h: "#compare", t: "Us against page-one sellers" } ] },
  { g: "The caution", items: [ { h: "#scam", t: "Telling a breeder from a scam" }, { h: "#ask", t: "Five questions to ask first" }, { h: "#floor", t: "Why $1,500 is the honest floor" } ] },
  { g: "The birds", items: [ { h: "#available", t: "Greys you can reserve today" }, { h: "#shipping", t: "Airport, home, or Midland" }, { h: "#reserve", t: "Ask us about one" } ] },
];

// NEW Table E "Guarantee Ledger" — this page's signature table. Every "them" cell
// is a Sprint 0 §2c/§3 receipt, never an invention.
const ledgerRows = [
  { k: "Stated window", ours: "72 hours from arrival, plus a 24-hour shipping window", them: "Anything from 72 hours to 365 days, with the longest offered by the least verifiable sellers" },
  { k: "Covered conditions named", ours: "Congenital defects and infectious disease, listed in writing", them: "Usually unstated — “health guarantee” appears as a two-word badge" },
  { k: "Remedy", ours: "Replacement or refund, at our discretion", them: "Store credit toward a future purchase, or nothing stated at all" },
  { k: "What voids it", ours: "Band removal, improper diet or care, exposure to other birds, no vet exam inside the window", them: "Rarely published, so a buyer meets the exclusions only when claiming" },
  { k: "Who confirms the illness", ours: "Your own avian vet, independent of us", them: "The seller, or left unspecified" },
  { k: "Anchored to documentation", ours: "Vet certificate, DNA certificate, CITES papers, closed band", them: "One badge among many, with no document shown anywhere" },
];

// Table A — page-one seller receipts (Sprint 0 §3). Fetched claims only.
const compareRows = [
  { k: "Publishes the covered conditions", us: "Yes — congenital defects and infectious disease, named", them: "No page-one seller we checked lists covered conditions" },
  { k: "States the remedy plainly", us: "Replacement or refund", them: "One registry breeder offers credit toward a future purchase only" },
  { k: "Publishes what voids the guarantee", us: "Four exclusions, stated on this page", them: "Silent, or buried where the listing never links" },
  { k: "Species-correct guarantee copy", us: "Written for African Greys, by the people who raised them", them: "Boilerplate naming the wrong farm and the wrong species" },
  { k: "Lowest advertised price", us: "A $1,500 floor, guarantee included", them: "$750–$850 Congos advertised beneath a one-year guarantee badge" },
  { k: "Guarantee attached to a named bird", us: "Every grey below, by name and by band", them: "Marketplace stock cards, or photographs shared by several sellers" },
];

// DISTINCT geo set vs egg/congo/timneh/hand-raised/dna. All slugs verified live.
// CO anchors to Jeffrey's city; SC has no page, so it lives in prose, never as a link.
const shipPlaces = [
  { href: "/african-grey-parrot-for-sale-texas/", label: "Health-guaranteed African Greys Texas", note: "Midland pickup or DFW cargo" },
  { href: "/african-grey-parrot-for-sale-ohio/", label: "Guaranteed grey parrots Ohio", note: "Columbus and Cleveland desks" },
  { href: "/african-grey-parrot-for-sale-colorado/", label: "Vet-checked African Greys Colorado", note: "Denver International, the Centennial run" },
  { href: "/african-grey-parrot-for-sale-north-carolina/", label: "Written guarantee greys North Carolina", note: "Charlotte cargo counter" },
  { href: "/african-grey-parrot-for-sale-georgia/", label: "Documented African Grey parrots Georgia", note: "Atlanta live-animal hub" },
  { href: "/african-grey-parrot-for-sale-michigan/", label: "Buy a guaranteed African Grey Michigan", note: "Detroit Metro route" },
  { href: "/african-grey-parrot-for-sale-pennsylvania/", label: "African Greys with health papers Pennsylvania", note: "Philadelphia desk" },
  { href: "/african-grey-parrot-for-sale-virginia/", label: "Guaranteed healthy greys Virginia", note: "Dulles cargo" },
];

// Real, breeder-supplied reviews — the ONE whitelisted verbatim crossover on this
// page. New to this build (siblings use Stanley Perkin / Jesse Ovalle). Verbatim,
// unedited, as supplied 2026-07-25.
const stories = [
  { name: "Meredith Plaisance", loc: "Hartsville, SC 29550", meta: "Verified C.A.Gs buyer",
    avatar: IMG + "meredith-plaisance-hartsville-sc-health-guarantee-review.webp",
    quote: "I searched everywhere for a healthy African Grey bird for sale near me, and C.A.G.s was by far the best choice. From the first conversation, they were knowledgeable, responsive, and genuinely cared about matching me with the right bird. My African Grey arrived in excellent health, fully weaned, and incredibly friendly. The entire experience was smooth from start to finish, and I would absolutely recommend C.A.G.s to anyone looking for a quality African Grey." },
  { name: "Jeffrey Hendershot", loc: "Centennial, CO 80112", meta: "Verified C.A.Gs buyer",
    avatar: IMG + "jeffrey-hendershot-centennial-co-guaranteed-grey-review.webp",
    quote: "Finding a trustworthy place for rehoming African Grey parrot options wasn't easy until I discovered C.A.G.s. They answered every question, provided regular updates, and made me feel confident throughout the entire adoption process. My Grey is healthy, intelligent, and has settled into our home beautifully. The professionalism and genuine care shown by C.A.G.s exceeded every expectation." },
];

const readMore = [
  { href: "/african-grey-parrot-health-guarantee/", img: IMG + "what-african-grey-health-guarantee-covers", kicker: "The policy", title: "Our African Grey health guarantee in full", sub: "The complete written policy this page summarises, including fine print we did not have room for here." },
  { href: "/how-to-avoid-african-grey-parrot-scams/", img: IMG + "72-hour-vs-one-year-parrot-health-guarantee", kicker: "Scam guide", title: "How to avoid African Grey parrot scams", sub: "Where a guarantee badge sits among the other signals a fraudulent listing gives off." },
  { href: "/trusted-african-grey-parrot-breeders/", img: IMG + "documentation-with-guaranteed-african-grey", kicker: "Who we are", title: "Trusted African Grey parrot breeders", sub: "Mark and Teri, the licence, the aviary, and why any of that should matter to you." },
  { href: "/dna-tested-african-grey-for-sale/", img: IMG + "one-vet-exam-three-disease-screens-parrot", kicker: "Testing", title: "DNA-tested African Greys for sale", sub: "The sexing assay that runs off the same sample as the disease panel, priced openly." },
];

// QAB — 10 PAA targets from the Sprint 0.5 fan-out (Tier 3 + Tier 7).
const faqs = [
  { q: "What does your African Grey health guarantee actually cover?", a: "It covers two things, and we name them rather than leaving you to guess. The first is a congenital defect — something your grey was hatched with that no examination could have surfaced beforehand. The second is infectious disease already incubating when he left us and not yet showing itself. Separately, anything that goes wrong in transit is covered for 24 hours from arrival. What it does not stretch to is an illness acquired after delivery, because at that point we would be guaranteeing a household we have never seen." },
  { q: "Is a 72-hour health guarantee long enough to trust?", a: "It is long enough to do the one job a guarantee can honestly do, which is get an independent avian vet to look at your bird while the question of who was responsible is still answerable. Seventy-two hours is not a limit on our interest in your grey; we answer messages years later. It is the boundary of what we can fairly stand behind, because after three days in a new home the diet, the air and the stress are yours rather than ours. A twelve-month promise sounds generous precisely because nobody expects to honour it." },
  { q: "What happens if my African Grey gets sick right after it arrives?", a: "Ring an avian vet first and us second, in that order, because the examination is what makes everything afterwards possible. Book inside the 72-hour window, mention that your bird has just travelled, and ask for the findings in writing. Send us that diagnosis and we settle it as replacement or refund, at our discretion. There is no claims department here; it is Mark or Teri reading your email. What we cannot act on is a description of symptoms alone, however worrying, because the vet's record is the only thing either of us can rely on." },
  { q: "What voids the health guarantee?", a: "Four things, all published rather than buried. Removing the closed leg band voids it, because that band is the only physical link between the paperwork and the parrot. Improper diet or husbandry voids it, and a seed-only bowl is the usual culprit. Exposing your grey to other birds during the first thirty days voids it, since a new bird can carry something yours did not arrive with. Skipping the avian-vet exam inside the window voids it too, at which point the bird is sold as-is. None of these are traps; each marks the point where we can no longer tell what happened." },
  { q: "Do I need to take my new African Grey to an avian vet right away?", a: "Yes, and we would push you to do it even if no guarantee existed. An avian vet is not the same as a general small-animal practice; birds hide illness so well that a trained eye catches things days or weeks before an owner would. Book the appointment before your grey arrives rather than after, because good avian practices run a waiting list and the window does not pause while you find one. Bring the paperwork folder — the vet will want the band number and the screening results, and it starts your grey's own medical record properly." },
  { q: "How do I know an African Grey breeder is legitimate and not a scam?", a: "Ask for something only a real breeder can produce, then watch what happens. A live video call with the specific bird, taken now, on request, is the hardest thing for a fraudulent listing to fake. Beyond that: a real breeder has a physical address you can look up, a licence you can verify, a price that sits in the actual market, and no objection to your questions. Payment method is the loudest tell — anyone steering you toward a wire, a gift card or a peer-to-peer app is choosing the one route with no recourse, and that choice is the whole scam." },
  { q: "Why won't a real breeder sell a healthy African Grey for $800?", a: "Because the costs underneath a grey do not move. A hand-raised chick eats formula every few hours for months, and somebody is awake to feed it. The pre-sale avian-vet exam, the PCR disease panel, the DNA sexing and the CITES paperwork each carry a real invoice. At $800 the arithmetic fails before the bird is even weaned, which means something in the description is untrue — the bird, the testing, or the seller. That is why the price is the first thing to check and the last thing to negotiate on." },
  { q: "What documents come with a health-guaranteed African Grey?", a: "Five, and they arrive together in one folder rather than trickling in afterwards. The written health guarantee itself, with the window and the remedy on it. The avian-vet health certificate from the pre-sale examination, dated within ten days of travel. The DNA sexing certificate naming the hen or cock. Your CITES Appendix I captive-bred documentation. And the closed leg band already on your grey's leg, whose number appears on the paperwork so you can match them yourself. Check the band against the certificate on day one; it takes a minute and it is the whole point." },
  { q: "Are your African Greys DNA-sexed and disease-tested before sale?", a: "Both, before a bird is ever listed rather than after somebody asks. Sexing runs by PCR on a feather or blood sample and comes back as a certificate tied to the band number. The disease screening runs off that same sample type and covers psittacine beak and feather disease, avian polyomavirus and psittacosis. We would rather find something at that stage and deal with it here than have you discover it in your living room, which is the practical reason the guarantee is affordable for us to offer at all." },
  { q: "Can you ship an African Grey with the health guarantee intact?", a: "Yes, and shipping is exactly where the extra 24-hour window earns its place. Your grey travels as IATA-compliant live-animal cargo on Delta, United or American in a ventilated crate, on a direct flight wherever the route allows. From the moment you collect him, anything transit-related is covered for a day, and the 72-hour health window runs alongside it. If Midland is within two or three hours of you, collecting in person is free and skips the question entirely — several buyers make the drive for that reason alone." },
];

const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

const productSchema = {
  "@context": "https://schema.org", "@type": "Product",
  name: "African Grey Parrot for Sale With a Written 72-Hour Health Guarantee",
  image: [ site + IMG + "healthy-african-grey-for-sale.webp", site + IMG + "what-african-grey-health-guarantee-covers.webp" ],
  description: "A captive-bred African Grey parrot from C.A.Gs, a USDA-licensed family aviary in Midland, Texas, sold with a written 72-hour health guarantee covering congenital defects and infectious disease, plus a 24-hour shipping-arrival window. Remedy is replacement or refund. Every grey is examined by a board-certified avian vet and PCR-screened for PBFD, avian polyomavirus and psittacosis, DNA-sexed, and documented under CITES Appendix I.",
  category: "Companion parrot",
  brand: { "@type": "Organization", name: "C.A.Gs – Midland, TX" },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.9", reviewCount: "52" },
  review: stories.map((s) => ({ "@type": "Review", author: { "@type": "Person", name: s.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" }, reviewBody: s.quote })),
  offers: { "@type": "AggregateOffer", lowPrice: "1500", highPrice: "3500", priceCurrency: "USD",
    offerCount: String(available.length), availability: "https://schema.org/InStock", url: canonical,
    seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs – Midland, TX", alternateName: "Congo African Greys" } },
};

const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  itemListElement: available.map((b, i) => ({ "@type": "ListItem", position: i + 1,
    item: { "@type": "Product", name: b.name.replace(" (Pair)", "") + " — Health-Guaranteed " + subLabel(b) + " African Grey",
      category: "Companion parrot",
      offers: { "@type": "Offer", price: String(b.price), priceCurrency: "USD",
        availability: "https://schema.org/InStock", url: site + b.slug } } })) };

const schemaGraph = JSON.stringify({ "@context": "https://schema.org", "@graph": [productSchema, itemListSchema, faqSchema] });
const ogExtra = `<meta property="og:image" content="${site}${IMG}healthy-african-grey-for-sale.webp">`;
const tick = `<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="product" hideGlobalCta={true} schemaJson={schemaGraph} heroPreload={IMG + "healthy-african-grey-for-sale.webp"} heroPreloadSrcset={IMG + "healthy-african-grey-for-sale-760.webp 760w, " + IMG + "healthy-african-grey-for-sale.webp 1408w"} heroPreloadSizes="(max-width: 900px) 100vw, 540px" extraHeadHtml={ogExtra}>

  <main class="hgar">
    <div class="hg-container"><Breadcrumb items={breadcrumbs} /></div>

    <!-- ===================== SPLIT-HERO A · IMAGE LEFT + TRUST RIBBON ===================== -->
    <header class="hero">
      <div class="hero-grid hg-container">
        <figure class="hero-shot">
          <img src={IMG + "healthy-african-grey-for-sale.webp"}
               srcset={IMG + "healthy-african-grey-for-sale-760.webp 760w, " + IMG + "healthy-african-grey-for-sale.webp 1408w"}
               sizes="(max-width: 900px) 100vw, 540px"
               width="1408" height="768" fetchpriority="high" decoding="async"
               alt="African greys for sale with a health guarantee — a healthy Congo grey raised at our Midland, Texas family aviary">
        </figure>
        <div class="hero-copy">
          <p class="eyebrow">Written 72-hour guarantee · Midland, TX · USDA-licensed family aviary since 2014</p>
          <h1>African Greys for Sale With a Health Guarantee You Can <em>Actually Use</em></h1>
          <p class="lead">Nearly every seller on this search result says "health guarantee." Almost none of them say what it covers, how long you have, or what they will actually do about it. Ours runs 72 hours from arrival, rests on an examination by your own avian vet, and is settled as replacement or refund. The terms sit further down this page in full — before you have given us a dollar.</p>
          <div class="hero-cta">
            <a class="btn btn-clay" href="#available">See the greys we guarantee</a>
            <a class="btn btn-ghost" href="#covers">Read the terms first</a>
          </div>
        </div>
      </div>
      <ul class="ribbon hg-container" aria-label="What ships with every grey">
        <li><span set:html={tick} /> 72-hour written guarantee</li>
        <li><span set:html={tick} /> Avian-vet examined</li>
        <li><span set:html={tick} /> DNA-sexed, certificate included</li>
        <li><span set:html={tick} /> CITES Appendix I papers</li>
      </ul>
    </header>

    <!-- ===================== COUNTER STRIP · 6 ===================== -->
    <section class="counter" aria-label="Our guarantee at a glance">
      <div class="hg-container counter-grid">
        {counters.map((c) => (
          <div class="cstat"><span class="cn">{c.n}</span><span class="cl">{c.l}</span></div>
        ))}
      </div>
    </section>

    <!-- ===================== RAIL A (mobile) ===================== -->
    <nav class="railA" aria-label="Jump to a section">
      <ul>
        {sections.map((s) => (
          <li><a href={"#" + s.id} data-dial={s.id}><span class="p">{s.n}</span>{s.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hg-container body-grid">

      <!-- ===================== DIAL 1 · CLAY PROGRESS (desktop) ===================== -->
      <aside class="dial" aria-label="Section progress">
        <div class="dial-card">
          <div class="ring hg-ring"><div class="ring-in"><span class="ring-n">01</span><span class="ring-of">of {N}</span></div></div>
          <ul class="dial-list">
            {sections.map((s) => (
              <li><a href={"#" + s.id} data-dial={s.id}><span class="di">{s.n}</span><span class="dh">{s.label}</span>{s.tag && <span class="dt">{s.tag}</span>}</a></li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="content">

        <!-- ===================== K1 · RECEIPT CARD ===================== -->
        <aside class="k1" aria-label="The guarantee in brief">
          <div class="k1-head"><b>The guarantee, on one receipt</b><span>C.A.Gs · Midland, TX</span></div>
