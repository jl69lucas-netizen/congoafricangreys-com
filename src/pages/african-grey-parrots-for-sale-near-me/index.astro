      const items = [...document.querySelectorAll('[data-dial]')];
      const ids = [...new Set(items.map((i) => i.dataset.dial))];
      const secs = ids.map((id) => document.getElementById(id)).filter(Boolean);
      if (secs.length) {
        let active = -1;
        const paint = (i) => {
          if (i < 0 || i === active) return;
          active = i;
          if (ring) ring.style.setProperty('--p', String(Math.round(((i + 1) / N) * 100)));
          if (num) num.textContent = String(i + 1).padStart(2, '0');
          const id = secs[i].id;
          items.forEach((el) => el.classList.toggle('on', el.dataset.dial === id));
          requestAnimationFrame(() => {
            const chip = document.querySelector('.railB a.on');
            if (chip) chip.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'auto' });
          });
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) paint(secs.indexOf(e.target)); });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
        secs.forEach((s) => io.observe(s));
      }

      // ---- Avail-B group filter ----
      const btns = [...document.querySelectorAll('.side-f')];
      const cards = [...document.querySelectorAll('.bcard')];
      btns.forEach((b) => b.addEventListener('click', () => {
        const f = b.dataset.f;
        btns.forEach((x) => x.classList.toggle('on', x === b));
        cards.forEach((c) => c.classList.toggle('hide', f !== 'all' && c.dataset.p !== f));
      }));

      // ---- Tile field + chip cloud: flash the target tile so the jump is visible ----
      const flash = (hash) => {
        const el = hash && document.querySelector(hash);
        if (!el) return;
        el.classList.add('is-target');
        setTimeout(() => el.classList.remove('is-target'), 1600);
      };
      document.querySelectorAll('.tile-field a, .chipcloud a[href^="#st-"], .chipcloud a[href^="#mt-"]').forEach((a) => {
        a.addEventListener('click', () => flash(a.getAttribute('href')));
      });
      if (location.hash) flash(location.hash);
    })();
  </script>
</BaseLayout>

