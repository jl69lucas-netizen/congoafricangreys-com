---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatementLabel from '../../components/cag-library/StatementLabel.astro';
import clutch from '../../../data/clutch-inventory.json';
import prices from '../../../data/price-matrix.json';
import fin from '../../../data/financial-entities.json';
import locations from '../../../data/locations.json';

// ============================================================================
//  /african-grey-parrots-for-sale-near-me/ — for-sale cluster, the GEO ROUTER
//  Strategy B-3 "Router With a Reason" (sessions/2026-08-10-two-pages-sprint05-strategy.md §B2)
//  Outline: sessions/2026-08-10-two-pages-outline-gate.md PAGE B (9 H2 · 18 H3 · 7 H4 · 7 H5 · 7 H6)
//  Tuple 12 (sessions/2026-07-19-for-sale-component-map.md):
//    Hero-C Mosaic Metrics REFRESHED to a geographic tile field · Dial 1 Clay + Rail B green ticker
//    · T2 Chip Cloud REFRESHED to state/metro chips · K3 Green Ledger + K4 Clipboard + K5 Capsule
//    · NEW Table I "Distance Ledger" · FAQ-B REFRESHED to a map-pin register
//  H6 prefixes reserved to this page: "Distance Note:" · "From Midland:" · "Ask Before You Drive:"
//  This page is the SOLE enumeration of the state and metro grid (plan §0g). The hub sheds it.
//  Prose written fresh from the outline. No sibling page was opened for copy — components and
//  CSS only (Write-From-Outline). No reviews (all 17 in data/reviews.json are spent elsewhere).
//  The 3-3-3 rule stays OUT of the FAQ (locked, project-for-sale-cluster-close).
//  Airports in the Distance Ledger are only the codes each live state page already names; a state
//  whose page names none says so rather than guessing.
// ============================================================================

const title = "African Grey Parrots for Sale Near You, State by State | C.A.Gs";
const description = "African Grey parrots for sale near you: 24 state and 15 metro pages, six birds with printed prices, pickup within 2–3 hours, or $185 airport / $350 home.";
const canonical = "https://congoafricangreys.com/african-grey-parrots-for-sale-near-me/";

const IMG = "/images/near-me-page/";
const site = "https://congoafricangreys.com";
const seam = "/cag-fs-seam-emblem.webp";

const deposit = (prices as any).deposit_display;             // $200
const airport = (prices as any).airport_pickup_display;       // $185
const home = (prices as any).home_delivery_display;           // $350
const cabin = (fin as any).purchase_costs.delivery_options.flight_nanny.display; // from $750
const congoRange = (prices as any).variants.congo_african_grey.price_display;    // $1,700–$3,500
const timnehRange = (prices as any).variants.timneh_african_grey.price_display;  // $1,500–$1,600
const floor = timnehRange.split("–")[0];                       // $1,500
const congoFloor = congoRange.split("–")[0];                   // $1,700
const ceiling = congoRange.split("–")[1];                      // $3,500
const congoWeight = (prices as any).variants.congo_african_grey.weight_grams;   // 400–600
const timnehWeight = (prices as any).variants.timneh_african_grey.weight_grams; // 275–375

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
  { name: "Near You", url: "/african-grey-parrots-for-sale-near-me/" },
];

// ---- Live inventory only. Sold birds never appear and are never InStock. ----
const available = ((clutch as any).birds as any[]).filter((b) => b.status === "available");
const isTimneh = (b: any) => b.variant === "timneh_african_grey";
const subLabel = (b: any) => (isTimneh(b) ? "Timneh" : "Congo");
const groupKey = (b: any) => (b.sex === "pair" ? "pair" : isTimneh(b) ? "timneh" : "congo");
const groupLabel = (b: any) => (b.sex === "pair" ? "Companion pair" : isTimneh(b) ? "Timneh" : "Congo");
const groupCount = (k: string) => available.filter((b) => groupKey(b) === k).length;
const shortName = (b: any) => b.name.replace(" (Pair)", "");
const birdCount = available.length;
const birdWord = ["zero","one","two","three","four","five","six","seven","eight","nine"][birdCount] ?? String(birdCount);

// ---- Photographs (sessions/2026-09-12-two-pages-photo-manifest.json, set B). Alts unique. ----
const birdImg: Record<string, { src: string; alt: string; pos: string; badge?: "top" }> = {
  "Bery": { src: IMG + "bery-congo-african-grey-hen-near-me-card.webp", pos: "center 40%", alt: "Bery working through fresh greens in her cage" },
  "Amie": { src: IMG + "amie-congo-african-grey-hen-near-me-card.webp", pos: "center 38%", alt: "Amie working on a piece of red fruit in her cage" },
  "Roys": { src: IMG + "roys-congo-african-grey-cock-near-me-card.webp", pos: "center 34%", badge: "top", alt: "Roys upright and alert beside his rope toy" },
  "Jins & Jeni (Pair)": { src: IMG + "jins-jeni-bonded-congo-pair-near-me-card.webp", pos: "center 40%", alt: "The companion pair sharing a bowl in the flight cage" },
  "Elad": { src: IMG + "elad-timneh-african-grey-cock-near-me-card.webp", pos: "center 36%", alt: "Elad the Timneh cock stepping onto a waiting hand" },
  "Evie": { src: IMG + "evie-timneh-african-grey-hen-near-me-card.webp", pos: "center 30%", alt: "Evie the Timneh hen at the top of her cage perch" },
};
// One line per bird about where it could fly — the router's angle, not a personality sheet.
const birdWhere: Record<string, string> = {
  "Bery": "A grown hen who has already done her settling here, so a longer flight day costs her less than it would a chick.",
  "Amie": "Still finishing weaning in our kitchen; she flies once she eats on her own, whichever state that turns out to be.",
  "Roys": "A bold cock who treats a travel crate as one more thing to investigate. Direct-flight cities suit him best.",
  "Jins & Jeni (Pair)": "A companion pair, unrelated, offered together. For two birds we suggest the door, not the cargo desk.",
  "Elad": "Weaned Timneh cock, small enough that most cargo counters have handled a crate his size that week.",
  "Evie": "A watchful Timneh hen who prefers a quiet collection. An early airport pickup beats a doorstep crowd.",
};

// ---- Counter strip — 8 snippets, every figure from a data file or the location registry. ----
const states = (locations as any).live_states as any[];      // 25 incl. the CA buy page
const metros = (locations as any).cities as any[];           // 15
const statePattern = states.filter((s) => s.slug.startsWith("african-grey-parrot-for-sale-")); // 24
const counters = [
  { n: String(birdCount), l: "Birds reservable today" },
  { n: String(states.length), l: "States with a page" },
  { n: String(metros.length), l: "Metro pages" },
  { n: "2–3 h", l: "Pickup drive radius" },
  { n: airport, l: "Airport cargo" },
  { n: home, l: "Home delivery" },
  { n: floor, l: "Aviary floor price" },
  { n: "24h", l: "We reply, personally" },
];

// ---- One spine for Dial 1, Rail B and the chip cloud. IDs map to the approved outline. ----
const sections = [
  { n: "01", id: "search", label: "Your search", tag: "Why" },
  { n: "02", id: "grid", label: "Your state", tag: states.length + metros.length + " pages" },
  { n: "03", id: "distance", label: "Distance", tag: "Drive · fly" },
  { n: "04", id: "birds", label: "The birds", tag: birdCount + " now" },
  { n: "05", id: "cheap", label: "Cheap ads", tag: "Caution" },
  { n: "06", id: "papers", label: "Paperwork", tag: "5 docs" },
  { n: "07", id: "arrival", label: "If unwell", tag: "72h" },
  { n: "08", id: "faq", label: "Questions", tag: "12 Q" },
  { n: "09", id: "reserve", label: "Your city", tag: "24h" },
];
const N = sections.length;

// ---- Region grouping for the tile field, the chip cloud and the Distance Ledger. ----
const regionOf: Record<string, string> = {
  TX: "South", FL: "South", GA: "South", NC: "South", VA: "South", TN: "South", KY: "South", MD: "South",
  CA: "West", WA: "West", OR: "West", AZ: "West", CO: "West",
  IL: "Midwest", OH: "Midwest", MI: "Midwest", IN: "Midwest", MO: "Midwest", MN: "Midwest", WI: "Midwest", IA: "Midwest",
  NY: "Northeast", NJ: "Northeast", PA: "Northeast", MA: "Northeast",
};
const regions = ["South", "West", "Midwest", "Northeast"];
const byRegion = (r: string) => states.filter((s) => regionOf[s.abbr] === r).sort((a, b) => a.state.localeCompare(b.state));
const stateHref = (s: any) => "/" + s.slug + "/";
const metrosOf = (abbr: string) => metros.filter((m) => m.state_abbr === abbr);
const stateOfMetro = (m: any) => states.find((s) => s.abbr === m.state_abbr)?.state ?? m.state_abbr;

// ---- NEW Table I "Distance Ledger". Airports = only the codes the live state page names. ----
const namedAirports: Record<string, string> = {
  IL: "ORD · MDW", IN: "IND", IA: "DSM", KY: "SDF", MD: "BWI", MA: "BOS", MI: "DTW · GRR",
  MN: "MSP", MO: "STL · MCI", NY: "JFK · LGA", OH: "CVG · CMH · CLE", PA: "PHL · PIT", CA: "LAX · SFO · SAN · SMF",
};
const ledgerRows = states
  .slice()
  .sort((a, b) => (a.abbr === "TX" ? -1 : b.abbr === "TX" ? 1 : a.state.localeCompare(b.state)))
  .map((s) => ({
    state: s.state, abbr: s.abbr, href: stateHref(s),
    route: s.abbr === "TX" ? "Drive to us, or fly from Midland International Air and Space Port (MAF)" : "Flies from MAF, our airport",
    port: s.abbr === "TX" ? "Collect here; DFW, IAH and AUS by air" : (namedAirports[s.abbr] ?? "Named when you ask"),
    tier: s.abbr === "TX" ? "Free pickup within 2–3 h · " + airport + " · " + home : airport + " airport · " + home + " home",
  }));

// ---- Keep reading — thumbs are cut from each TARGET page's own hero (bake_read_card_thumbs.py). ----
const readMore = [
  { href: "/african-grey-parrot-for-sale-florida/", img: IMG + "read-african-grey-parrot-for-sale-florida-hero", kicker: "A state page", title: "African Grey parrots for sale in Florida", sub: "What every state page in the grid does: the route, the cost, the avian vets and the birds, written for one state." },
  { href: "/african-grey-parrot-breeders-comparison/", img: IMG + "read-african-grey-parrot-breeders-comparison-hero", kicker: "Compare", title: "How African Grey breeders compare", sub: "Shops, aggregators and family aviaries set side by side on paperwork, price and access." },
  { href: "/african-grey-parrot-health-guarantee/", img: IMG + "read-african-grey-parrot-health-guarantee-hero", kicker: "Guarantee", title: "The health guarantee, word for word", sub: "What the 72-hour term covers, what the 24-hour transit window adds, and how to use either." },
  { href: "/trusted-african-grey-parrot-breeders/", img: IMG + "read-trusted-african-grey-parrot-breeders-hero", kicker: "Vetting", title: "Finding a breeder you can check", sub: "The licence search, the address test and the video call, in the order to run them." },
];

// ---- QAB — 12 questions from the Sprint 0 PAA set and the near-me query cluster. ----
const faqs = [
  { q: "Are there African Grey parrots for sale near me?", a: "Probably not from a breeder, and that is the honest answer for most of the country. A search for a Grey near you returns bird shops, rescues and classified ads because those are the businesses with a pin in your town. We are one aviary in west Texas. What we can offer instead is a page written for your state or your metro, a real bird with a price beside it, and a route that gets the bird to you inside a day. Start with the grid on this page." },
  { q: "Is an African Gray parrot the same bird as an African Grey?", a: "Yes. Gray is the American spelling and grey is the British one, and the bird does not mind which you use. Both spellings, and both parrot and parrots, land buyers on this page, which is why we say it plainly here rather than pretending there are two species. The two birds that do differ are Congo and Timneh, and the cards further down show which of ours is which." },
  { q: "Where can I buy an African Grey parrot near me without getting scammed?", a: "From a seller with an address you can visit, a licence you can look up and a bird you can see move on a live video call today. Those three tests remove nearly every fake listing on their own. Run them on us first: the C.A.Gs licence is searchable on the USDA public database, our address is on the contact page, and we do video calls on request before any deposit." },
  { q: "How much does an African Grey parrot cost near me?", a: "Between " + floor + " and " + ceiling + " here, with the low end a Timneh hen and the top the two-bird companion pair, and every figure is printed on its card rather than quoted after you enquire. Local classifieds will show you anything from a few hundred dollars to several thousand for what looks like the same bird, and the section on cheap listings explains why the low end is usually not a bird at all." },
  { q: "Can you legally own an African Grey parrot in my state?", a: "As a pet owner in the United States, yes. The international treaty listing for this species restricts commercial trade in wild-caught birds; it does not stop you owning a captive-bred bird with its paperwork in order, which is what every bird here is. A few cities and homeowner associations have rules about the number of birds or about noise, so check locally if you plan to keep several." },
  { q: "How far will you drive to deliver a bird?", a: "We do not drive deliveries beyond our own area. Inside a two to three hour radius of us you come to the aviary, meet the bird, and take it home in your own car, which costs nothing. Beyond that the bird flies, either to your nearest cargo airport at " + airport + " or to your door at " + home + ". The drive-or-fly line is explained in the distance section above." },
  { q: "Which airport will my bird arrive at?", a: "The nearest major airport with a live-animal cargo counter served by a direct or single-connection flight from here. For most states that is the obvious one, and the Distance Ledger on this page lists the counters our state pages already name. Where a state has more than one option we choose by flight time, not by which is closest on a map, because a shorter day matters more to the bird than fewer miles to you." },
  { q: "Can I reserve a bird before I have seen it in person?", a: "Yes, with a video call first. A " + deposit + " deposit holds a named bird while you arrange travel or a flight date, and it comes off the balance. What a deposit never does is buy a photograph: you are reserving a specific bird you have watched move, on a call we set up with you, not a listing image that could belong to anyone." },
  { q: "Does the paperwork change if the bird crosses state lines?", a: "No. The same folder leaves with the bird whether it is collected here in Texas or lands in Massachusetts: the written health guarantee, the avian veterinary certificate, the sexing certificate, the captive-bred treaty paperwork and the hatch record. The health certificate is the one document the airline asks to see, so it travels on the crate rather than in the post." },
  { q: "What if the bird arrives unwell?", a: "Call us the same day. The 72-hour written term starts when you take possession, and the first call is what makes it usable, because it lets us arrange an avian veterinary visit near you while the window is open. We also cover anything transit-related for the first 24 hours. Our address and our licence stand behind that term, which is more than a classified listing can say." },
  { q: "Do you have a bird shop or showroom I can visit?", a: "No. We are a home aviary, not a shop, and that is the difference this whole page is about. A shop resells birds it did not hatch; we hatched, hand-fed and weaned every bird on this page in our house. You are welcome to visit by appointment if you are within driving distance; the showroom is our living room, and the floor model talks back." },
  { q: "My state is not in your grid. Can you still ship to me?", a: "Yes. We ship to all fifty states. The grid lists the states and metros that have their own page on this site, not the limit of where a bird can fly. Use the form at the bottom, tell us your city, and we will reply with the route and the cost, which is the same " + airport + " or " + home + " everywhere in the country." },
];

const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

// One Product per real available bird, inside an ItemList. Sold birds are absent entirely.
const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  name: "African Grey parrots available from C.A.Gs, shipped to every state",
  itemListElement: available.map((b, i) => ({ "@type": "ListItem", position: i + 1,
    item: { "@type": "Product",
      name: shortName(b) + " — " + subLabel(b) + " African Grey" + (b.sex === "pair" ? " companion pair" : ""),
      category: "Companion parrot",
      image: site + birdImg[b.name].src,
      brand: { "@type": "Organization", name: "C.A.Gs" },
      offers: { "@type": "Offer", price: String(b.price), priceCurrency: "USD",
        availability: "https://schema.org/InStock", url: site + b.slug,
        areaServed: "US",
        seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } } } })) };

const groupSchema = {
  "@context": "https://schema.org", "@type": "Product",
  name: "African Grey Parrots for Sale Near You, Routed by State and Metro",
  image: [site + IMG + "african-grey-parrots-for-sale-near-me-hero.webp", site + IMG + "choose-your-state-or-metro-area-infographic.webp"],
  description: "Captive-bred African Grey parrots from a family aviary in Midland, Texas, matched to buyers in every state: pickup within a two to three hour drive, or airport cargo and home delivery nationwide.",
  category: "Companion parrot",
  brand: { "@type": "Organization", name: "C.A.Gs" },
  offers: { "@type": "AggregateOffer", lowPrice: String(Math.min(...available.map((b) => b.price))),
    highPrice: String(Math.max(...available.map((b) => b.price))), priceCurrency: "USD",
    offerCount: String(birdCount), availability: "https://schema.org/InStock", url: canonical,
    areaServed: "US",
    seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } },
};

const shipNodes = [
  { "@type": "OfferShippingDetails", "@id": canonical + "#ship-airport", name: "Airport cargo pickup",
    shippingRate: { "@type": "MonetaryAmount", value: String((fin as any).purchase_costs.delivery_options.airport_pickup.cost), currency: "USD" },
    shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" } },
  { "@type": "OfferShippingDetails", "@id": canonical + "#ship-home", name: "Home delivery",
    shippingRate: { "@type": "MonetaryAmount", value: String((fin as any).purchase_costs.delivery_options.home_delivery.cost), currency: "USD" },
    shippingDestination: { "@type": "DefinedRegion", addressCountry: "US" } },
];
const shipRefs = shipNodes.map((s) => ({ "@id": s["@id"] }));
(groupSchema.offers as any).shippingDetails = shipRefs;
itemListSchema.itemListElement.forEach((li: any) => { li.item.offers.shippingDetails = shipRefs; });
const schemaGraph = JSON.stringify({ "@context": "https://schema.org", "@graph": [groupSchema, itemListSchema, faqSchema, ...shipNodes] });
const ogExtra = `<meta property="og:image" content="${site}${IMG}african-grey-parrots-for-sale-near-me-hero.webp">`;
const tick = `<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const pin = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
const heroSrcset = IMG + "african-grey-parrots-for-sale-near-me-hero-400.webp 400w, " + IMG + "african-grey-parrots-for-sale-near-me-hero-760.webp 760w, " + IMG + "african-grey-parrots-for-sale-near-me-hero.webp 1280w";
const heroSizes = "(max-width: 700px) 100vw, (max-width: 980px) 44vw, 520px";
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="product" hideGlobalCta={true} schemaJson={schemaGraph} heroPreload={IMG + "african-grey-parrots-for-sale-near-me-hero.webp"} heroPreloadSrcset={heroSrcset} heroPreloadSizes={heroSizes} extraHeadHtml={ogExtra}>

  <main class="nmr">
    <div class="nm-container"><Breadcrumb items={breadcrumbs} /></div>

    <!-- ===================== HERO-C · MOSAIC METRICS, REFRESHED TO A GEOGRAPHIC TILE FIELD ===================== -->
    <header class="hero">
      <div class="hero-grid nm-container">
        <div class="hero-copy">
          <p class="eyebrow">C.A.Gs, one USDA-licensed family aviary in west Texas · {states.length} states and {metros.length} metros with their own page · every captive-bred bird flies with its CITES papers</p>
          <ul class="hero-metrics" aria-label="This page at a glance">
            <li><b>{states.length + metros.length}</b><span>Pages to route you to</span></li>
            <li><b>{birdCount}</b><span>Birds reservable</span></li>
            <li><b>2–3 h</b><span>Drive-to-us radius</span></li>
          </ul>
          <h1>African Grey Parrots for Sale Near You — Find Your State, <em>Not a Classified Ad</em></h1>
          <p class="lead text-cream">If you typed African Grey parrots for sale near me, here is what near means for a bird that hatched in one house in Texas: you are close enough to drive here, or your bird flies to your nearest cargo counter. Pick your state below and the page you land on is written for where you live. Everything else on this page is why that beats the listing sites your search showed you first.</p>
          <div class="hero-cta">
            <a class="btn btn-clay" href="#grid">Find your state or metro</a>
            <a class="btn btn-ghost" href="#birds">See the {birdWord} birds</a>
          </div>
        </div>
        <div class="hero-field">
          <figure class="field-photo">
            <img src={IMG + "african-grey-parrots-for-sale-near-me-hero.webp"} srcset={heroSrcset} sizes={heroSizes}
                 width="1280" height="960" fetchpriority="high" decoding="async"
                 alt="African Grey parrots for sale near you: a Congo settled on its stand in a family living room">
            <figcaption><b>Raised in a living room</b><span>Not a shop, not a showroom</span></figcaption>
          </figure>
          <nav class="tile-field" aria-label="Jump to a state in the grid">
            {states.slice().sort((a, b) => a.abbr.localeCompare(b.abbr)).map((s) => (
              <a href={"#st-" + s.abbr.toLowerCase()} title={s.state}>{s.abbr}</a>
            ))}
            <a class="tile-more" href="#grid">{metros.length} metros <span aria-hidden="true">→</span></a>
          </nav>
        </div>
      </div>
    </header>

    <!-- ===================== COUNTER STRIP · 8 ===================== -->
    <section class="counter" aria-label="Distance and price at a glance">
      <div class="nm-container counter-grid">
        {counters.map((c) => (
          <div class="cstat"><span class="cn">{c.n}</span><span class="cl">{c.l}</span></div>
        ))}
      </div>
    </section>

    <!-- ===================== RAIL B · GREEN TICKER (mobile) ===================== -->
    <nav class="nm-rail" aria-label="Jump to a section">
      <div class="nm-container railB">
        {sections.map((s, i) => (
          <a href={"#" + s.id} data-dial={s.id} class={i === 0 ? "on" : ""}><span class="p">{s.n}</span> {s.label}</a>
        ))}
      </div>
    </nav>

    <div class="nm-container body-grid">

      <!-- ===================== DIAL 1 · CLAY PROGRESS (desktop) ===================== -->
      <aside class="dial" aria-label="Section progress">
        <div class="dial-card">
          <div class="ring" id="dialRing" style="--p:11">
            <div class="ring-in"><span class="ring-n" id="dialNum">01</span><span class="ring-of">of {N}</span></div>
          </div>
          <ul class="dial-list">
            {sections.map((s, i) => (
              <li><a href={"#" + s.id} data-dial={s.id} class={i === 0 ? "on" : ""}><span class="di">{s.n}</span><span class="dh">{s.label}</span>{s.tag && <span class="dt">{s.tag}</span>}</a></li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="content">

        <!-- ===================== K3 GREEN LEDGER · near vs reachable ===================== -->
        <div class="k3" role="note" aria-label="Near versus reachable, in five lines">
          <p class="k3-title">Near, or Reachable — the Five Lines That Decide It</p>
          <div class="k3-row"><span>Within two to three hours of us by car</span><b>Come and collect, free</b></div>
          <div class="k3-row"><span>Everywhere else in the country</span><b>Flies, {airport} airport</b></div>
          <div class="k3-row"><span>Straight to your door</span><b>{home} home delivery</b></div>
          <div class="k3-row"><span>Pages written for your area</span><b>{states.length} states · {metros.length} metros</b></div>
