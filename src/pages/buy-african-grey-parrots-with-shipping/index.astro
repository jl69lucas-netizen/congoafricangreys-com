                      <div class="bchips">
                        <span>{subLabel(b)}</span>
                        <span>{b.sex === "pair" ? "Two birds" : b.sex === "male" ? "Cock" : "Hen"}</span>
                        <span>Papers included</span>
                      </div>
                      <p class="bship">Ships nationwide · {airport} airport · {home} home</p>
