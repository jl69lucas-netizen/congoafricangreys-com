          <p class="reading-h">Keep reading before you reserve</p>
          <div class="read-cards">
            {readMore.map((r) => (
              <a class="read-card" href={r.href}>
                <img src={r.img + "-320.webp"} srcset={r.img + "-320.webp 320w, " + r.img + "-760.webp 760w"} sizes="120px" width="320" height="175" loading="lazy" decoding="async" alt={r.title}>
                <span class="rc-body">
                  <span class="rc-k">{r.kicker}</span>
                  <b>{r.title}</b>
                  <span class="rc-s">{r.sub}</span>
                </span>
              </a>
            ))}
          </div>
        </nav>

      </div>
    </div>
  </main>

  <script is:inline define:vars={{ N }}>
    (() => {
      // ---- Dial 2 scroll-spy ----
      const ring = document.querySelector('.bdial');
      const num = document.getElementById('dialNum');
      const items = [...document.querySelectorAll('[data-dial]')];
      const ids = [...new Set(items.map((i) => i.dataset.dial))];
      const secs = ids.map((id) => document.getElementById(id)).filter(Boolean);
      if (ring && secs.length) {
        let active = -1;
        const paint = (i) => {
          if (i < 0 || i === active) return;
          active = i;
          ring.style.setProperty('--p', String(Math.round(((i + 1) / N) * 100)));
          if (num) num.textContent = String(i + 1).padStart(2, '0');
          const id = secs[i].id;
          items.forEach((el) => el.classList.toggle('on', el.dataset.dial === id));
          requestAnimationFrame(() => {
            const chip = document.querySelector('.railB a.on');
            if (chip) chip.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'auto' });
          });
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) paint(secs.indexOf(e.target)); });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
        secs.forEach((s) => io.observe(s));
      }

      // ---- Avail-B group filter ----
      const btns = [...document.querySelectorAll('.side-f')];
      const cards = [...document.querySelectorAll('.bcard')];
      btns.forEach((b) => b.addEventListener('click', () => {
        const f = b.dataset.f;
        btns.forEach((x) => x.classList.toggle('on', x === b));
        cards.forEach((c) => c.classList.toggle('hide', f !== 'all' && c.dataset.p !== f));
      }));
    })();
  </script>
</BaseLayout>

<style is:global>
