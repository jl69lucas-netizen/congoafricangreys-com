---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatementLabel from '../../components/cag-library/StatementLabel.astro';
import clutch from '../../../data/clutch-inventory.json';
import prices from '../../../data/price-matrix.json';

// ============================================================================
//  /buy-african-grey-parrots-with-shipping/ — for-sale cluster, buy page
//  Strategy A-3 "Proof-of-Price Storefront" (sessions/2026-08-10-two-pages-sprint05-strategy.md §A2)
//  Outline: sessions/2026-08-10-two-pages-outline-gate.md PAGE A (10 H2 · 24 H3 · 10 H4 · 8 H5 · 6 H6)
//  Tuple 11 (sessions/2026-07-19-for-sale-component-map.md):
//    Split-Hero A + price-transparency ribbon · Dial 2 Dark-Aviary + Rail B green ticker
//    · T3 Boarding-Pass TOC (genuine first use, restricted to shipping-heavy pages)
//    · K1 Receipt + K4 Clipboard · NEW Table H "Price Ladder" · FAQ-A refreshed to a clay $ chip
//  H6 prefixes reserved to this page: "Price Check:" · "On the Paperwork:" · "What We Measured:"
//  Prose written fresh from the outline. No sibling page was opened for copy — components
//  and CSS only (Write-From-Outline). No reviews: all 17 in data/reviews.json are spent
//  on other pages, and one quote credited twice fails evidence_audit review-attribution.
//  The 3-3-3 rule stays OUT of the FAQ (locked decision, project-for-sale-cluster-close)
//  until it is sourced to the Verified-Claim Ledger.
//  Evidence caps (for-sale + budgets_by_slug): C.A.Gs 15 · CITES 5 · Appendix I 4
//    · DNA 6 · captive-bred 5 · USDA 3 · Midland 4 · scam 2 · legit 0.
// ============================================================================

const title = "Buy an African Grey Parrot Online — Every Price Shown | C.A.Gs";
const description = "Buy an African Grey parrot online from the family who raised it. Six documented birds, every price published, airport cargo $185, home delivery $350, cabin $750.";
const canonical = "https://congoafricangreys.com/buy-african-grey-parrots-with-shipping/";

const IMG = "/images/buy-shipping-page/";
const site = "https://congoafricangreys.com";
const seam = "/cag-fs-seam-emblem.webp";

const deposit = (prices as any).deposit_display;            // $200
const airport = (prices as any).airport_pickup_display;      // $185
const home = (prices as any).home_delivery_display;          // $350
const cabin = (prices as any).cabin_nanny_display;           // $750
const congoRange = (prices as any).variants.congo_african_grey.price_display;   // $1,700–$3,500
const timnehRange = (prices as any).variants.timneh_african_grey.price_display; // $1,500–$1,600

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
  { name: "Buy With Shipping", url: "/buy-african-grey-parrots-with-shipping/" },
];

// Live inventory only. Sold birds never appear and are never InStock.
const available = ((clutch as any).birds as any[]).filter((b) => b.status === "available");
const isTimneh = (b: any) => b.variant === "timneh_african_grey";
const subLabel = (b: any) => (isTimneh(b) ? "Timneh" : "Congo");
const groupKey = (b: any) => (b.sex === "pair" ? "pair" : isTimneh(b) ? "timneh" : "congo");
const groupLabel = (b: any) => (b.sex === "pair" ? "Bonded pair" : isTimneh(b) ? "Timneh" : "Congo");
const groupCount = (k: string) => available.filter((b) => groupKey(b) === k).length;
const shortName = (b: any) => b.name.replace(" (Pair)", "");

// Photographs chosen 2026-09-12 from assets/brand (sessions/2026-09-12-two-pages-photo-manifest.json).
// Every alt differs in its first five words (Rule 50b).
const birdImg: Record<string, { src: string; alt: string; pos: string; badge?: "top" }> = {
  "Bery": { src: IMG + "bery-congo-african-grey-hen-card.webp", pos: "center 32%",
    alt: "A one year old Congo hen steady under a gentle hand" },
  "Amie": { src: IMG + "amie-congo-african-grey-hen-card.webp", pos: "center 34%",
    alt: "Amie as a hand fed baby cupped in both hands" },
  "Roys": { src: IMG + "roys-congo-african-grey-cock-card.webp", pos: "center 30%", badge: "top",
    alt: "Roys standing beside his play ball at four months" },
  "Jins & Jeni (Pair)": { src: IMG + "jins-jeni-bonded-congo-pair-card.webp", pos: "center 30%",
    alt: "Jins and Jeni beak to beak, the bonded pair we sell together" },
  "Elad": { src: IMG + "elad-timneh-african-grey-cock-card.webp", pos: "center 36%",
    alt: "Elad stepping up to a hand at his cage door" },
  "Evie": { src: IMG + "evie-timneh-african-grey-hen-card.webp", pos: "center 34%",
    alt: "Evie the Timneh hen upright on her rope perch" },
};
const birdBlurb: Record<string, string> = {
  "Bery": "Grown hen, past weaning and past the settling wobbles a younger bird still has ahead.",
  "Amie": "Hand-fed from a syringe in our kitchen; she finishes weaning here before she flies.",
  "Roys": "Busy, bold cock who works a foraging toy until it gives up its last pellet.",
  "Jins & Jeni (Pair)": "Two unrelated birds who chose each other. They leave together or not at all.",
  "Elad": "Charcoal Timneh cock, horn-coloured upper beak, already stepping up on request.",
  "Evie": "Timneh hen who watches a room for a while before she decides to join it.",
};

// Counter strip — 8 snippets (matrix row 2). Every figure from a data file.
const counters = [
  { n: String(available.length), l: "Birds reservable today" },
  { n: timnehRange.split("–")[0], l: "Aviary floor price" },
  { n: congoRange.split("–")[0], l: "Congo floor price" },
  { n: "72 Hours", l: "Written health window" },
  { n: airport, l: "Airport cargo" },
  { n: home, l: "Home delivery" },
  { n: cabin, l: "Cabin with a nanny" },
  { n: "24h", l: "We reply, personally" },
];

// Dial 2 + Rail B + T3 all read this one spine. IDs map to the approved outline.
const sections = [
  { n: "01", id: "birds", label: "Birds you can reserve", tag: available.length + " now" },
  { n: "02", id: "price", label: "Four prices, one bird", tag: "Proof" },
  { n: "03", id: "papers", label: "Paperwork in the folder", tag: "5 docs" },
  { n: "04", id: "first72", label: "The first 72 hours", tag: "72h" },
  { n: "05", id: "travel", label: "Getting your bird home", tag: "3 routes" },
  { n: "06", id: "states", label: "Five states we ship", tag: "IA·KY·MD·TN·WI" },
  { n: "07", id: "choose", label: "Congo or Timneh", tag: "Decide" },
  { n: "08", id: "checks", label: "Catching a fake listing", tag: "5 checks" },
  { n: "09", id: "faq", label: "Buying questions", tag: "12 Q" },
  { n: "10", id: "reserve", label: "Reserve a bird", tag: "24h" },
];
const N = sections.length;

// NEW Table H "Price Ladder" — the mandatory price artifact. Every row is a reading we
// recorded on one day (sprint0 §3c). Sources stay descriptive; the figures are the evidence.
const ladderRows = [
  { src: "A free-hosted “foundation” site", price: "$850", when: "10 Aug 2026", incl: "“Free delivery” advertised. No vet record, no sexing certificate, no band named anywhere on the listing." },
  { src: "A second free-site seller", price: "$1,500", when: "10 Aug 2026", incl: "One flat price for any bird, with no paperwork named and no individual bird shown." },
  { src: "A classified listing", price: "$4,500", when: "10 Aug 2026", incl: "Same seller as the two rows below, same day, lowest of their three numbers." },
  { src: "That seller’s own website", price: "$7,500", when: "10 Aug 2026", incl: "Same birds again, priced three thousand dollars above their own classified." },
  { src: "An aggregator listing", price: "$8,500", when: "10 Aug 2026", incl: "The same seller’s ceiling, on a third platform, on that same afternoon." },
  { src: "Google’s AI Overview", price: "$5,000–$8,500", when: "10 Aug 2026", incl: "Called “typical”, attached to no seller and no bird, and it also told buyers that anything under $2,000 is fraudulent." },
  { src: "Us, on this page", price: timnehRange.split("–")[0] + "–" + congoRange.split("–")[1], when: "Today", incl: "Hand-feeding to weaning, the pre-sale avian exam, the screening panel, sexing, the paper folder and the closed band." },
];

// Geo — IA · KY · MD · TN · WI, the five unspent by any built sibling. All slugs verified live.
const statePlaces = [
  { href: "/african-grey-parrot-for-sale-iowa/", label: "African Greys for sale in Iowa", note: "Des Moines cargo counter" },
  { href: "/african-grey-parrot-for-sale-kentucky/", label: "Buy an African Grey in Kentucky", note: "Louisville live-animal desk" },
  { href: "/african-grey-parrot-for-sale-maryland/", label: "African Grey parrots in Maryland", note: "Baltimore–Washington routing" },
  { href: "/african-grey-parrot-for-sale-tennessee/", label: "Hand-raised Greys in Tennessee", note: "Nashville direct flights" },
  { href: "/african-grey-parrot-for-sale-wisconsin/", label: "Documented Greys in Wisconsin", note: "Milwaukee cargo pickup" },
];

const readMore = [
  { href: "/african-grey-parrot-price/", img: IMG + "read-african-grey-parrot-price-hero", kicker: "Costs", title: "What an African Grey parrot costs", sub: "The purchase price beside the first-year setup, the annual spend and the lifetime figure." },
  { href: "/congo-vs-timneh-african-grey/", img: IMG + "read-congo-vs-timneh-african-grey-hero", kicker: "Compare", title: "Congo vs Timneh African Grey", sub: "Size, tail colour, talking onset and temperament, with both birds side by side." },
  { href: "/how-to-avoid-african-grey-parrot-scams/", img: IMG + "read-how-to-avoid-african-grey-parrot-scams-hero", kicker: "Caution", title: "How to avoid a fraudulent listing", sub: "The payment routes, stock photographs and pressure tactics a fake seller relies on." },
  { href: "/cites-african-grey-documentation/", img: IMG + "read-cites-african-grey-documentation-hero", kicker: "Paperwork", title: "Documentation, explained in full", sub: "What each certificate proves, who issues it, and how to check it against your bird." },
];

// QAB — 12 questions from the Sprint 0.5 fan-out and the measured PAA set.
const faqs = [
  { q: "Where can I buy an African Grey parrot?", a: "From the people who hatched it, ideally, and you should be able to find them on a map. We are a family aviary in west Texas, we have six birds available as this page stands, and every one of them was raised in our house rather than bought in to resell. A breeder who raised your bird can tell you what it eats, how it behaves at dusk and which of its parents it takes after. A reseller can only tell you the price." },
  { q: "Can you buy an African Grey parrot online safely?", a: "Yes, with one condition: everything you cannot see in person has to be verifiable another way. Ask for a live video call with the specific bird, on the day, not a clip that could be a year old. Ask for the paperwork before you pay rather than after. Check the price against what raising a bird actually costs, which is the table further up this page. Pay by a method that leaves you recourse. If a seller resists any of those four, the problem is the seller." },
  { q: "How much should an African Grey parrot cost?", a: "Ours run from " + timnehRange.split("–")[0] + " for a Timneh hen to " + congoRange.split("–")[1] + " for the bonded pair, and the price ladder above shows what else the internet was asking on one day in August. The honest range is wide because birds differ in age, sex and subspecies, but it has a floor. Below roughly two thousand dollars, something in the listing is usually untrue, and Google's own summary of this search pushes buyers the other way by calling eight thousand typical." },
  { q: "What is the best age to buy an African Grey parrot?", a: "After weaning, which for these birds lands somewhere between twelve and sixteen weeks. An unweaned chick is the single most common thing to go wrong in this trade, because hand-feeding is a skill with a real risk of aspiration and crop burn, and a seller who hands that job to a first-time buyer has moved their risk onto you. We finish the job here. When a bird leaves, it eats on its own." },
  { q: "Do I need a licence to own an African Grey parrot?", a: "Not as a pet owner in the United States. The treaty listing that governs these birds restricts international commercial trade in wild-caught ones, and it does not stop you owning a bird bred in this country with its papers in order. State and city rules differ on numbers and noise rather than on the species, so check locally if you keep several birds, and keep your folder somewhere you can find it." },
  { q: "How do you ship an African Grey parrot?", a: "Three ways, and the section above sets each one out. Airport cargo at " + airport + " is what most buyers choose: your bird flies as manifested live-animal cargo on a direct flight where the route allows, and you collect at the airline's cargo desk. Home delivery at " + home + " brings the crate to your door. A cabin seat with a flight nanny is " + cabin + " and is quoted per route, because the nanny's own ticket sets the cost." },
  { q: "Is flying safe for a parrot?", a: "It is, when the bird is old enough, the crate meets the live-animal standard and the flight is direct. Connections are where handling and temperature risk accumulate, so we book around them. Our birds travel fully weaned and vet-cleared, with the health certificate taped to the crate because the airline asks for it. We also cover anything transit-related for twenty-four hours from the moment you take possession." },
  { q: "What comes with the bird when I buy it?", a: "A paper folder and a ringed bird. The folder holds the written health guarantee, the avian veterinary certificate from the pre-sale examination, the sexing certificate, the treaty paperwork and the hatch record. The ring is already on your bird's leg, and its number appears on the certificates so you can match the documents to the parrot yourself on day one. The paperwork section on this page lists each document and what it proves." },
  { q: "Can I visit before I buy?", a: "Yes, and we would rather you did. We are two or three hours from a good part of Texas and buyers drive it regularly. If you cannot make the trip, a video call is the next best thing and we will do it whenever you ask. What we will not do is take a deposit from somebody who has never seen the bird move." },
  { q: "What deposit do you take, and is it refundable?", a: "A " + deposit + " deposit holds a bird and comes off the balance. It is what stops us selling a bird twice while you arrange a flight. If something changes on your side before travel, tell us early and we will talk about it rather than hide behind a policy; if a bird's health changes on our side, you get the deposit back and your choice of the others. Nothing is taken through the form on this page." },
  { q: "Do you sell African Grey parrots to any buyer?", a: "No, and the questions on the form are how we decide. We do not sell to pet stores, to commercial breeding operations or to anyone buying to resell cheaply, and we ask directly rather than guess. We also ask whether you have surrendered an animal before, because a straight answer tells us more than a perfect one. A bird that may live forty years deserves that conversation." },
  { q: "How quickly will you reply?", a: "Within a day, and usually the same afternoon. It will be Mark or Teri writing, not a queue, which is also why we answer questions about birds we do not have and routes we cannot fly. If you have not heard from us in twenty-four hours, something went wrong with the email rather than with your enquiry, so send it again." },
];

const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

// One Product per real available bird, inside an ItemList. Sold birds are absent entirely.
const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  name: "African Grey parrots available to buy from C.A.Gs",
  itemListElement: available.map((b, i) => ({ "@type": "ListItem", position: i + 1,
    item: { "@type": "Product",
      name: shortName(b) + " — " + subLabel(b) + " African Grey" + (b.sex === "pair" ? " bonded pair" : ""),
      category: "Companion parrot",
      image: site + birdImg[b.name].src,
      brand: { "@type": "Organization", name: "C.A.Gs" },
      offers: { "@type": "Offer", price: String(b.price), priceCurrency: "USD",
        availability: "https://schema.org/InStock", url: site + b.slug,
        seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } } } })) };

const groupSchema = {
  "@context": "https://schema.org", "@type": "Product",
  name: "African Grey Parrot for Sale Online, Documented and Weaned",
  image: [site + IMG + "buy-african-grey-parrots-with-shipping-hero.webp", site + IMG + "buy-african-grey-price-ladder-850-to-8500-infographic.webp"],
  description: "A weaned, hand-raised African Grey parrot bought direct from the family aviary that hatched it, with the price published, the paper folder listed item by item, and three delivery routes quoted openly.",
  category: "Companion parrot",
  brand: { "@type": "Organization", name: "C.A.Gs" },
  offers: { "@type": "AggregateOffer", lowPrice: String(Math.min(...available.map((b) => b.price))),
    highPrice: String(Math.max(...available.map((b) => b.price))), priceCurrency: "USD",
    offerCount: String(available.length), availability: "https://schema.org/InStock", url: canonical,
    seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs", alternateName: "Congo African Greys" } },
};

const schemaGraph = JSON.stringify({ "@context": "https://schema.org", "@graph": [groupSchema, itemListSchema, faqSchema] });
const ogExtra = `<meta property="og:image" content="${site}${IMG}buy-african-grey-parrots-with-shipping-hero.webp">`;
const tick = `<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="product" hideGlobalCta={true} schemaJson={schemaGraph} heroPreload={IMG + "buy-african-grey-parrots-with-shipping-hero.webp"} heroPreloadSrcset={IMG + "buy-african-grey-parrots-with-shipping-hero-760.webp 760w, " + IMG + "buy-african-grey-parrots-with-shipping-hero.webp 1280w"} heroPreloadSizes="(max-width: 900px) 100vw, 540px" extraHeadHtml={ogExtra}>

  <main class="bws">
    <div class="bw-container"><Breadcrumb items={breadcrumbs} /></div>

    <!-- ===================== SPLIT-HERO A · IMAGE LEFT + PRICE RIBBON ===================== -->
    <header class="hero">
      <div class="hero-grid bw-container">
        <figure class="hero-shot">
          <img src={IMG + "buy-african-grey-parrots-with-shipping-hero.webp"}
               srcset={IMG + "buy-african-grey-parrots-with-shipping-hero-760.webp 760w, " + IMG + "buy-african-grey-parrots-with-shipping-hero.webp 1280w"}
               sizes="(max-width: 900px) 100vw, 540px"
               width="1280" height="960" fetchpriority="high" decoding="async"
               alt="A hand raised Congo stepping onto its owner's hand at home">
        </figure>
        <div class="hero-copy">
          <p class="eyebrow">USDA-licensed family aviary in west Texas since 2014 · {available.length} captive-bred birds reservable · we answer in a day</p>
          <h1>Buy an African Grey Parrot Online — Documented, Weaned, and <em>Priced in the Open</em></h1>
          <p class="lead">Every bird on this page has a name, a photograph taken here, a price printed beside it and a folder of paperwork that travels with it. Nothing is hidden behind “enquire for pricing”, because the thing buyers most need to judge is the one thing this trade keeps vague. Read the prices first, then read why they are what they are.</p>
          <div class="hero-cta">
            <a class="btn btn-clay" href="#birds">See the {available.length} birds and their prices</a>
            <a class="btn btn-ghost" href="#price">Why prices vary this much</a>
          </div>
        </div>
      </div>
      <ul class="ribbon bw-container" aria-label="What every price here includes">
        <li><span set:html={tick} /> {timnehRange.split("–")[0]} floor, published</li>
        <li><span set:html={tick} /> Every price shown on the card</li>
        <li><span set:html={tick} /> CITES paperwork included</li>
        <li><span set:html={tick} /> 72-hour written guarantee</li>
      </ul>
    </header>

    <!-- ===================== COUNTER STRIP · 8 ===================== -->
    <section class="counter" aria-label="This page at a glance">
      <div class="bw-container counter-grid">
        {counters.map((c) => (
          <div class="cstat"><span class="cn">{c.n}</span><span class="cl">{c.l}</span></div>
        ))}
      </div>
    </section>

    <!-- ===================== RAIL B · GREEN TICKER (mobile) ===================== -->
    <nav class="bw-rail" aria-label="Jump to a section">
      <div class="bw-container railB">
        {sections.map((s, i) => (
          <a href={"#" + s.id} data-dial={s.id} class={i === 0 ? "on" : ""}><span class="p">{s.n}</span> {s.label}</a>
        ))}
      </div>
    </nav>

    <div class="bw-container body-grid">

      <!-- ===================== DIAL 2 · DARK AVIARY (desktop) ===================== -->
      <aside class="bdial-wrap" aria-label="Section progress">
        <nav class="bdial" style="--p:10">
          <div class="bdial-ring"><div><b id="dialNum">01</b><span>of {N}</span></div></div>
          <div class="bdial-list">
            {sections.map((s, i) => (
              <a href={"#" + s.id} data-dial={s.id} class={i === 0 ? "on" : ""}><span class="num">{s.n}</span><span class="dh">{s.label}</span>{s.tag && <span class="tag">{s.tag}</span>}</a>
            ))}
          </div>
        </nav>
      </aside>

      <div class="content">

        <!-- ===================== K1 · RECEIPT CARD ===================== -->
        <aside class="k1" aria-label="What a price here covers">
          <div class="k1-head"><b>One price, itemised</b><span>Printed, not quoted on request</span></div>
          <dl class="k1-rows">
            <div><dt>Aviary range</dt><dd>{timnehRange.split("–")[0]}–{congoRange.split("–")[1]} · Congo from {congoRange.split("–")[0]}, Timneh {timnehRange}</dd></div>
            <div><dt>Included</dt><dd>Hand-feeding to weaning · pre-sale avian exam · screening panel · sexing certificate · <a href="#papers">the full paper folder</a></dd></div>
            <div><dt>Deposit</dt><dd>{deposit}, off the balance, holds one named bird</dd></div>
            <div><dt>Travel</dt><dd>{airport} airport cargo · {home} home delivery · {cabin} cabin with a nanny · collection here is free</dd></div>
            <div><dt>Guarantee</dt><dd><a href="#first72">72 hours written from arrival</a>, plus 24 hours on anything transit-related</dd></div>
            <div><dt>Not charged</dt><dd>No listing fee, no “paperwork fee”, no delivery surcharge added later</dd></div>
          </dl>
        </aside>

        <!-- ===================== T3 · BOARDING-PASS TOC (first use) ===================== -->
        <nav class="bpass" aria-label="What this page covers">
          <div class="bpass-head">
            <span class="bp-k">Page itinerary</span>
            <span class="bp-route">MAF <span aria-hidden="true">→</span> YOUR CITY</span>
          </div>
          <ol class="bpass-stops">
            {sections.map((s) => (
              <li><a href={"#" + s.id}><span class="bp-n">{s.n}</span><span class="bp-l">{s.label}</span>{s.tag && <span class="bp-t">{s.tag}</span>}</a></li>
            ))}
          </ol>
        </nav>

        <div class="ticket"><a class="ticket-cta" href="#reserve">Ask us which bird suits your household <span aria-hidden="true">→</span></a></div>

        <!-- ===================== §1 · THE BIRDS ===================== -->
        <section class="sec" id="birds">
          <h2>{available.length === 6 ? "Six" : String(available.length)} Birds Are Reservable Today — Here Is Each One</h2>
          <p class="opener">Every bird below lives here right now, and the photograph beside each name was taken in this house rather than bought from a stock library. We list what we have, which is why the grid is short; when a bird goes, the card goes with it instead of staying up to collect enquiries.</p>

          <div class="availB">
            <aside class="availB-side" aria-label="Filter the birds">
              <p class="side-h">Browse by kind</p>
              <div class="side-filters">
                <button class="side-f on" type="button" data-f="all">All birds<span class="side-n">{available.length}</span></button>
                <button class="side-f" type="button" data-f="congo">Congo<span class="side-n">{groupCount("congo")}</span></button>
                <button class="side-f" type="button" data-f="timneh">Timneh<span class="side-n">{groupCount("timneh")}</span></button>
                <button class="side-f" type="button" data-f="pair">Bonded pair<span class="side-n">{groupCount("pair")}</span></button>
              </div>
              <div class="side-ship">
                <p class="rail-ship">Ships nationwide · <b>{airport}</b> airport · <b>{home}</b> home · <b>{cabin}</b> cabin</p>
                <p class="rail-ship">Collection here is free inside a two to three hour drive.</p>
              </div>
            </aside>

            <div class="availB-grid">
              {available.map((b) => {
                const nm = shortName(b);
                const im = birdImg[b.name];
                return (
                  <article class={"bcard " + groupKey(b)} data-p={groupKey(b)}>
                    <div class="bphoto">
                      <img src={im.src} srcset={im.src.replace(".webp", "-760.webp") + " 760w, " + im.src + " 800w"} sizes="(max-width: 640px) 46vw, 260px" alt={im.alt} style={"object-position:" + im.pos} width="800" height="800" loading="lazy" decoding="async">
                      <span class={"bbadge " + groupKey(b) + (im.badge === "top" ? " badge-top" : "")}>{groupLabel(b)}</span>
                    </div>
