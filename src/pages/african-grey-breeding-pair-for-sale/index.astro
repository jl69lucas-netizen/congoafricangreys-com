        the IO callback writes directly. Verified in Playwright, not in a pane. */
  var sections = Array.prototype.slice.call(
    document.querySelectorAll('.bpair-main section[id]')
  );
  if (!sections.length) return;

  var links = Array.prototype.slice.call(
    document.querySelectorAll('.tdial-list a[data-stop], .railB a[data-stop]')
  );
  var ring = document.getElementById('ring');
  var tnum = document.getElementById('tnum');
  var total = sections.length;
  var visible = new Set();
  var current = null;

  function paint(id) {
    if (id === current) return;
    current = id;
    var idx = sections.findIndex(function (s) { return s.id === id; });
    if (idx < 0) return;

    links.forEach(function (a) {
      var on = a.getAttribute('data-stop') === id;
      a.classList.toggle('on', on);
      if (on && a.closest('.railB-track')) {
        a.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    });
    if (tnum) tnum.textContent = String(idx + 1);
    if (ring) ring.style.setProperty('--p', String(Math.round(((idx + 1) / total) * 100)));
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) visible.add(e.target); else visible.delete(e.target);
    });
    if (!visible.size) return;
    /* topmost visible section wins, not "whichever entry fired last" */
    var top = null;
    visible.forEach(function (el) {
      if (!top || el.getBoundingClientRect().top < top.getBoundingClientRect().top) top = el;
    });
    if (top) paint(top.id);
  }, { rootMargin: '-96px 0px -55% 0px', threshold: 0 });

  sections.forEach(function (s) { io.observe(s); });
})();
</script>

<style>
