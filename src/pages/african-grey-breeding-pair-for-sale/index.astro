.bpair .chk-out.ok { background:#eaf4ef; }
.bpair .chk-out.warn { background:#fbe4dd; }

/* ── FAQ-A refreshed: single column, band-numbered, clay closed-band glyph ── */
.bpair .faqA { display:grid; gap:9px; margin:1rem 0; }
.bpair .faqA-i { background:#fff; border:1px solid var(--bp-bd); border-radius:14px; padding:11px 15px; }
.bpair .faqA-i summary { cursor:pointer; font-weight:600; color:var(--bp-ink); font-size:.88rem;
  list-style:none; min-height:24px; display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:10px; align-items:baseline; }
.bpair .faqA-i summary::-webkit-details-marker { display:none; }
.bpair .faqA-band { font-variant-numeric:tabular-nums; font-size:clamp(0.79rem,1vw,0.82rem); font-weight:700;
  color:var(--bp-claytext); letter-spacing:.04em; }
.bpair .faqA-i summary::after { content:"+"; color:var(--bp-claytext); font-weight:700; }
.bpair .faqA-i[open] summary::after { content:"–"; }
.bpair .faqA-i p { font-size:.84rem; margin:.55rem 0 0; }

/* ── Rail B green ticker — mobile only. Sibling used Rail A clay chips. ── */
.bpair .railB { display:none; }

@media (max-width:980px) {
  .bpair .bpair-body { grid-template-columns:minmax(0,1fr); gap:0; }
  .bpair .tdial { display:none; }
  .bpair .phero-grid { grid-template-columns:minmax(0,1fr); max-height:none; gap:18px; }
  .bpair .phero-mosaic { grid-template-columns:repeat(3, minmax(0,1fr)); }
  .bpair .ptile-2, .bpair .ptile-3 { margin-top:0; }
  .bpair .counter-row { grid-template-columns:repeat(4, minmax(0,1fr)); }
  /* Rail B: a green ticker bar, sticky to the TOP under the header, never the bottom. */
  .bpair .railB { display:block; position:sticky; top:var(--hdr); z-index:30; background:var(--bp-green);
    margin:0 0 10px; padding:0; box-shadow:0 2px 10px rgba(20,40,30,.16); }
  .bpair .railB-track { display:flex; gap:6px; overflow-x:auto; padding:8px clamp(16px,4vw,48px);
    scrollbar-width:none; -webkit-overflow-scrolling:touch; }
  .bpair .railB-track::-webkit-scrollbar { display:none; }
  .bpair .railB a { flex:none; display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:50px;
    background:rgba(255,255,255,.13); color:#fff; text-decoration:none; font-size:clamp(0.79rem,2vw,0.82rem);
    font-weight:600; white-space:nowrap; min-height:28px; }
  .bpair .railB a.on { background:#fff; color:var(--bp-green); }
  .bpair .railB .rn { font-variant-numeric:tabular-nums; color:#c9f2db; font-weight:700; }
