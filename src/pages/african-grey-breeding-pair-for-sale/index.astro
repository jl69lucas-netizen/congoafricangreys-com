.bpair p.pcard-trust { font-size:clamp(0.79rem,1vw,0.82rem); color:#7d746a; letter-spacing:.02em; margin:1px 0 0; max-width:none; }
.bpair p.pcard-blurb { font-size:.84rem; margin:3px 0 0; line-height:1.5; max-width:none; }
.bpair p.pcard-ship { font-size:clamp(0.79rem,1vw,0.82rem); color:#7d746a; margin:8px 0 10px; padding-top:8px;
