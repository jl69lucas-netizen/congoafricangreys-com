.bpair .pcard .rcta { margin-top:auto; align-self:start; width:auto; white-space:nowrap; font-size:.82rem; padding:.55rem 1rem; }

/* ── K3 Green Ledger + K5 Capsule (unused pairing; sibling used K1 + K2) ── */
.bpair .k3 { background:#fff; border:1px solid var(--bp-bd); border-left:4px solid var(--bp-green); border-radius:14px; padding:14px 16px; margin:.9rem 0 1.1rem; }
.bpair p.k3-k { font-size:clamp(0.79rem,1vw,0.82rem); letter-spacing:.16em; text-transform:uppercase; color:var(--bp-green); font-weight:700; margin:0 0 8px; max-width:none; }
.bpair .k3-list { list-style:none; margin:0; padding:0; }
.bpair .k3-list li { display:grid; grid-template-columns:16px minmax(0,1fr); gap:9px; padding:5px 0; font-size:.86rem; color:var(--bp-mid); line-height:1.5; }
.bpair .k3-list li::before { content:"—"; color:var(--bp-clay); font-weight:700; }
.bpair .k5 { background:#eaf4ef; border-radius:50px; padding:11px 20px; margin:.9rem 0; display:inline-block; }
.bpair p.k5-t { font-size:.88rem; color:#1f4f3a; font-weight:600; margin:0; max-width:none; }

/* ── Table H "Production Record" — NEW letter. F is double-booked in the cluster. ── */
.bpair .tH-wrap { overflow-x:auto; margin:1rem 0; }
.bpair .tH { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--bp-bd); border-radius:14px; overflow:hidden; font-size:.84rem; }
.bpair .tH caption { caption-side:top; text-align:left; background:var(--bp-green); color:#fff; padding:8px 14px;
  font-size:clamp(0.79rem,1vw,0.82rem); letter-spacing:.1em; text-transform:uppercase; }
.bpair .tH th, .bpair .tH td { padding:10px 13px; border-bottom:1px solid var(--bp-bd); text-align:left; vertical-align:top; color:var(--bp-mid); }
.bpair .tH thead th { background:#f6efe8; color:var(--bp-ink); font-size:clamp(0.79rem,1vw,0.82rem); letter-spacing:.05em; text-transform:uppercase; }
.bpair .tH tbody th { color:var(--bp-ink); font-weight:700; }
.bpair .tH tbody tr:first-child th { box-shadow:inset 3px 0 0 var(--bp-clay); }
.bpair .tH .num { font-variant-numeric:tabular-nums; }

/* ── §15 the checklist tool ── */
.bpair .chk { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; padding:16px 18px; margin:1.1rem 0; box-shadow:0 2px 12px rgba(60,30,10,.05); }
.bpair p.chk-k { font-size:clamp(0.79rem,1vw,0.82rem); letter-spacing:.16em; text-transform:uppercase; color:var(--bp-green); font-weight:700; margin:0 0 4px; max-width:none; }
.bpair p.chk-sub { font-size:.84rem; color:var(--bp-mid); margin:0; max-width:none; }
.bpair .chk-list { list-style:none; margin:.6rem 0 0; padding:0; display:grid; gap:2px; }
.bpair .chk-list li { margin:0; }
.bpair .chk-list label { display:grid; grid-template-columns:22px minmax(0,1fr); gap:10px; align-items:start;
  padding:9px 8px; border-radius:10px; cursor:pointer; font-size:.86rem; color:var(--bp-ink); line-height:1.45; min-height:24px; }
.bpair .chk-list label:hover { background:#f6efe8; }
.bpair .chk-list input { width:18px; height:18px; margin:2px 0 0; accent-color:var(--bp-green); cursor:pointer; }
/* Reserved box — the verdict band swaps text, and without a floor it reflows the page (CLS). */
.bpair .chk-out { margin-top:12px; padding:12px 14px; border-radius:12px; background:#f6efe8;
  min-height:76px; display:flex; flex-direction:column; justify-content:center; }
.bpair p.chk-score { font-family:var(--font-lora, Georgia, serif); font-size:1.15rem; color:var(--bp-ink); margin:0 0 2px; max-width:none; }
