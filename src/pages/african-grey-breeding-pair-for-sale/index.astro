/* One Product + Offer per real pair. AggregateOffer belongs on group and hub pages; this
   page sells three discrete, individually-priced pairs, so it ships three Product nodes. */

/* FAQPage — extracted from the rendered <details> blocks in §18 so the schema and the
   visible answers can never drift apart. Regenerate if the FAQ copy changes. */
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      "@type": "Question",
      "name": "How do I know a pair is really proven?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ask for the clutch record and the band numbers, and ask before you pay. A proven pair has dates behind it — when the hen went down, how many eggs, how many hatched, how many fledged. Talker and Jane have four clutches recorded, Lake and Mari two, Odin and Sally one. If a seller answers that question with adjectives instead of dates, you are looking at a bonded pair at best and two housemates at worst."
      }
    },
    {
      "@type": "Question",
      "name": "How old are greys before they'll actually breed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It varies more than people expect, and we will not hand you a threshold number as if it were a rule. Our six range from Sally at four to Talker at twelve, and every one has been part of a recorded clutch. Some pairs go down early, some take years longer, and a few well-matched greys never take an interest. Age is one input; setup, diet and how well the two birds get along matter as much."
      }
    },
    {
      "@type": "Question",
      "name": "Are the pair birds tame? Can I handle them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, and you should not plan on it. These are aviary birds bonded to each other, not hand-raised companions bonded to people. They tolerate us at feeding and inspection, and that is the extent of it. A cock guarding a box will absolutely come at your hand. If you want a grey who steps up and talks, buy one of our hand-raised singles instead — that is a completely different bird raised on a completely different routine."
      }
    },
    {
      "@type": "Question",
      "name": "What if they stop laying after the move?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Expect a pause. A pair that has just flown across the country and been rehoused will usually go quiet for weeks or months before either bird looks at the box again, and that is normal behavior rather than a defect. Get the flight right, hold temperature and humidity in range, feed them well and leave them alone. We do not guarantee production — nobody honestly can — but we will talk through your setup with you for as long as it takes."
      }
    },
    {
      "@type": "Question",
      "name": "Why don't these pairs come with a DNA certificate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because we never sent samples to a lab for them. We know the sexes from years of watching these birds breed, and each has produced with us. A certificate confirms which bird is the hen; it says nothing about whether the pair functions. Run your own test after arrival if you want the document — any avian lab will take the sample."
      }
    },
    {
      "@type": "Question",
      "name": "What size nest box do I need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Twelve by twelve by twenty-four inches, vertical, mounted on the outside of the flight. Depth is the part people cut, and it is the part that matters — a grey hen wants a dark bottom to settle into, not a shallow shelf. Outside mounting keeps your floor space and lets you inspect through a hatch instead of reaching past a defensive cock. A few inches of pine shavings, and then leave it alone."
      }
    },
    {
      "@type": "Question",
      "name": "Can I buy just the hen, or just the cock?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Each pair sells as a pair, and we do not split them for any price. These birds are bonded to each other and their value is entirely in that bond — a proven hen sold alone is just a hen, and the cock left behind loses a partner he has already produced with. Splitting a working pair to close two sales instead of one is exactly the kind of thing we started this aviary to avoid doing."
      }
    },
    {
      "@type": "Question",
      "name": "How does shipping work, and do they fly together?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two crates, same flight, never one crate for the two of them. We ship cargo on Delta, United and American under IATA Live Animals Regulations, and both crates arrive on the same aircraft. Airport cargo is $185 for the pair, home delivery is $350 for the pair, and pickup in Midland is free if you are within two or three hours of us. Documentation travels with the crates, not separately."
      }
    },
    {
      "@type": "Question",
      "name": "What does the 72-hour guarantee actually cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our guarantee is written as 72 hours from arrival — not three days, and the wording matters because it is measured from the moment you take possession. If a bird arrives in trouble, you call us inside that window and we deal with it. Have an avian vet lined up before the crates land rather than after, and get both birds looked at during the window. That is the single most useful thing a new pair owner can do."
      }
    }
  ],
};

const productSchemas = pairs.map((p) => ({
  '@type': 'Product',
  name: `${p.name} — Proven African Grey Breeding Pair`,
  image: [`https://congoafricangreys.com${p.img}.webp`],
