     dead space beside it — the defect the breeder screenshotted 2026-08-07. */
  .bpair .tH, .bpair .tH caption, .bpair .tH thead, .bpair .tH tbody, .bpair .tH th, .bpair .tH td, .bpair .tH tr { display:block; }
  /* Uppercase + .1em tracking is a desktop label style; at 375px it forces one word
     per line. Sentence case, normal tracking, full width, horizontal. */
  .bpair .tH caption { width:auto; padding:11px 14px; text-align:left;
    text-transform:none; letter-spacing:0; font-size:clamp(0.86rem, 3.4vw, 0.95rem);
    line-height:1.35; font-weight:700; border-radius:14px 14px 0 0; }
  .bpair .tH caption em { font-style:italic; }
  .bpair .tH thead { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  .bpair .tH tbody tr { border:1px solid var(--bp-bd); border-radius:14px; margin:0 0 10px; padding:4px 0; background:#fff; }
  .bpair .tH tbody th { box-shadow:none !important; border-bottom:1px dashed var(--bp-bd); }
  .bpair .tH td { border-bottom:1px dashed var(--bp-bd); display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:10px; }
  .bpair .tH td:last-child { border-bottom:0; }
  .bpair .tH td::before { content:attr(data-label); font-weight:700; color:var(--bp-ink);
    font-size:clamp(0.79rem,1vw,0.82rem); text-transform:uppercase; letter-spacing:.04em; }
  .bpair .fs-form { grid-template-columns:minmax(0,1fr); }
  .bpair .faqA-i summary { grid-template-columns:auto minmax(0,1fr); }
  .bpair .faqA-i summary::after { grid-column:2; justify-self:end; margin-top:-1.3em; }}

</style>
