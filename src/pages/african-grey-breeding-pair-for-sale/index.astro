/* ── §1 Hero-C "Production Ledger": three pair tiles + a ledger strip ──
   Hero-A's overlapping absolute inset is deliberately NOT used — the sibling
   refreshed Hero-A into "Bonded Duo" and reusing it would read as the same page. */
.bpair .phero-grid { grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr); min-height:350px; max-height:430px; }
.bpair .phero-ledger { display:flex; flex-wrap:wrap; gap:6px 18px; list-style:none; padding:0; margin:.2rem 0 0; }
.bpair .phero-ledger li { font-size:clamp(0.79rem,2vw,0.84rem); color:var(--bp-mid); font-weight:600; }
.bpair .phero-ledger b { font-family:var(--font-lora, Georgia, serif); font-weight:400; font-size:1.15rem; color:var(--bp-green); margin-right:3px; }

/* Three equal tiles in a row — no absolute positioning anywhere, so there is
   nothing to unwind at mobile (the trap that collapsed Hero-A's inset). */
.bpair .phero-mosaic { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:8px; align-content:center; }
.bpair .ptile { position:relative; margin:0; border-radius:14px; overflow:hidden; border:1px solid var(--bp-bd); background:#fff; box-shadow:0 3px 14px rgba(60,30,10,.07); }
/* 4:3 on a DEDICATED tile master, not the 16:9 in-body master. The three sources measure
   1.00 / 1.33 / 1.32, so a 4:3 box fits them with almost no filler. Cropping the in-body
   masters (blurfill --mobcrop 4:5) to a portrait tile showed their blurred filler instead
   of the birds — Sally & Odin read as an out-of-focus photo. Measured, not guessed. */
.bpair .ptile img { width:100%; height:auto; aspect-ratio:4/3; object-fit:cover; display:block; }
.bpair .ptile-2 { margin-top:14px; }
.bpair .ptile-3 { margin-top:28px; }
/* Clutch chip: the same near-transparent treatment as .rbadge — text on a scrim,
   no pill, so it can never sit as an opaque block over a head or a beak. */
.bpair .ptile::after { content:""; position:absolute; inset:auto 0 0 0; height:54px; pointer-events:none;
  background:linear-gradient(to top, rgba(24,32,27,.66), rgba(24,32,27,.15) 58%, rgba(24,32,27,0)); }
.bpair .ptile-chip { position:absolute; left:9px; bottom:6px; z-index:1;
  color:rgba(255,255,255,.9); font-size:clamp(0.79rem,1vw,0.82rem); font-weight:700; letter-spacing:.06em;
  text-shadow:0 1px 4px rgba(20,14,10,.75); }

/* Counter strip runs 8 here, not 6. */
.bpair .counter-row { grid-template-columns:repeat(8, minmax(0,1fr)); }
.bpair .cs .num { font-size:1.25rem; }

/* ── Dial 1 Clay — light card, clay ring. Sibling used Dial 2 dark-aviary. ── */
.bpair .tdial { background:#fff; border:1px solid var(--bp-bd); }
.bpair .tdial-ring { background:conic-gradient(var(--bp-clay) calc(var(--p,0) * 1%), #f0e6dc 0); }
.bpair .tdial-inner { background:#fff; }
.bpair .tnum { color:var(--bp-ink); }
.bpair .tof { color:var(--bp-mid); }
.bpair p.tdial-k { color:var(--bp-mid); }
.bpair .tdial-list { border-top:1px dashed var(--bp-bd); }
.bpair .tdial-list a { color:var(--bp-mid); }
.bpair .tdial-list a:hover, .bpair .tdial-list a.on { background:#f3ece4; }
/* The existing `.bpair .ti { color:#9a8f83 }` two lines down is ALREADY a light-theme
   override, not the dark-theme #7ba98d leaking through — but #9a8f83 on white is only
   3.17:1, still short of AA 4.5:1, the 10 Lighthouse contrast failures of 2026-08-07.
   #5d7d6a is 4.56:1 on #fff. Verified arithmetically, not eyeballed. */
.bpair .tdial-list a .ti { color:#5d7d6a; }
.bpair .tdial-list a.on .ti { color:var(--bp-clay); }
.bpair .tdial-list a.on .tt { color:var(--bp-ink); }
.bpair .ti { color:#9a8f83; }
.bpair .tt { color:var(--bp-ink); }

/* ── §2 pair cards — 3-up, equal heights, one fact per line ── */
.bpair .pair-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:16px; margin:1.1rem 0 .6rem; align-items:stretch; }
.bpair .pcard { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; overflow:hidden;
  box-shadow:0 2px 12px rgba(60,30,10,.05); display:flex; flex-direction:column;
  scroll-margin-top:calc(var(--hdr) + 16px);
  transition:transform .15s cubic-bezier(.4,0,.2,1), box-shadow .15s cubic-bezier(.4,0,.2,1); }
.bpair .pcard:hover { transform:translateY(-2px); box-shadow:0 6px 22px rgba(60,30,10,.09); }
.bpair .pcard-photo { position:relative; }
.bpair .pcard-photo img { width:100%; aspect-ratio:4/3; height:auto; object-fit:cover; display:block; }
.bpair .pcard-photo::after { content:""; position:absolute; inset:auto 0 0 0; height:72px; pointer-events:none;
  background:linear-gradient(to top, rgba(24,32,27,.62), rgba(24,32,27,.14) 55%, rgba(24,32,27,0)); }
.bpair .pcard-body { padding:13px 15px 15px; display:flex; flex-direction:column; gap:4px; flex:1; }
.bpair .pcard-name { font-family:var(--font-lora, Georgia, serif); font-size:1.06rem; line-height:1.22; margin:0 0 1px; color:var(--bp-ink); }
