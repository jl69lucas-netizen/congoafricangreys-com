---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'Proven African Grey Breeding Pairs for Sale | Three Bonded Pairs, Seven Clutches on Record, From $3,000 | Closed-Banded, CITES Appendix I Captive-Bred | C.A.Gs — Midland, Texas Aviary Since 2014';
const description = 'Three proven African Grey breeding pairs for sale from our Midland, Texas aviary — Talker & Jane, Mari & Lake, Sally & Odin, from $3,000. Every pair is closed-banded with its clutch record on request, hand-reared and still tame, and ships in two crates. See what each pair has produced.';
const canonical = 'https://congoafricangreys.com/african-grey-breeding-pair-for-sale/';

const IMG = '/images/breeding-pair';

/* Live from data/price-matrix.json. Ages, clutch counts and prices are the breeder's own
   record — none is estimated, and the clutch total (7) is 4 + 2 + 1, not a rounded claim. */
const pairs = [
  {
    id: 'talker-jane',
    name: 'Talker & Jane',
    cock: 'Talker', hen: 'Jane',
    ages: 'Twelve and ten years old',
    clutches: 4,
    price: 3000,
    tier: 'Most Proven',
    img: `${IMG}/talker-jane-proven-african-grey-breeding-pair`,
    alt: 'Talker and Jane, the twelve and ten year old proven pair from C.A.Gs, perched on an aviary branch',
    blurb: 'Our longest-producing pair, and the one we point first-time breeding buyers toward. Four clutches hatched and reared here, with the dates available before you pay.',
    sub: 'Four clutches hatched · closed-banded',
  },
  {
    id: 'mari-lake',
    name: 'Mari & Lake',
    cock: 'Lake', hen: 'Mari',
    ages: 'Six and seven years old',
    clutches: 2,
    price: 4500,
    tier: 'Mid Ladder',
    img: `${IMG}/mari-lake-african-grey-breeding-pair-two-clutches`,
    alt: 'Mari and Lake, a bonded Congo grey cock and hen with two hatched clutches on record',
    blurb: 'Two hatched clutches settles the question a single clutch leaves open, and this pair still has most of its productive years in front of it.',
    sub: 'Two clutches hatched · closed-banded',
  },
  {
    id: 'sally-odin',
    name: 'Sally & Odin',
    cock: 'Odin', hen: 'Sally',
    ages: 'Four and five years old',
    clutches: 1,
    price: 5500,
    tier: 'Most Years Ahead',
    img: `${IMG}/sally-odin-youngest-proven-african-grey-pair`,
    alt: 'Sally and Odin, the youngest proven Congo grey pair we have placed, four and five years old',
    blurb: 'The youngest pair we have ever placed as proven. Sally sits at the early end of the breeding range, and we would rather say that plainly than let you find it out later.',
    sub: 'One clutch hatched · closed-banded',
  },
];

const counters = [
  { n: '3', l: 'Proven Pairs' },
  { n: '7', l: 'Clutches Hatched' },
  { n: '100%', l: 'Closed-Banded' },
  { n: '12', l: 'Yrs Aviary' },
  { n: '2', l: 'Crates Always' },
  { n: '$3,000', l: 'Floor Price' },
  { n: '0', l: 'Wild-Caught' },
  { n: '24h', l: 'Reply' },
];

/* T2 chip cloud, refreshed: every chip is one criterion from the proven standard, so the
   contents list teaches the standard before the reader reaches the checklist tool at §15. */
const stops = [
  { id: 'pairs',     n: 1,  t: 'The Three Pairs' },
  { id: 'proven',    n: 2,  t: 'What "Proven" Means' },
  { id: 'ladder',    n: 3,  t: 'Why Fewest Costs Most' },
  { id: 'age',       n: 4,  t: 'Breeding Age' },
  { id: 'record',    n: 5,  t: 'Production Record' },
  { id: 'tame',      n: 6,  t: 'Still Tame' },
  { id: 'moving',    n: 7,  t: 'Moving a Pair' },
  { id: 'pairing',   n: 8,  t: 'Pairing Method' },
  { id: 'market',    n: 9,  t: 'Cost Elsewhere' },
  { id: 'housing',   n: 10, t: 'Housing & Nest Box' },
  { id: 'paperwork', n: 11, t: 'Paperwork' },
  { id: 'travel',    n: 12, t: 'How a Pair Travels' },
  { id: 'singles',   n: 13, t: 'Singles & Eggs' },
  { id: 'checklist', n: 14, t: 'Six Questions' },
  { id: 'reviews',   n: 15, t: 'Breeder Reviews' },
  { id: 'reading',   n: 16, t: 'Keep Reading' },
  { id: 'faq',       n: 17, t: 'Questions We Get' },
  { id: 'reserve',   n: 18, t: 'Reserve a Pair' },
];

/* One Product + Offer per real pair. AggregateOffer belongs on group and hub pages; this
   page sells three discrete, individually-priced pairs, so it ships three Product nodes. */
const productSchemas = pairs.map((p) => ({
  '@type': 'Product',
  name: `${p.name} — Proven African Grey Breeding Pair`,
  image: [`https://congoafricangreys.com${p.img}.webp`],
  description: `${p.name}, a proven Congo African Grey breeding pair. ${p.ages}, ${p.clutches} ${p.clutches === 1 ? 'clutch' : 'clutches'} hatched and reared at our Midland, Texas aviary. Both birds closed-banded, CITES Appendix I captive-bred, clutch record on request.`,
  brand: { '@type': 'Brand', name: 'C.A.Gs – Midland, TX' },
  offers: {
    '@type': 'Offer',
    price: String(p.price),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: canonical,
    seller: { '@type': 'Organization', name: 'C.A.Gs – Midland, TX' },
  },
}));
---

<BaseLayout {title} {description} {canonical} hideGlobalCta>
  <div class="bpair">
    <div class="container">
      <Breadcrumb items={[
        { name: 'Home', url: '/' },
        { name: 'African Greys for Sale', url: '/african-grey-parrots-for-sale/' },
        { name: 'African Grey Breeding Pair for Sale', url: '/african-grey-breeding-pair-for-sale/' }
      ]} />
    </div>

    <!-- ══ §1 · HERO-C refreshed "Production Ledger" ══
         Delta against dna-tested's Hero-C: the stats strip becomes a production ledger and
         the single-bird mosaic becomes three pair tiles, each carrying its clutch chip.
         Palette is unchanged — a refresh moves arrangement, never brand colour. -->
    <header class="phero">
      <div class="container phero-grid">
        <div class="phero-copy">
          <p class="eyebrow">Midland, Texas Aviary · Producing Since 2014</p>
          <h1 class="cag-h1">Proven African Grey Breeding Pairs for Sale — Three Bonded Pairs, Every Clutch on Record, From $3,000</h1>
          <p class="lead">Three bonded pairs are available right now, and each one has hatched and reared a clutch in our aviary. We publish what each pair has produced, in writing, before you send a deposit — because "proven" is a word most listings use and few will document.</p>
          <p class="phero-cta">
            <a href="#reserve" class="btn-clay">Reserve a proven pair</a>
            <a href="#record" class="btn-ghost">See what each pair has produced</a>
          </p>
          <ul class="phero-ledger">
            <li><b>3</b> pairs</li>
            <li><b>7</b> clutches hatched</li>
            <li><b>12</b> yrs aviary</li>
          </ul>
        </div>

        <div class="phero-mosaic">
          {pairs.map((p, i) => (
            <figure class={`ptile ptile-${i + 1}`}>
              <img
                src={`${p.img}.webp`}
                srcset={`${p.img}-760.webp 760w, ${p.img}.webp 1408w`}
                sizes="(max-width:980px) 33vw, 190px"
                alt={p.alt}
                width="1408" height="768"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
              />
              <figcaption class="ptile-chip">{p.clutches} {p.clutches === 1 ? 'clutch' : 'clutches'}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </header>

    <!-- ══ Counter strip — 8 snippets, every figure Ledger-verified ══ -->
    <div class="counter-wrap">
      <div class="container counter-row">
        {counters.map((c) => (
          <div class="cs"><span class="num">{c.n}</span><span class="cs-l">{c.l}</span></div>
        ))}
      </div>
    </div>

    <div class="container bpair-body">

      <!-- ══ T2 Chip Cloud refreshed → "Standard Checklist" rail ══ -->
      <nav class="tdial" aria-label="On this page">
        <div class="tdial-ring" id="ring"><div class="tdial-inner"><span class="tnum" id="tnum">1</span><span class="tof">of 18</span></div></div>
        <p class="tdial-k">The Standard</p>
        <ul class="tdial-list">
          {stops.map((s) => (
            <li><a href={`#${s.id}`} data-stop={s.id}><span class="ti">{s.n}</span><span class="tt">{s.t}</span></a></li>
          ))}
        </ul>
      </nav>

      <main class="bpair-main">

        <!-- ══ §2 · The three pairs ══ -->
        <section id="pairs">
          <h2 class="cag-h2">Which Proven African Grey Breeding Pairs Can You Reserve Right Now?</h2>
          <p class="lead">Three pairs are on the ground here today, and all three have already done the thing that makes a pair worth buying — they have hatched a clutch and raised it. Below is each pair, what it has produced, and what it costs, in the order we would recommend them to a breeder starting out.</p>

          <p class="bluf">A proven pair has hatched a fertile clutch. All three of ours have. Talker &amp; Jane have four clutches behind them at $3,000, Mari &amp; Lake two at $4,500, and Sally &amp; Odin one at $5,500 — the price rises as the clutch count falls, because you are buying the breeding years ahead rather than the ones already spent.</p>

          <div class="pair-grid">
            {pairs.map((p) => (
              <article class="pcard" id={p.id}>
                <div class="pcard-photo">
                  <img
                    src={`${p.img}.webp`}
                    srcset={`${p.img}-760.webp 760w, ${p.img}.webp 1408w`}
                    sizes="(max-width:640px) 92vw, (max-width:980px) 46vw, 300px"
                    alt={p.alt}
                    width="1408" height="768"
                    loading="lazy" decoding="async"
                  />
                  <span class="rbadge">{p.tier}</span>
                </div>
                <div class="pcard-body">
                  <h3 class="cag-h3 pcard-name">{p.name}</h3>
                  <p class="pcard-price">${p.price.toLocaleString()}<span class="pcard-split">{p.ages}</span></p>
                  <p class="pcard-sub">{p.sub}</p>
                  <p class="pcard-trust">CITES Appendix I · captive-bred · clutch record on request</p>
                  <p class="pcard-blurb">{p.blurb}</p>
                  <p class="pcard-ship">Ships nationwide · $185 airport · $350 home</p>
                  <a href="#reserve" class="btn-clay rcta">Ask for the clutch record</a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- SECTIONS_3_TO_19 -->

      </main>
    </div>
  </div>

  {productSchemas.map((s) => <Schema type="product" data={s} />)}
  <Schema type="organization" />
</BaseLayout>

<style>
:root { --bp-ink:#1c1a18; --bp-mid:#5a5248; --bp-bd:#ede5dc; --bp-green:#2D6A4F; --bp-clay:#e8604c; --bp-clayink:#c8472f; --bp-claytext:#b04228; --bp-cream:#faf7f4; }
/* THE root cause of "jump links on mobile not working". A global `scroll-behavior:smooth`
   applies to this 31,000px page, so one rail tap starts a multi-second crawl through
   ~9,000px that any thumb-touch cancels. Measured: click a chip, wait 1.2s, scrollY is
   still 25. The for-sale cluster spec requires `scroll-behavior:auto` on pages carrying a
   jump rail (cag-for-sale-page-builder §5, memory reference_smooth_scroll_kills_jump_links).
   Scoped with :has() so no sibling page loses its smooth scrolling. */
:global(html:has(.bpair)) { scroll-behavior:auto; }

/* The site header measures 96px, not the 72px this page had been assuming. At 72 the
   sticky rail parked 24px behind the header and every jump link landed underneath both.
   Measured in Playwright: body>header rect h=96, .railA h=52. (page-hardening §1b) */
.bpair { --hdr:96px; --rail-h:52px; background:var(--bp-cream); color:var(--bp-ink); overflow-x:clip; }
.bpair .container { max-width:1200px; margin:0 auto; padding:0 clamp(16px, 4vw, 48px); }
.bpair p { max-width:70ch; color:var(--bp-mid); line-height:1.65; }
.bpair .lead { color:var(--bp-ink); font-size:clamp(0.98rem, 1.6vw, 1.08rem); }
.bpair .note { font-size:.92rem; }

/* ── Hero-A "Bonded Duo" ── */
.phero { padding:clamp(20px, 3vw, 30px) 0 clamp(18px, 2.6vw, 26px); }
.hero-duo .phero-grid { align-items:center; }
.phero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); gap:clamp(20px, 3vw, 40px); align-items:center; min-height:350px; max-height:420px; }
.phero .eyebrow { font-size:var(--fs-micro); letter-spacing:.14em; color:var(--bp-claytext); font-weight:600; margin:0 0 .5rem; }
.phero .cag-h1 { font-size:clamp(1.35rem, 2.6vw, 1.95rem); line-height:1.14; margin:0 0 .6rem; color:var(--bp-ink); }
.phero .lead { font-size:.88rem; margin:0 0 1rem; }
.phero-cta { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:.85rem; }
.phero-ribbon { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:6px; list-style:none; padding:0; margin:0; }
.phero-ribbon li { font-size:var(--fs-micro); color:var(--bp-green); background:#eaf4ef; border-radius:50px; padding:5px 9px; text-align:center; font-weight:600; }
/* Bonded Duo: one anchor photo + one overlapping inset. Absolute positioning is
   UNWOUND below 980px (trap #1 — an un-unwound absolute hero collapses on mobile). */
.phero-duo { position:relative; padding-bottom:26px; padding-right:10px; }
.phero-duo figure { margin:0; border-radius:16px; overflow:hidden; border:1px solid var(--bp-bd); box-shadow:0 3px 14px rgba(60,30,10,.07); background:#fff; }
.phero-duo img { width:100%; height:auto; object-fit:cover; display:block; aspect-ratio:16/10; }
.duo-a { transform:rotate(-1deg); }
.duo-b { position:absolute; right:-18px; bottom:-16px; width:36%; transform:rotate(2.5deg); box-shadow:0 6px 20px rgba(60,30,10,.18) !important; }

/* ── Counter strip, 6 cards, CLS-safe ── */
.counter-wrap { padding:6px 0 18px; }
.counter-row { display:grid; grid-template-columns:repeat(6, minmax(0,1fr)); gap:10px; }
.cs { min-height:74px; padding:10px 13px; border-radius:12px; background:#fff; border:1px solid var(--bp-bd); display:flex; flex-direction:column; justify-content:center; }
.cs .num { font-family:var(--font-lora, Georgia, serif); font-size:1.35rem; color:var(--bp-claytext); line-height:1.1; }
.cs-l { font-size:var(--fs-micro); color:var(--bp-mid); letter-spacing:.03em; }

/* ── Body grid + Dial 2 Dark-Aviary ── */
.bpair-body { display:grid; grid-template-columns:196px minmax(0,1fr); gap:28px; padding-bottom:56px; }
.bpair-main { min-width:0; }
.bpair-main section { scroll-margin-top:calc(var(--hdr) + 16px); padding:6px 0 4px; }
.tdial { position:sticky; top:calc(var(--hdr) + 16px); align-self:start; background:#20342b; border-radius:16px; padding:12px 10px; box-shadow:0 3px 12px rgba(60,30,10,.05); max-height:calc(100vh - var(--hdr) - 32px); overflow-y:auto; scrollbar-width:thin; }
.tdial-ring { width:64px; height:64px; margin:2px auto 8px; border-radius:50%; background:conic-gradient(var(--bp-clay) calc(var(--p,0) * 1%), #33503f 0); display:grid; place-items:center; }
.tdial-inner { width:50px; height:50px; border-radius:50%; background:#20342b; display:grid; place-items:center; line-height:1; }
.tnum { font-family:var(--font-lora, Georgia, serif); font-size:15px; color:#fff; }
.tof { font-size:var(--fs-micro); color:#9fc7b0; }
.tdial-k { font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; color:#9fc7b0; text-align:center; margin:0 0 6px; }
.tdial-list { list-style:none; margin:0; padding:7px 0 0; border-top:1px dashed #3b5a49; }
/* One line per stop, numeral in its own column so every title starts on the same x.
   The per-row category tag this used to carry ("Behaviour", "Money", "Proof" …) is gone:
   at 18 stops it was the difference between a list that fits and a list that scrolls,
   and it repeated the same six words down the rail without helping anyone choose. */
.tdial-list a { display:grid; grid-template-columns:15px minmax(0,1fr); gap:7px; align-items:center;
  font-size:var(--fs-micro); line-height:1.26; padding:3px 7px 3px 6px; border-radius:8px; text-decoration:none;
  color:#dcefe4; transition:background .15s cubic-bezier(.4,0,.2,1), color .15s cubic-bezier(.4,0,.2,1); min-height:24px; }
.tdial-list a:hover, .tdial-list a.on { background:#2b4438; }
.tdial-list a.on .ti { color:var(--bp-clay); }
.tdial-list a.on .tt { color:#fff; }
.ti { font-variant-numeric:tabular-nums; color:#7ba98d; font-size:var(--fs-micro); text-align:right; }
.tt { color:#eaf4ee; text-wrap:balance; }

/* ── Rail A, sticky TOP never bottom ── */
.railA { display:none; }
.railA .rn { font-variant-numeric:tabular-nums; font-weight:700; color:var(--bp-claytext); margin-right:6px; font-size:var(--fs-micro); }
.railA a.on { background:var(--bp-green); color:#fff; }
.railA a.on .rn { color:#c9f2db; }

/* ── Headings ── */
.cag-h2 { font-size:clamp(1.25rem, 3.5vw, 2rem); line-height:1.18; color:var(--bp-green); margin:1.6rem 0 .5rem; padding-left:14px; border-left:0; position:relative; text-wrap:pretty; }
.cag-h2::before { content:""; position:absolute; left:0; top:.18em; bottom:.18em; width:4px; border-radius:2px; background:var(--bp-clay); }
/* A section opening right under a seam does not need the full stacked gutter as well. */
.bpair-main section > .cag-h2:first-child { margin-top:.5rem; }
.cag-h3, .cag-h4 { text-wrap:pretty; }
.cag-h3 { font-size:clamp(1.0625rem, 2.2vw, 1.5rem); line-height:1.25; color:var(--bp-ink); margin:1.2rem 0 .35rem; }
.cag-h4 { font-size:clamp(.9375rem, 1.8vw, 1.25rem); line-height:1.3; color:var(--bp-ink); margin:1rem 0 .3rem; }
.cag-h5 { font-size:clamp(0.79rem,1.1vw,.875rem); line-height:1.3; color:var(--bp-green); margin:.9rem 0 .25rem; text-transform:none; font-weight:700; }
.cag-h6 { font-size:clamp(0.79rem,1.1vw,.875rem); line-height:1.3; color:var(--bp-mid); margin:.8rem 0 .2rem; font-weight:700; }
.h6k { color:var(--bp-claytext); }

/* ── Buttons ── */
.btn-clay { display:inline-block; background:var(--bp-clayink); color:#fff; font-weight:700; padding:.7rem 1.25rem; border-radius:50px; text-decoration:none; font-size:.86rem; border:0; cursor:pointer; transition:background .2s; }
.btn-clay:hover { background:#b03d26; }
.btn-ghost { display:inline-block; border:2px solid var(--bp-clayink); color:var(--bp-claytext); font-weight:700; padding:.62rem 1.15rem; border-radius:50px; text-decoration:none; font-size:.86rem; transition:background .2s, color .2s; }
.btn-ghost:hover { background:var(--bp-clayink); color:#fff; }
.bfull { width:100%; text-align:center; }
.ctaline { margin:1.4rem 0 .4rem; }

/* ── Avail-B by route ── */
.availB { display:grid; grid-template-columns:200px minmax(0,1fr); gap:20px; margin:1rem 0 .6rem; }
.availB-rail { position:sticky; top:calc(var(--hdr) + 16px); align-self:start; }
.availB-k { font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:var(--bp-mid); margin:0 0 6px; }
.facet { display:block; width:100%; text-align:left; background:#fff; border:1px solid var(--bp-bd); border-radius:10px; padding:7px 10px; font-size:var(--fs-micro); color:var(--bp-ink); margin-bottom:5px; cursor:pointer; min-height:32px; }
.facet.on { background:var(--bp-green); color:#fff; border-color:var(--bp-green); }
.availB-ship { font-size:var(--fs-micro); color:var(--bp-mid); margin-top:10px; }
.availB-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(210px, 1fr)); gap:14px; }
.rcard { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; overflow:hidden; box-shadow:0 2px 12px rgba(60,30,10,.05); display:flex; flex-direction:column; transition:transform .15s cubic-bezier(.4,0,.2,1), box-shadow .15s cubic-bezier(.4,0,.2,1); }
.rcard:hover { transform:translateY(-2px); box-shadow:0 6px 22px rgba(60,30,10,.09); }
.rcard.hide { display:none; }
/* 4:3, never a fixed pixel height with a guessed object-position — the masters are
   blurfill-framed so the whole bird is inside the frame at every width. */
.rcard-photo { position:relative; }
.rcard-photo img { width:100%; aspect-ratio:4/3; height:auto; object-fit:cover; display:block; }
.rcard-photo::after { content:""; position:absolute; inset:auto 0 0 0; height:72px; pointer-events:none;
  background:linear-gradient(to top, rgba(24,32,27,.62), rgba(24,32,27,.14) 55%, rgba(24,32,27,0)); }
/* The route label is a quiet caption ON the photo, not a second button competing with the
   name and the price. The opaque white pill it used to be was the loudest object on the
   card; the filter rail already says the same word. Sits on the scrim above, so it stays
   readable while reading as almost-transparent. */
.rbadge { position:absolute; left:13px; bottom:9px; z-index:1; background:none; padding:0; border-radius:0;
  color:rgba(255,255,255,.88); font-size:var(--fs-micro); font-weight:600; letter-spacing:.09em; text-transform:uppercase;
  text-shadow:0 1px 4px rgba(20,14,10,.7); }
/* One fact per line, top to bottom: name → price → what you get → proof → description →
   shipping → action. Nothing shares a row, at any width. */
.rcard-body { padding:13px 14px 15px; display:flex; flex-direction:column; gap:4px; flex:1; }
.rcard-name { font-family:var(--font-lora, Georgia, serif); font-size:1.06rem; line-height:1.22; margin:0 0 1px; color:var(--bp-ink); }
.bpair p.rcard-price { color:var(--bp-claytext); font-weight:700; font-size:1rem; line-height:1.25; margin:0; }
.rcard-split { display:block; font-size:var(--fs-micro); font-weight:600; color:var(--bp-mid); letter-spacing:0; margin-top:1px; }
.bpair p.rcard-sub { font-size:var(--fs-micro); color:var(--bp-green); margin:0; font-weight:600; line-height:1.35; }
.bpair p.rcard-trust { font-size:var(--fs-micro); color:#7d746a; letter-spacing:.02em; margin:1px 0 0; }
.bpair p.rcard-blurb { font-size:.82rem; margin:3px 0 0; line-height:1.5; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.bpair p.rcard-ship { font-size:var(--fs-micro); color:#7d746a; margin:7px 0 9px; padding-top:7px; border-top:1px dashed var(--bp-bd); line-height:1.4; }
/* hugs its label on desktop, one line always, shared baseline via margin-top:auto */
.rcard .rcta { margin-top:auto; align-self:start; width:auto; white-space:nowrap; font-size:.82rem; padding:.55rem 1rem; }

/* ── K1 receipt + K2 price tag ── */
.k1 { background:#fff; border:1px solid var(--bp-bd); border-radius:16px; overflow:hidden; margin:.8rem 0; }
.k1-h { background:var(--bp-green); color:#fff; margin:0; padding:8px 14px; font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; }
.k1-list { margin:0; padding:10px 14px 14px; }
.k1-list > div { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr); gap:10px; padding:7px 0; border-bottom:1px dashed var(--bp-bd); }
.k1-list > div:last-child { border-bottom:0; }
.k1-list dt { font-weight:700; color:var(--bp-ink); font-size:.84rem; }
.k1-list dd { margin:0; color:var(--bp-mid); font-size:.84rem; }
/* The note gets its own row under the figure. Sharing a baseline row with a 1.6rem serif
   price left it wrapping mid-block with a ragged left edge at desktop width.
   Grid, not `flex:1 0 100%` — flex line-breaking measures the item's hypothetical size
   AFTER max-width clamping, so the note's own `max-width:52ch` shrank it back to 538px,
   it fitted beside the price, and the 100% basis never forced a break. Measured. */
.k2 { display:grid; grid-template-columns:auto auto minmax(0,1fr); align-items:baseline; gap:3px 10px; background:#fbe4dd; border-radius:14px; padding:13px 16px; margin:.6rem 0 1rem; }
.k2-tag { font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:#9c3a23; font-weight:700; }
.k2-price { font-family:var(--font-lora, Georgia, serif); font-size:1.6rem; color:#9c3a23; }
.k2-note { grid-column:1 / -1; font-size:.8rem; margin:2px 0 0; color:#7a4636; max-width:52ch; }

/* ── Images ── */
.sec-img-wrap { margin:1.2rem 0; }
.sec-img { display:block; width:100%; max-width:760px; aspect-ratio:1408/768; object-fit:cover; height:auto; border-radius:16px; border:1px solid var(--bp-bd); }
.img-note { font-size:.8rem; color:var(--bp-mid); margin:.45rem 0 0; max-width:70ch; }
/* Infographics carry baked-in type: native ratio, contained, NEVER cover-cropped (§1c). */
.sec-img.inf-img { max-width:760px; width:100%; height:auto; aspect-ratio:auto; object-fit:contain; background:#fff; }
.sec-img.inf-tall { max-width:420px; }
/* Framed seam, not a floating logo: two clay hairlines flanking the wordmark (§4).
   Gutters cut ~40% (2.4/1.7rem → 1.45/1.05rem, plus the .5rem first-heading rule below).
   Measured seam-emblem-to-H2 distance: 100px → 60px. The seam is a punctuation mark
   between sections, and it was reading as a page break. */
.seam-wrap { display:flex; align-items:center; gap:clamp(12px,3vw,20px); margin:1.45rem 0 1.05rem; }
.seam-wrap::before, .seam-wrap::after { content:""; flex:1; height:1px;
  background:linear-gradient(to right, transparent, rgba(232,96,76,.42), transparent); }
.seam { display:block; margin:0; height:34px; width:auto; opacity:.92; flex:none; }

/* ── Shipping tiers — both supplied images, one card per delivery option ── */
.ship-tiers { display:grid; grid-template-columns:repeat(auto-fit, minmax(258px,1fr)); gap:14px; margin:1.1rem 0; }
.ship-t { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; overflow:hidden; box-shadow:0 2px 12px rgba(60,30,10,.05); }
.ship-t img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
/* Qualified with `.bpair p` on purpose: a bare `.ship-tier{color}` loses to the page's own
   `.bpair p` rule — the exact §1l collision that rendered this text at 1.19:1 elsewhere. */
.bpair p.ship-tier { margin:13px 15px 0; font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:var(--bp-green); font-weight:700; max-width:none; }
.bpair p.ship-fig { margin:2px 15px 0; font-family:var(--font-lora, Georgia, serif); font-size:1.55rem; color:var(--bp-claytext); max-width:none; }
.bpair p.ship-b { margin:5px 15px 15px; font-size:.86rem; color:var(--bp-mid); max-width:none; }

/* ── Framed video (kit .fs-video), never a bare <video> ── */
.fs-video { margin:1.2rem 0; max-width:760px; background:#20342b; border-radius:20px; overflow:hidden; }
.fs-video video { width:100%; height:auto; display:block; aspect-ratio:16/9; object-fit:cover; background:#20342b; }
.fs-video figcaption { padding:12px 16px; font-size:.86rem; color:#dcefe4; line-height:1.55; }
.fsv-tag { display:inline-block; font-size:var(--fs-micro); letter-spacing:.14em; text-transform:uppercase; color:#c9f2db; margin-right:8px; }

/* ── Tables: F pairing routes + A comparison ── */
.tF-wrap, .tA-wrap { overflow-x:auto; margin:1rem 0; }
.tF, .tA { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--bp-bd); border-radius:14px; overflow:hidden; font-size:.84rem; }
.tF caption, .tA caption { caption-side:top; text-align:left; background:var(--bp-green); color:#fff; padding:8px 14px; font-size:var(--fs-micro); letter-spacing:.1em; text-transform:uppercase; }
.tF th, .tF td, .tA th, .tA td { padding:10px 13px; border-bottom:1px solid var(--bp-bd); text-align:left; vertical-align:top; color:var(--bp-mid); }
.tF thead th, .tA thead th { background:#f6efe8; color:var(--bp-ink); font-size:var(--fs-micro); letter-spacing:.05em; text-transform:uppercase; }
.tF tbody th, .tA tbody th { color:var(--bp-ink); font-weight:700; }
.tF tbody tr:first-child th { box-shadow:inset 3px 0 0 var(--bp-clay); }

/* ── Geo cards ── */
/* Named areas, because `grid-row:1/span 2` on the arrow alone let auto-placement drop it
   into column 1 and collapse the 1fr label track to one word per line. */
.geo-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(248px,1fr)); gap:10px; margin:1rem 0; }
.geo-cards a { display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"k a" "n a";
  gap:2px 10px; background:#fff; border:1px solid var(--bp-bd); border-radius:14px; padding:11px 13px;
  text-decoration:none; min-height:44px; align-items:center;
  transition:border-color .15s cubic-bezier(.4,0,.2,1), transform .15s cubic-bezier(.4,0,.2,1); }
.geo-cards a:hover { border-color:var(--bp-clay); transform:translateY(-2px); }
.geo-k { grid-area:k; color:var(--bp-green); font-weight:700; font-size:.84rem; line-height:1.3; }
.geo-n { grid-area:n; font-size:var(--fs-micro); color:var(--bp-mid); line-height:1.3; }
.geo-a { grid-area:a; align-self:center; color:var(--bp-claytext); font-weight:700; font-size:1rem; }

/* ── Reviews ── */
.quotes { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px,1fr)); gap:16px; margin:1rem 0; }
.quote-c { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; padding:16px; margin:0; }
.quote-c img { width:64px; height:64px; border-radius:50%; object-fit:cover; }
.quote-c blockquote { margin:.6rem 0; padding:0; border:0; }
.quote-c blockquote p { font-size:.84rem; max-width:none; }
.quote-c figcaption { font-size:var(--fs-micro); color:var(--bp-claytext); font-weight:700; }

/* ── Read cards + xsell ── */
.read-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:14px; margin:.8rem 0; }
.read-cards a { background:#fff; border:1px solid var(--bp-bd); border-radius:16px; overflow:hidden; text-decoration:none; display:block; }
.read-cards img { width:100%; height:130px; object-fit:cover; display:block; }
.read-cards span { display:block; padding:10px 12px; color:var(--bp-green); font-weight:700; font-size:.82rem; }
.xsell { background:#f6efe8; border:1px solid var(--bp-bd); border-radius:16px; padding:14px 16px; margin:1rem 0; }
.xsell-k { font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; color:var(--bp-mid); margin:0 0 6px; }
.xsell p { font-size:.84rem; margin:.35rem 0; }

/* ── FAQ-B refreshed, two-column ── */
.faqB { columns:2; column-gap:16px; margin:1rem 0; }
.faqB-i { break-inside:avoid; background:#fff; border:1px solid var(--bp-bd); border-radius:14px; padding:11px 14px; margin:0 0 10px; }
.faqB-i summary { cursor:pointer; font-weight:600; color:var(--bp-ink); font-size:.86rem; list-style:none; min-height:24px; }
.faqB-i summary::-webkit-details-marker { display:none; }
.faqB-i summary::after { content:"+"; float:right; color:var(--bp-claytext); font-weight:700; }
.faqB-i[open] summary::after { content:"–"; }
.faqB-i p { font-size:.82rem; margin:.5rem 0 0; }

/* ── Contact form ── */
.fs-form { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:18px; margin:1rem 0; }
.form-side { background:#20342b; color:#dcefe4; border-radius:20px; padding:16px 18px; }
.fsx-k { font-size:var(--fs-micro); letter-spacing:.16em; text-transform:uppercase; color:#9fc7b0; margin:0 0 8px; }
.fsx-list { list-style:none; margin:0; padding:0; }
.fsx-list li { display:flex; justify-content:space-between; gap:10px; padding:6px 0; border-bottom:1px dashed #3b5a49; font-size:.8rem; }
.fsx-list li:last-child { border-bottom:0; }
.fsx-list li span:last-child { color:#f5b8a8; font-weight:700; white-space:nowrap; }
.fsx-ship { font-size:var(--fs-micro); color:#c9f2db; margin:10px 0 4px; }
.fsx-note { font-size:var(--fs-micro); color:#c9f2db; margin:0; }
.fs-fields { background:#fff; border:1px solid var(--bp-bd); border-radius:20px; padding:16px 18px; }
.fld, .fld2 label { display:block; font-size:var(--fs-micro); color:var(--bp-ink); font-weight:600; margin-bottom:10px; }
.fld2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.fs-fields input, .fs-fields select, .fs-fields textarea { width:100%; margin-top:4px; border:1.5px solid var(--bp-bd); border-radius:10px; background:#fff9f6; padding:9px 11px; font:inherit; font-size:16px; color:var(--bp-ink); }  /* 16px floor — under it iOS Safari auto-zooms on focus */
.fs-fields input:focus, .fs-fields select:focus, .fs-fields textarea:focus { outline:none; border-color:var(--bp-clay); box-shadow:0 0 0 3px rgba(232,96,76,.1); }
.fs-fields .btn-clay { border-radius:12px; margin-top:4px; }
.fs-fine { font-size:var(--fs-micro); color:var(--bp-mid); margin:.6rem 0 0; }

/* ── §1l specificity guard — `.bpair p` (0,1,1) outranks a bare component class (0,1,0).
   Measured in Playwright: .tdial-k and .fsx-ship were rendering at 1.72:1 on the dark
   panels because the page rule silently won. Qualify every component paragraph colour. ── */
.bpair p.tdial-k { color:#9fc7b0; }
.bpair p.fsx-k { color:#9fc7b0; }
.bpair p.fsx-ship, .bpair p.fsx-note { color:#c9f2db; }
.bpair p.rcard-sub { color:var(--bp-green); }
.bpair p.xsell-k, .bpair p.availB-k { color:var(--bp-mid); }
.bpair p.k2-note { color:#7a4636; }
.bpair p.k1-h { color:#fff; }
.bpair p.fs-fine { color:var(--bp-mid); }
.bpair p.availB-ship { color:var(--bp-mid); }
/* Same collision, the max-width axis: `.bpair p{max-width:70ch}` (0,1,1) beat the bare
   component classes (0,1,0), so the receipt's green header band stopped at 443px inside
   an 880px card. Measured, not inferred. */
.bpair p.k1-h, .bpair p.xsell-k, .bpair p.fsx-k, .bpair p.availB-k,
.bpair p.tdial-k, .bpair p.k2-tag { max-width:none; }

/* ── §1k drift fix: these three classes shipped in markup with no rule ── */
.phero-copy { min-width:0; }
/* The BLUF block is what answer engines extract — give it visible weight. */
.bpair p.bluf { background:#fff; border:1px solid var(--bp-bd); border-left:0; border-radius:14px; padding:14px 16px; margin:.6rem 0 1rem; font-size:clamp(.95rem,1.7vw,1.06rem); color:var(--bp-ink); box-shadow:0 2px 12px rgba(60,30,10,.05); }
/* OG photos take the taller 4:5 frame on mobile; infographics never do (they lose baked-in text). */
@media (max-width:640px) { .bpair .sec-img.og-photo { aspect-ratio:4/5; } }
.bpair .quote-c blockquote p { color:var(--bp-ink); }

/* Body links underlined + external arrow */
.bpair-main p a { color:var(--bp-claytext); text-decoration:underline; text-underline-offset:2px; }
/* Buttons living inside a <p> must not inherit the body-link colour — measured at 1.2:1
   (clay text on clay fill) on all six mid-page CTAs before this rule existed. */
.bpair-main p a.btn-clay { color:#fff; text-decoration:none; }
.bpair-main p a.btn-ghost { color:var(--bp-claytext); text-decoration:none; }
.bpair-main p a.btn-ghost:hover { color:#fff; }
.bpair-main p a[target="_blank"]::after { content:"\2197"; margin-left:2px; }

/* ── Readable floors ──────────────────────────────────────────────────────────
   A Playwright sweep at 375px found 108 text nodes rendering under 12.5px, down to
   10.6px. PRODUCT.md notes the audience skews older and DESIGN.md §Accessibility
   says text size matters more than usual here. The global --fs-h5 clamp bottoms out
   at 11px, so this is a site-wide condition — raised page-scoped here and logged to
   the backlog. Every desktop MAXIMUM below is unchanged, so the page still matches
   its siblings at 1280. ─────────────────────────────────────────────────────── */
.bpair .cag-h5 { font-size:clamp(.875rem, 1.1vw, .95rem); }
.bpair .cag-h6 { font-size:clamp(.85rem, 1.1vw, .9rem); }
.bpair .cs-l { font-size:clamp(0.79rem,2.2vw,0.82rem); }
.bpair .phero-ribbon li { font-size:clamp(0.79rem,2vw,0.82rem); }
.bpair .phero .eyebrow { font-size:var(--fs-micro); }
/* Letterspaced uppercase chrome. DESIGN.md's --fs-eyebrow bottoms out at 10px; that is
   what read as "too tiny", so the floor here is 12px and the ceiling is unchanged.
   `.tdial-k` is deliberately NOT in this list: it belongs to the desktop dial, whose row
   metrics are sized to fit 18 stops without a scrollbar, and which is display:none at
   every width where the complaint applies. */
.bpair .xsell-k, .bpair .availB-k,
.bpair .fsx-k, .bpair .k1-h, .bpair .k2-tag { font-size:clamp(0.79rem,1vw,0.82rem); }
.bpair .availB-ship, .bpair .fsx-ship, .bpair .fsx-note { font-size:.8rem; }
/* Route label: quieter than it was (.75rem opaque pill), still above this page's 11.5px
   readable floor — it is a caption, not body copy. */
.bpair .rbadge { font-size:var(--fs-micro); }
.bpair .rcard-split { font-size:var(--fs-micro); }
.bpair .fsv-tag { font-size:var(--fs-micro); }
.bpair p.ship-tier { font-size:var(--fs-micro); }
.bpair .tF caption, .bpair .tA caption { font-size:var(--fs-micro); }
.bpair .facet { font-size:.82rem; }
.bpair .fsx-list li { font-size:.85rem; }
.bpair .fs-fine { font-size:var(--fs-micro); }
.bpair .fld, .bpair .fld2 label { font-size:.82rem; }
.bpair .quote-c figcaption { font-size:.82rem; }
.bpair .tF, .bpair .tA { font-size:.88rem; }
.bpair .tF thead th, .bpair .tA thead th { font-size:var(--fs-micro); }
.bpair .k1-list dt, .bpair .k1-list dd { font-size:.88rem; }
.bpair .faqB-i summary { font-size:.9rem; }
.bpair .faqB-i p { font-size:.86rem; }
.bpair .quote-c blockquote p { font-size:.88rem; }
/* NOT a defect, do not "fix" it: my own right-edge probe flagged `.bc-pill` at 424px in
   a 375px viewport. `.bc-pill-wrap` is an intentional `overflow-x:auto` scroller with a
   trailing fade mask, added deliberately so long trails swipe instead of clipping. The
   probe was missing it from its scroller exclusion list, exactly the failure class in
   skills/cag-gate-integrity.md. No rule belongs here. */

/* ── Tablet ── */
@media (max-width:1024px) {
  .bpair-body { grid-template-columns:1fr; }
  .tdial { display:none; }
  .railA { display:block; position:sticky; top:var(--hdr); z-index:40; background:rgba(250,247,244,.985); border-bottom:1px solid var(--bp-bd); box-shadow:0 6px 14px rgba(60,30,10,.07); }
  .railA ul { display:flex; gap:10px; overflow-x:auto; list-style:none; margin:0; padding:9px clamp(16px,4vw,48px); scrollbar-width:none; }
  .railA ul::-webkit-scrollbar { display:none; }
  .railA a { display:inline-block; white-space:nowrap; font-size:.82rem; color:var(--bp-green); background:#eaf4ef; border-radius:50px; padding:7px 13px; text-decoration:none; min-height:24px; }
  /* Anchors must clear the header AND the rail that sits under it, not the header alone. */
  .bpair-main section { scroll-margin-top:calc(var(--hdr) + var(--rail-h) + 14px); }
  .counter-row { grid-template-columns:repeat(3, minmax(0,1fr)); }
  .fs-form { grid-template-columns:1fr; }
  .faqB { columns:1; }
}

/* ── Mobile ── */
@media (max-width:980px) {
  .phero-grid { grid-template-columns:1fr; max-height:none; min-height:0; gap:16px; }
  .phero-duo { order:-1; position:static; padding-bottom:0; display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .duo-b { position:static; width:auto; transform:rotate(1.2deg); }
  .phero-ribbon { grid-template-columns:repeat(2, minmax(0,1fr)); }
  .availB { grid-template-columns:1fr; }
  .availB-rail { position:static; display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; }
  .availB-k, .availB-ship { display:none; }
  .facet { width:auto; white-space:nowrap; margin-bottom:0; }
  .availB-grid { grid-template-columns:repeat(2, minmax(0,1fr)); }
}
@media (max-width:640px) {
  .counter-row { grid-template-columns:repeat(2, minmax(0,1fr)); }
  /* Content-width pills stacked in a column read as two ragged left-aligned blocks.
     Equal full-width rows instead — tidier, and a bigger target for each. */
  .phero-cta { display:grid; grid-template-columns:1fr; gap:9px; }
  .phero-cta a { text-align:center; }
  /* ONE card per row, photo first at full card width, every detail line stacked beneath.
     Two-up left ~136px of body width (which is why the description used to be
     display:none), and the horizontal split that replaced it squeezed the photo into a
     ~127px column and cut the birds' heads in half. Full width solves both: the masters
     are 640x480 and this box is 4:3, so `cover` crops nothing — the whole bird, face
     included, is inside the frame — and the text gets the full 343px measure. */
  .availB-grid { grid-template-columns:1fr; gap:14px; }
  .rcard-photo::after { height:76px; }
  .rbadge { left:14px; right:14px; bottom:10px; font-size:var(--fs-micro); letter-spacing:.08em; }
  .rcard-body { padding:14px 16px 16px; gap:5px; }
  .rcard-name { font-size:1.14rem; }
  .bpair p.rcard-price { font-size:1.1rem; }
  .bpair p.rcard-sub { font-size:.82rem; }
  .bpair p.rcard-blurb { font-size:.86rem; -webkit-line-clamp:3; }
  .bpair p.rcard-trust, .bpair p.rcard-ship { font-size:var(--fs-micro); }
  .rcard .rcta { align-self:stretch; text-align:center; padding:.68rem 1rem; font-size:.88rem; }
  .fld2 { grid-template-columns:1fr; }
  /* mobile table stacking — one card per row */
  .tF thead, .tA thead { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  .tF caption, .tA caption { display:block; border-radius:10px 10px 0 0; }
  .tF tr, .tA tr { display:block; border:1px solid var(--bp-bd); border-radius:12px; margin-bottom:10px; background:#fff; overflow:hidden; }
  .tF td, .tF tbody th, .tA td, .tA tbody th { display:block; border-bottom:1px dashed var(--bp-bd); padding:9px 13px; }
  .tF tbody th, .tA tbody th { background:#f6efe8; font-size:.95rem; }
  .tF td::before, .tA td::before { content:attr(data-label); display:block; font-size:var(--fs-micro); letter-spacing:.08em; text-transform:uppercase; color:var(--bp-mid); margin-bottom:2px; }
  .tF tbody tr:first-child th { box-shadow:none; }
  /* The five-fact receipt: two columns in a 343px box crushes both. Stack them. */
  .k1-list > div { grid-template-columns:1fr; gap:2px; padding:9px 0; }
  .k2 { grid-template-columns:auto minmax(0,1fr); align-items:baseline; gap:2px 8px; }
  .k2-note { max-width:none; }
  .sec-img { border-radius:12px; }
  /* Scene photos (a room, people, several birds) take the wider 5:4 mobile frame;
     single-bird portraits keep the taller 4:5 above. Infographics take neither. */
  .bpair .sec-img.og-photo.og-scene { aspect-ratio:5/4; }   /* beats .og-photo's 4:5 on specificity, not on source order */
  .bpair .sec-img.inf-img { width:100vw; margin-left:calc(50% - 50vw); max-width:none; border-radius:0; border-left:0; border-right:0; }
  .bpair .sec-img.inf-tall { width:auto; margin-left:0; max-width:100%; border-radius:12px; border:1px solid var(--bp-bd); }
  .ship-tiers { gap:12px; }
}
@media (prefers-reduced-motion:reduce) { * { transition:none !important; } }

/* ═══════════════════════════════════════════════════════════════════════════
   TUPLE DELTAS — this page's component tuple, distinct from all nine siblings.
   Hero-C refreshed "Production Ledger" · Dial 1 Clay · Rail B green ticker ·
   T2 chip cloud refreshed · K3 + K5 · Table H · FAQ-A refreshed.
