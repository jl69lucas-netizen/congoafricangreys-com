---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'Proven African Grey Breeding Pairs for Sale | Three Bonded Pairs, Seven Clutches on Record, From $3,000 | Closed-Banded, CITES Appendix I Captive-Bred | C.A.Gs — Midland, Texas Aviary Since 2014';
const description = 'Three proven African Grey breeding pairs for sale from our Midland, Texas aviary — Talker & Jane, Mari & Lake, Sally & Odin, from $3,000. Every pair is closed-banded with its clutch record on request, hand-reared and still tame, and ships in two crates. See what each pair has produced.';
const canonical = 'https://congoafricangreys.com/african-grey-breeding-pair-for-sale/';

const IMG = '/images/breeding-pair';

/* Live from data/price-matrix.json. Ages, clutch counts and prices are the breeder's own
   record — none is estimated, and the clutch total (7) is 4 + 2 + 1, not a rounded claim. */
const pairs = [
  {
    id: 'talker-jane',
    tile: `${IMG}/talker-jane-tile`,
    name: 'Talker & Jane',
    cock: 'Talker', hen: 'Jane',
    ages: 'Twelve and ten years old',
    clutches: 4,
    price: 3000,
    tier: 'Most Proven',
    img: `${IMG}/talker-jane-proven-african-grey-breeding-pair`,
    alt: 'Talker and Jane, the twelve and ten year old proven pair from C.A.Gs, perched on an aviary branch',
    /* Rule 50b: the primary keyword lives in the LCP image's alt and nowhere else.
       Hero-C is a mosaic, so tile 1 is the primary image — not a separate hero photo. */
    heroAlt: 'African grey breeding pair for sale — Talker and Jane in our Midland, Texas flight aviary',
    blurb: 'Our longest-producing pair, and the one we point first-time breeding buyers toward. Four clutches hatched and reared here, with the dates available before you pay.',
    sub: 'Four clutches hatched · closed-banded',
  },
  {
    id: 'mari-lake',
    tile: `${IMG}/mari-lake-tile`,
    name: 'Mari & Lake',
    cock: 'Lake', hen: 'Mari',
    ages: 'Six and seven years old',
    clutches: 2,
    price: 4500,
    tier: 'Mid Ladder',
    img: `${IMG}/mari-lake-african-grey-breeding-pair-two-clutches`,
    alt: 'Mari and Lake, a bonded Congo grey cock and hen with two hatched clutches on record',
    heroAlt: 'Mari and Lake at six and seven years old, the middle pair on our production ladder',
    blurb: 'Two hatched clutches settles the question a single clutch leaves open, and this pair still has most of its productive years in front of it.',
    sub: 'Two clutches hatched · closed-banded',
  },
  {
    id: 'sally-odin',
    tile: `${IMG}/sally-odin-tile`,
    name: 'Sally & Odin',
    cock: 'Odin', hen: 'Sally',
    ages: 'Four and five years old',
    clutches: 1,
    price: 5500,
    tier: 'Most Years Ahead',
    img: `${IMG}/sally-odin-youngest-proven-african-grey-pair`,
    alt: 'Sally and Odin, the youngest proven Congo grey pair we have placed, four and five years old',
    heroAlt: 'Sally and Odin in the aviary, the pair with the most breeding years still ahead of them',
    blurb: 'The youngest pair we have ever placed as proven. Sally sits at the early end of the breeding range, and we would rather say that plainly than let you find it out later.',
    sub: 'One clutch hatched · closed-banded',
  },
];

const counters = [
  { n: '3', l: 'Proven Pairs' },
  { n: '7', l: 'Clutches Hatched' },
  { n: '100%', l: 'Closed-Banded' },
  { n: '12', l: 'Yrs Aviary' },
  { n: '2', l: 'Crates Always' },
  { n: '$3,000', l: 'Floor Price' },
  { n: '0', l: 'Wild-Caught' },
  { n: '24h', l: 'Reply' },
];

/* T2 chip cloud, refreshed: every chip is one criterion from the proven standard, so the
   contents list teaches the standard before the reader reaches the checklist tool at §15. */
const stops = [
  { id: 'pairs',     n: 1,  t: 'The Three Pairs' },
  { id: 'proven',    n: 2,  t: 'What "Proven" Means' },
  { id: 'ladder',    n: 3,  t: 'Why Fewest Costs Most' },
  { id: 'age',       n: 4,  t: 'Breeding Age' },
  { id: 'record',    n: 5,  t: 'Production Record' },
  { id: 'tame',      n: 6,  t: 'Still Tame' },
  { id: 'moving',    n: 7,  t: 'Moving a Pair' },
  { id: 'pairing',   n: 8,  t: 'Pairing Method' },
  { id: 'market',    n: 9,  t: 'Cost Elsewhere' },
  { id: 'housing',   n: 10, t: 'Housing & Nest Box' },
  { id: 'paperwork', n: 11, t: 'Paperwork' },
