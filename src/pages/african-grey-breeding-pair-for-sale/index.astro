@media (max-width:640px) {
  .bpair .counter-row { grid-template-columns:repeat(2, minmax(0,1fr)); }
  .bpair .pair-grid { grid-template-columns:minmax(0,1fr); }
  .bpair .phero-mosaic { gap:6px; }
  /* Seam gutters −40% on mobile, per the polish playbook. */
  .bpair .seam-wrap { margin:.9rem 0 .65rem; }
  /* Table H stacks: one card per row, data-label on every td. Never a ::before on <tr>. */
  /* `caption` MUST be in this list. Left as display:table-caption inside a table whose
