  <script is:inline define:vars={{ N }}>
    // Dial 1 scroll-spy + conic ring + Rail A active state
    (function () {
      const secs = Array.from(document.querySelectorAll('.dnat .content .sec'));
      const ring = document.getElementById('dialRing');
      const num = document.getElementById('dialNum');
      const dialLinks = Array.from(document.querySelectorAll('#dialList a'));
      const railLinks = Array.from(document.querySelectorAll('.railA a'));
      if (!secs.length) return;
      let active = '';
      const setActive = (id, idx) => {
        if (id === active) return;
        active = id;
        const p = Math.round(((idx + 1) / N) * 100);
        if (ring) ring.style.setProperty('--p', p);
        if (num) num.textContent = String(idx + 1).padStart(2, '0');
        dialLinks.forEach((a) => a.classList.toggle('on', a.dataset.id === id));
        let activeChip = null;
        railLinks.forEach((a) => {
          const on = a.dataset.id === id;
          a.classList.toggle('on', on);
          if (on) activeChip = a;
        });
        // Every class write is done above. Calling scrollIntoView() inside that loop
        // read layout between writes and forced a synchronous reflow each iteration —
        // the PageSpeed "Forced reflow" finding. One deferred read instead.
        if (activeChip && activeChip.scrollIntoView) {
          requestAnimationFrame(() =>
            activeChip.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' }));
        }
      };
      const io = new IntersectionObserver((ents) => {
        ents.forEach((e) => {
          if (e.isIntersecting) {
            const idx = secs.indexOf(e.target);
            if (idx > -1) setActive(e.target.id, idx);
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
      secs.forEach((s) => io.observe(s));

      // Avail-B facet by confirmed sex
      const grid = document.getElementById('birdGrid');
      if (grid) {
        const cards = Array.from(grid.querySelectorAll('.bcard'));
        document.querySelectorAll('.availB-side .side-f').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.availB-side .side-f').forEach((b) => b.classList.remove('on'));
            btn.classList.add('on');
            const f = btn.dataset.f;
            cards.forEach((c) => { c.classList.toggle('hide', f !== 'all' && c.dataset.cat !== f); });
          });
        });
      }
    })();
  </script>
