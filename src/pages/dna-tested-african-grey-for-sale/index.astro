.dnat .content p a.btn,.dnat .content p a.ticket-cta,.dnat .content a.geo-card,.dnat .content a.read-card{text-decoration:none;}
.dnat .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}

/* Buttons */
.dnat .btn{display:inline-flex;align-items:center;gap:.4rem;font-weight:600;font-size:.95rem;padding:.7rem 1.25rem;border-radius:50px;text-decoration:none;transition:transform .18s,background .18s,box-shadow .18s;border:1px solid transparent;}
.dnat .btn-clay{background:var(--clay-ink);color:#fff;box-shadow:0 4px 14px rgba(200,71,47,.24);}
.dnat .btn-clay:hover{transform:translateY(-1px);}
.dnat .btn-ghost{background:transparent;color:var(--green-d);border-color:var(--green);}
.dnat .btn-ghost:hover{background:rgba(45,106,79,.07);}

/* ===== HERO-C · MOSAIC METRICS ===== */
.dnat .hero{background:linear-gradient(150deg,#f7f2ec,#f2e9e0 60%,#efe2d6);border-bottom:1px solid var(--bd);padding:6px 0 26px;}
.dnat .hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:34px;align-items:center;}
.dnat .eyebrow{font-size:.82rem;font-weight:600;color:var(--clay-t);margin:.4rem 0 .55rem;}
.dnat .eyebrow em{font-style:italic;}
/* the "Metrics" half of Hero-C: a stat strip ABOVE the headline (this page's signature) */
.dnat .hero-metrics{list-style:none;display:flex;flex-wrap:wrap;gap:0;padding:0;margin:0 0 .7rem;border:1px solid var(--bd);border-radius:12px;background:rgba(255,255,255,.72);overflow:hidden;max-width:460px;}
.dnat .hero-metrics li{flex:1 1 0;min-width:110px;display:flex;flex-direction:column;gap:1px;padding:9px 13px;border-right:1px solid var(--bd);}
.dnat .hero-metrics li:last-child{border-right:0;}
.dnat .hero-metrics b{font-family:var(--font-lora,'Newsreader',serif);font-size:1.12rem;color:var(--clay-ink);line-height:1.1;}
.dnat .hero-metrics span{font-size:.68rem;color:var(--muted);letter-spacing:.02em;}
.dnat .hero h1{font-family:var(--font-lora,'Newsreader',serif);font-size:clamp(1.5rem,1.02rem + 1.55vw,1.98rem);line-height:1.13;color:var(--green-d);margin:0 0 .45rem;letter-spacing:-.015em;text-wrap:balance;}
.dnat .hero h1 em{color:var(--clay-ink);font-style:italic;}
.dnat .hero .lead{font-size:.94rem;line-height:1.56;color:var(--ink);max-width:56ch;margin:0;}
.dnat .hero-cta{display:flex;gap:.55rem;flex-wrap:wrap;margin:.8rem 0 0;}
/* 2x2 mosaic: the anchor pair spans the top row, three question tiles beneath it */
.dnat .hero-mosaic{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;align-content:center;max-width:430px;margin-left:auto;}
.dnat .mtile{margin:0;position:relative;border-radius:12px;overflow:hidden;background:#efe6dd;box-shadow:0 6px 18px rgba(60,30,10,.13);}
.dnat .mtile img{display:block;width:100%;height:100%;aspect-ratio:1/1;object-fit:cover;}
.dnat .mtile.anchor{grid-column:1 / -1;}
.dnat .mtile.anchor img{aspect-ratio:16/9;}
.dnat .mtile figcaption{position:absolute;left:0;right:0;bottom:0;padding:16px 12px 9px;display:flex;flex-direction:column;gap:1px;
  background:linear-gradient(to top,rgba(28,18,12,.72),transparent);color:#fff;}
.dnat .mtile figcaption b{font-family:var(--font-lora,'Newsreader',serif);font-size:.92rem;line-height:1.1;}
.dnat .mtile figcaption span{font-size:.7rem;color:#f3e6df;}
.dnat .mtile figcaption.q{align-items:center;font-size:.68rem;font-weight:700;letter-spacing:.03em;padding:14px 6px 7px;}

/* Counter */
.dnat .counter{background:#fff;border-bottom:1px solid var(--bd);padding:20px 0;}
.dnat .counter-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;}
.dnat .cstat{border:1px solid var(--bd);border-radius:12px;padding:10px 13px;text-align:center;min-height:66px;display:flex;flex-direction:column;justify-content:center;background:var(--cream);}
.dnat .cstat .cn{font-family:var(--font-lora,'Newsreader',serif);font-size:1.35rem;font-weight:700;color:var(--clay-ink);line-height:1;}
.dnat .cstat .cl{font-size:.72rem;color:var(--muted);margin-top:.3rem;}

/* Seam divider — for-sale wordmark variant */
.dnat .seam-wrap{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin:30px auto 26px;max-width:560px;}
.dnat .seam-wrap::before,.dnat .seam-wrap::after{content:"";height:1px;border-radius:1px;}
.dnat .seam-wrap::before{background:linear-gradient(to right,transparent,rgba(232,96,76,.34));}
.dnat .seam-wrap::after{background:linear-gradient(to left,transparent,rgba(232,96,76,.34));}
.dnat .seam{display:block;height:34px;width:auto;opacity:.92;margin:0;}

/* Section differentiator — clay spine on every H2 */
.dnat .content .sec>h2{position:relative;padding-left:14px;}
.dnat .content .sec>h2::before{content:"";position:absolute;left:0;top:.24em;bottom:.24em;width:3px;border-radius:2px;background:var(--clay);}

/* Body grid + Dial 1 (clay on cream) */
.dnat .body-grid{display:grid;grid-template-columns:196px minmax(0,1fr);gap:28px;padding-top:8px;padding-bottom:40px;}
.dnat .dial{position:relative;}
.dnat .dial-card{position:sticky;top:calc(var(--hdr) + 16px);display:flex;flex-direction:column;gap:10px;align-items:stretch;background:#fff;border:1px solid var(--bd);border-radius:16px;padding:12px 10px;box-shadow:0 3px 12px rgba(60,30,10,.05);max-height:calc(100vh - var(--hdr) - 32px);overflow-y:auto;scrollbar-width:thin;}
.dnat .ring{--p:0;width:64px;height:64px;border-radius:50%;margin:2px auto 0;flex:none;background:conic-gradient(var(--clay-ink) calc(var(--p) * 1%),#f3ddd5 0);display:grid;place-items:center;}
.dnat .ring-in{width:50px;height:50px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center;}
.dnat .ring-n{font-family:var(--font-lora,'Newsreader',serif);font-size:15px;font-weight:700;color:var(--clay-ink);line-height:1;}
.dnat .ring-of{font-size:7px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;}
.dnat .dial-list{list-style:none;margin:0;padding:8px 0 0;border-top:1px dashed var(--bd);display:grid;grid-template-columns:1fr;gap:1px;}
.dnat .dial-list a{display:flex;gap:7px;align-items:baseline;padding:5px 7px;border-radius:8px;text-decoration:none;color:#4a423b;font-size:.74rem;line-height:1.25;transition:background-color .15s,color .15s;}
.dnat .dial-list a:hover{background:#faf3ee;color:#2a2622;}
.dnat .dial-list a.on{background:#faece7;color:#2a2622;font-weight:600;}
/* light card -> muted #6b625a numerals. NOT the #9fc7b0 dark-card fix. */
.dnat .dial-list .di{font-family:var(--font-lora,'Newsreader'),serif;font-weight:700;color:var(--muted);width:16px;flex:none;font-size:.7rem;font-variant-numeric:tabular-nums;}
.dnat .dial-list a.on .di{color:var(--clay-t);}
.dnat .dial-list .dh{min-width:0;}
.dnat .dial-list .dt{margin-left:auto;font-size:.56rem;font-weight:600;letter-spacing:.02em;color:var(--green-d);background:#eef5f1;border-radius:50px;padding:1px 6px;white-space:nowrap;}

/* Rail A (mobile) hidden on desktop */
.dnat .railA{display:none;}

/* Section images */
.dnat .sec-img{display:block;width:100%;max-width:760px;aspect-ratio:1408/768;object-fit:cover;height:auto;border-radius:14px;border:1px solid var(--bd);margin:1rem 0 1.1rem;box-shadow:0 4px 16px rgba(60,30,10,.06);}
.dnat .sec{scroll-margin-top:calc(var(--hdr) + 16px);padding:6px 0 10px;}

/* Ticket CTA */
.dnat .ticket{margin:1.2rem 0 .2rem;}
.dnat .ticket-cta{display:inline-flex;align-items:center;justify-content:center;text-align:center;text-wrap:balance;gap:.5rem;background:#fff;border:1.5px solid var(--clay);color:var(--clay-ink);font-weight:700;padding:.55rem 1.05rem;border-radius:50px;text-decoration:none;transition:background .18s;}
.dnat .ticket-cta span{transition:transform .18s;}
.dnat .ticket-cta:hover{background:#fff3ef;}
.dnat .ticket-cta:hover span{transform:translateX(3px);}

/* K4 clipboard checklist */
.dnat .k4{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:14px 18px 16px;margin:12px 0 10px;box-shadow:0 3px 14px rgba(60,30,10,.05);}
.dnat .k4-head{display:flex;align-items:center;gap:.55rem;border-bottom:1px dashed var(--bd);padding-bottom:.5rem;margin-bottom:.6rem;}
.dnat .k4-head b{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;color:var(--green-d);}
.dnat .k4-clip{width:26px;height:14px;border-radius:4px;background:var(--clay-ink);position:relative;flex:none;}
.dnat .k4-clip::after{content:"";position:absolute;left:50%;top:-6px;transform:translateX(-50%);width:12px;height:10px;border:2px solid var(--clay-ink);border-bottom:0;border-radius:4px 4px 0 0;}
.dnat .k4-list{list-style:none;margin:0;padding:0;display:grid;gap:.45rem;}
.dnat .k4-list li{position:relative;padding-left:1.5rem;font-size:.92rem;line-height:1.55;max-width:70ch;}
.dnat .k4-list li::before{content:"";position:absolute;left:0;top:.42em;width:.62rem;height:.62rem;border-radius:3px;border:2px solid var(--green);}

/* K5 capsule strip */
.dnat .k5{display:flex;flex-wrap:wrap;gap:10px;margin:2px 0 8px;}
.dnat .k5 .cap{display:flex;flex-direction:column;gap:1px;background:#eaf4ef;border:1px solid #cfe6da;border-radius:12px;padding:8px 14px;font-size:.72rem;color:#3d5b4d;font-style:normal;margin:0;}
.dnat .k5 .cap b{font-family:var(--font-lora,'Newsreader',serif);font-size:.95rem;color:var(--green-d);}

/* T2 chip cloud */
.dnat .chipcloud{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:12px 16px 14px;margin:10px 0 4px;}
.dnat .ccrow{display:grid;grid-template-columns:82px minmax(0,1fr);gap:10px;align-items:start;padding:7px 0;border-bottom:1px dashed var(--bd);}
.dnat .ccrow:last-child{border-bottom:0;}
.dnat .ccg{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);padding-top:.4rem;}
.dnat .ccrow ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;}
.dnat .ccrow a{display:inline-block;font-size:.78rem;font-weight:600;color:var(--green-d);background:var(--cream);border:1px solid var(--bd);border-radius:50px;padding:5px 12px;text-decoration:none;transition:border-color .15s,background .15s;}
.dnat .ccrow a:hover{border-color:var(--clay);background:#fff3ef;color:var(--clay-ink);}

/* Table D "Lab Report" — this page's own table (numbered field rows, green rule) */
.dnat .tblwrap{overflow-x:auto;margin:1rem 0;}
.dnat .tblD{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;}
.dnat .tblD-cap{caption-side:top;text-align:left;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#fff;background:var(--green-d);padding:.5rem .9rem;}
.dnat .tblD th{background:var(--cream);color:var(--green-d);text-align:left;padding:.6rem .8rem;font-weight:700;font-size:.8rem;border-bottom:2px solid var(--bd);}
.dnat .tblD td{padding:.62rem .8rem;border-bottom:1px solid var(--bd);vertical-align:top;}
.dnat .tblD tr:last-child td{border-bottom:0;}
.dnat .tblD td:first-child{font-weight:700;color:var(--green-d);white-space:nowrap;}
.dnat .tblD td:last-child{color:var(--muted);}
.dnat .fnum{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:5px;background:#eef5f1;color:var(--green-d);font-size:.62rem;font-weight:700;margin-right:.5rem;vertical-align:middle;font-variant-numeric:tabular-nums;}

/* Table A — clay-header comparison */
.dnat .tblA{width:100%;border-collapse:separate;border-spacing:0;font-size:.88rem;background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;}
.dnat .tblA th{background:var(--clay-ink);color:#fff;text-align:left;padding:.65rem .8rem;font-weight:700;font-size:.8rem;}
.dnat .tblA td{padding:.62rem .8rem;border-bottom:1px solid var(--bd);vertical-align:top;}
.dnat .tblA tr:last-child td{border-bottom:0;}
.dnat .tblA td:first-child{font-weight:700;color:var(--green-d);}
.dnat .tblA td:nth-child(3){color:var(--muted);}

/* Avail-B — sticky sidebar faceted by confirmed sex */
.dnat .availB{display:grid;grid-template-columns:200px minmax(0,1fr);gap:20px;margin:1rem 0;align-items:start;}
.dnat .availB-side{position:sticky;top:calc(var(--hdr) + 16px);background:#fff;border:1px solid var(--bd);border-radius:16px;padding:14px;box-shadow:0 4px 16px rgba(60,30,10,.06);}
.dnat .side-h{font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:0 0 .6rem;}
.dnat .side-filters{display:flex;flex-direction:column;gap:4px;}
.dnat .side-f{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;background:var(--cream);border:1.5px solid var(--bd);border-radius:10px;padding:.5rem .65rem;font:inherit;font-size:.86rem;font-weight:600;color:var(--ink);cursor:pointer;text-align:left;transition:background-color .15s,border-color .15s;}
.dnat .side-f:hover{background:#fff3ef;}
.dnat .side-f.on{border-color:var(--clay-ink);color:var(--green-d);background:#fff3ef;}
.dnat .side-n{font-size:.72rem;font-weight:700;color:var(--muted);background:#fff;border-radius:50px;min-width:24px;text-align:center;padding:2px 8px;}
.dnat .side-f.on .side-n{background:var(--clay-ink);color:#fff;}
.dnat .side-ship{border-top:1px solid var(--bd);margin-top:12px;padding-top:10px;}
.dnat .rail-ship{font-size:.72rem;color:var(--muted);margin:0 0 .35rem;line-height:1.45;}
.dnat .rail-ship b{color:var(--green-d);}
.dnat .availB-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-content:start;}
.dnat .bcard{border:1px solid var(--bd);border-radius:14px;overflow:hidden;background:#fff;display:flex;flex-direction:column;}
.dnat .bcard.hide{display:none;}
.dnat .bphoto{position:relative;aspect-ratio:1/1;overflow:hidden;}
.dnat .bphoto img{width:100%;height:100%;object-fit:cover;}
.dnat .bphoto::after{content:"";position:absolute;inset:auto 0 0 0;height:44%;background:linear-gradient(to top,rgba(28,18,12,.42),transparent);pointer-events:none;}
/* default bottom-left; .badge-top is the per-bird escape hatch for a head-down bird */
.dnat .bbadge{position:absolute;top:auto;bottom:8px;left:8px;z-index:2;background:rgba(255,255,255,.94);color:var(--green-d);font-size:.6rem;font-weight:700;padding:.18rem .5rem;border-radius:50px;text-transform:uppercase;letter-spacing:.03em;box-shadow:0 1px 4px rgba(0,0,0,.18);}
.dnat .bbadge.cock{color:#1f4f6d;}
.dnat .bbadge.pair{color:var(--clay-ink);}
.dnat .bbadge.badge-top{top:8px;bottom:auto;}
.dnat .binfo{padding:11px 12px 13px;display:flex;flex-direction:column;gap:.45rem;flex:1;}
.dnat .brow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.4rem;align-items:baseline;min-height:2.65rem;}
.dnat .brow h3{font-family:var(--font-lora,'Newsreader',serif);font-size:1.02rem;line-height:1.16;margin:0;text-transform:uppercase;letter-spacing:.02em;color:var(--green-d);min-width:0;overflow-wrap:anywhere;}
.dnat .bprice{font-weight:700;color:var(--clay-ink);font-size:.98rem;white-space:nowrap;}
.dnat .bblurb{font-size:.8rem;color:var(--muted);line-height:1.45;margin:0;flex:1;}
.dnat .bchips{display:flex;gap:.3rem;flex-wrap:wrap;min-height:1.4rem;align-content:start;}
.dnat .bchips span{font-size:.62rem;background:var(--cream);border:1px solid var(--bd);color:var(--green-d);padding:.1rem .4rem;border-radius:50px;font-weight:600;}
.dnat .bfull{align-self:start;justify-content:center;margin-top:auto;font-size:.8rem;padding:.5rem .95rem;white-space:nowrap;gap:.3rem;}

/* Shipping line + geo cards */
.dnat .ship-line{background:#fdf5f3;border:1px solid #f0d5cd;border-radius:10px;padding:.6rem .85rem;font-size:.9rem;margin:.9rem 0;}
.dnat .ship-line b{color:var(--green-d);}
.dnat .geo-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:1rem 0 .4rem;}
.dnat .geo-card{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:.6rem;background:#fff;border:1px solid var(--bd);border-radius:11px;padding:.6rem .8rem;text-decoration:none;color:var(--ink);transition:border-color .15s,transform .15s;}
.dnat .geo-card svg{grid-row:1/3;align-self:center;color:var(--clay);}
.dnat .geo-card .gl{font-weight:600;font-size:.85rem;color:var(--green-d);}
.dnat .geo-card .gn{font-size:.74rem;color:var(--muted);}
.dnat .geo-card:hover{border-color:var(--clay);transform:translateY(-1px);}

/* Newsletter — for-sale .fs-nl */
.dnat .fs-nl{margin:24px 0;border-radius:20px;overflow:hidden;box-shadow:0 6px 22px rgba(60,30,10,.08);}
.dnat .fs-nl.banner{background:linear-gradient(135deg,#221f1d,#2f2926);color:#fff;}
.dnat .fs-nl-inner{padding:clamp(14px,2.2vw,20px) clamp(16px,2.8vw,26px);max-width:820px;}
.dnat .fs-nl-eyebrow{color:#f08070;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 8px;}
.dnat .fs-nl-h{font-family:var(--font-lora,'Newsreader',serif);font-size:clamp(1.05rem,1.8vw,1.24rem);line-height:1.22;margin:0 0 4px;color:#fff;}
.dnat .fs-nl-sub{font-size:.84rem;line-height:1.5;margin:0 0 10px;max-width:56ch;color:rgba(255,255,255,.86);}
.dnat .fs-nl-form{display:flex;gap:8px;flex-wrap:wrap;}
.dnat .fs-nl-form input{flex:1;min-width:200px;border:1.5px solid rgba(255,255,255,.3);border-radius:50px;padding:12px 18px;font:inherit;font-size:16px;background:#fff;color:#2a2622;}
.dnat .fs-nl-form input:focus{outline:none;border-color:var(--clay);box-shadow:0 0 0 3px rgba(232,96,76,.2);}
.dnat .fs-nl-form button{border:none;cursor:pointer;}
.dnat .fs-nl-note{font-size:.74rem;color:rgba(255,255,255,.72);margin:10px 0 0;}

/* Video — for-sale .fs-video */
.dnat .fs-video{margin:1rem 0;max-width:760px;}
.dnat .fs-video-frame{position:relative;border-radius:18px;overflow:hidden;box-shadow:0 8px 26px rgba(60,30,10,.16);background:#1b1815;}
.dnat .fs-video-frame video{display:block;width:100%;height:auto;aspect-ratio:1408/768;object-fit:cover;}
.dnat .fs-video-tag{position:absolute;top:12px;left:12px;z-index:2;background:rgba(34,31,29,.82);color:#fff;font-size:.68rem;font-weight:600;letter-spacing:.04em;padding:5px 12px;border-radius:50px;pointer-events:none;}
.dnat .fs-video figcaption{font-size:.8rem;color:var(--muted);margin-top:8px;font-style:italic;}

/* Reviews */
.dnat .rev-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:1rem 0;}
.dnat .rev{margin:0;background:#fff;border:1px solid var(--bd);border-radius:14px;padding:16px;}
.dnat .rev .stars{color:var(--clay-ink);letter-spacing:2px;margin-bottom:.4rem;font-size:1.05rem;}
.dnat .rev blockquote{margin:0 0 .8rem;font-size:.9rem;line-height:1.6;color:var(--ink);}
.dnat .rev figcaption{display:flex;align-items:center;gap:.6rem;}
.dnat .rev figcaption img{width:52px;height:52px;border-radius:50%;object-fit:cover;flex:none;}
.dnat .rev figcaption b{display:block;font-size:.9rem;color:var(--green-d);}
.dnat .rev figcaption span span{font-size:.76rem;color:var(--muted);}

/* Read cards */
.dnat .read-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:1rem 0;}
.dnat .read-card{display:grid;grid-template-columns:120px minmax(0,1fr);gap:12px;border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:var(--ink);transition:border-color .15s,transform .15s;}
.dnat .read-card img{width:120px;height:100%;object-fit:cover;}
.dnat .rc-body{padding:10px 12px 10px 0;display:flex;flex-direction:column;gap:.2rem;}
.dnat .rc-k{font-size:.66rem;text-transform:uppercase;letter-spacing:.04em;color:var(--clay-t);font-weight:700;}
.dnat .rc-body b{color:var(--green-d);font-size:.92rem;line-height:1.25;}
.dnat .rc-s{font-size:.78rem;color:var(--muted);line-height:1.4;}
.dnat .read-card:hover{border-color:var(--clay);transform:translateY(-1px);}

/* FAQ-A refreshed — numbered clay chip + chevron (siblings use the +/x cross) */
.dnat .faqA{margin:1rem 0 6px;display:flex;flex-direction:column;gap:8px;}
.dnat .faqA-item{background:#fff;border:1px solid var(--bd);border-radius:12px;overflow:hidden;box-shadow:0 2px 10px rgba(60,30,10,.04);}
.dnat .faqA-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:14px 18px;color:#2a2622;}
.dnat .faqA-item summary::-webkit-details-marker{display:none;}
/* --clay-ink (#c8472f) lands at EXACTLY 4.50:1 on the cream summary background —
   nominally AA, but on the threshold, which is why the audit reported it as failing.
   --clay-t (#b04228) is the house token for small clay text on light and gives real
   headroom at this 10.9px size. */
.dnat .faqA-n{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50px;border:1.5px solid var(--clay);color:var(--clay-t);font-size:.68rem;font-weight:700;flex:none;font-variant-numeric:tabular-nums;}
.dnat .faqA-q{font-family:var(--font-lora,'Newsreader',serif);font-size:1rem;font-weight:600;flex:1;line-height:1.32;}
.dnat .faqA-v{width:11px;height:11px;flex:none;border-right:2px solid var(--clay-ink);border-bottom:2px solid var(--clay-ink);transform:rotate(45deg) translate(-2px,-2px);transition:transform .2s;}
.dnat .faqA-item[open] .faqA-v{transform:rotate(225deg) translate(-2px,-2px);}
.dnat .faqA-item[open] summary{border-bottom:1px solid var(--bd);background:#fdf7f4;}
.dnat .faqA-item p{color:#4a423b;font-size:.9rem;margin:0;padding:14px 18px 16px;max-width:70ch;line-height:1.62;}

/* Contact form */
.dnat .cta-form{display:grid;grid-template-columns:.85fr 1.15fr;gap:0;border:1px solid var(--bd);border-radius:16px;overflow:hidden;margin:1rem 0;}
.dnat .form-side{background:var(--green-d);color:#eaf3ee;padding:22px;}
.dnat .form-side h3{color:#fff;margin:0 0 .4rem;}
.dnat .form-side p{color:#d7e7de;font-size:.86rem;}
.dnat .form-birds{list-style:none;margin:.8rem 0;padding:0;}
.dnat .form-birds li{display:flex;justify-content:space-between;gap:.6rem;padding:.4rem 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:.85rem;}
.dnat .form-birds b{color:#fff;}
.dnat .form-ship{font-size:.78rem;color:#c9f2db;}
.dnat .form-ship b{color:#fff;}
.dnat .form-main{padding:22px;background:#fff;display:grid;gap:.7rem;}
.dnat .form-main label{display:grid;gap:.25rem;min-width:0;font-size:.82rem;font-weight:600;color:var(--green-d);}
.dnat .form-main input,.dnat .form-main textarea{font:inherit;font-size:16px;font-weight:400;padding:.55rem .65rem;border:1px solid var(--bd);border-radius:10px;background:var(--cream);color:var(--ink);width:100%;max-width:100%;box-sizing:border-box;min-width:0;}
/* Selects carry the same box as the inputs, plus right padding for the native
   chevron — the placeholder option used to run underneath it and read as cut off. */
.dnat .form-main select{font:inherit;font-size:16px;font-weight:400;padding:.55rem .65rem;border:1px solid var(--bd);border-radius:10px;background:var(--cream);color:var(--ink);width:100%;max-width:100%;box-sizing:border-box;min-width:0;padding-right:2.1rem;text-overflow:ellipsis;}
.dnat .f2{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;}
.dnat .btn-submit{border-radius:12px;justify-content:center;margin-top:.3rem;}
.dnat .form-note{font-size:.74rem;color:var(--muted);font-weight:400;margin:0;}
.dnat .hp{position:absolute;left:-9999px;}

/* ===================== RESPONSIVE ===================== */
@media (max-width:980px){
  .dnat .hero-grid{grid-template-columns:1fr;gap:18px;}
  /* photos lead on mobile, copy follows — matching the sibling for-sale heroes */
  .dnat .hero-mosaic{order:-1;max-width:460px;margin:0 auto;}
  .dnat .mtile.anchor img{aspect-ratio:4/3;}
  .dnat .hero-metrics{max-width:none;}
  .dnat .counter-grid{grid-template-columns:repeat(3,1fr);}
  /* minmax(0,1fr) + min-width:0 stop the 100vw full-bleed images inflating the track */
  .dnat .body-grid{grid-template-columns:minmax(0,1fr);}
  .dnat .content{min-width:0;}
  .dnat .dial{display:none;}
  .dnat .availB{grid-template-columns:minmax(0,1fr);}
  .dnat .availB-side{position:static;}
  .dnat .side-filters{flex-direction:row;flex-wrap:wrap;}
  .dnat .side-f{width:auto;}
  .dnat .availB-grid{grid-template-columns:repeat(2,1fr);}
  .dnat .rev-grid,.dnat .read-cards,.dnat .geo-cards{grid-template-columns:minmax(0,1fr);}
  .dnat .cta-form{grid-template-columns:minmax(0,1fr);}
  .dnat .ccrow{grid-template-columns:minmax(0,1fr);gap:5px;}
  .dnat .ccg{padding-top:0;}
  /* Rail A — sticky UNDER the site header (96px), clay outlined pills */
  .dnat .railA{display:block;position:sticky;top:var(--hdr);z-index:40;background:rgba(250,247,244,.985);border-bottom:1px solid var(--bd);box-shadow:0 6px 14px rgba(60,30,10,.07);}
  .dnat .railA ul{display:flex;gap:7px;overflow-x:auto;list-style:none;margin:0;padding:.45rem .75rem;scroll-behavior:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .dnat .railA ul::-webkit-scrollbar{display:none;}
  .dnat .railA a{display:inline-flex;align-items:center;gap:.35rem;font-size:.76rem;font-weight:600;color:var(--clay-t);border:1.5px solid var(--clay);border-radius:50px;padding:7px 14px;text-decoration:none;background:#fff;white-space:nowrap;scroll-margin-inline:20px;min-height:36px;}
  .dnat .railA a.on{background:var(--clay-ink);border-color:var(--clay-ink);color:#fff;}
  .dnat .railA .p{font-weight:700;font-variant-numeric:tabular-nums;}
  /* anchors must clear BOTH the header (96px) and the sticky rail (~54px) + gap */
  .dnat .sec{scroll-margin-top:calc(var(--hdr) + 66px);}
}
@media (max-width:640px){
  .dnat .dn-container{padding:0 16px;}
  .dnat .counter-grid{grid-template-columns:repeat(2,1fr);}
  .dnat .hero-metrics li{min-width:0;padding:8px 10px;}
  .dnat .hero-metrics b{font-size:1rem;}
  .dnat .availB-grid{grid-template-columns:1fr 1fr;gap:10px;}
  .dnat .bblurb{display:none;}
  .dnat .binfo{padding:9px 9px 11px;gap:.4rem;}
  .dnat .brow{min-height:2.5rem;}
  .dnat .brow h3{font-size:.92rem;}
  .dnat .bprice{font-size:.92rem;}
  .dnat .bfull{align-self:stretch;font-size:.74rem;padding:.5rem .55rem;}
  .dnat .bchips span{font-size:.58rem;}
  .dnat .bbadge{font-size:.55rem;padding:.15rem .42rem;}
  .dnat .seam-wrap{gap:12px;margin:24px auto 22px;}
  .dnat .seam{height:30px;}
  .dnat .f2{grid-template-columns:1fr;}
  .dnat .ticket-cta{font-size:.86rem;padding:.5rem .9rem;line-height:1.35;}

  /* ===== Mobile table stacking — both tables become cards, keeping the desktop look ===== */
  .dnat .tblwrap{overflow-x:visible;}
  .dnat .tblD,.dnat .tblA{border:0;border-radius:0;overflow:visible;background:transparent;}
  .dnat .tblD-cap{border-radius:10px;margin-bottom:10px;}
  .dnat .tblD thead,.dnat .tblA thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  .dnat .tblD tbody,.dnat .tblD tr,.dnat .tblD td,
  .dnat .tblA tbody,.dnat .tblA tr,.dnat .tblA td{display:block;}
  .dnat .tblD tr,.dnat .tblA tr{border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:#fff;margin-bottom:10px;}
  .dnat .tblD tr:last-child,.dnat .tblA tr:last-child{margin-bottom:0;}
  .dnat .tblD td,.dnat .tblA td{padding:.55rem .8rem;border-bottom:1px solid var(--bd);}
  .dnat .tblD tr td:last-child,.dnat .tblA tr td:last-child{border-bottom:0;}
  /* first cell becomes the card's header band, mirroring the desktop header row */
  .dnat .tblD td:first-child,.dnat .tblA td:first-child{background:var(--cream);color:var(--green-d);font-weight:700;font-size:.92rem;padding:.6rem .8rem;border-bottom:2px solid var(--bd);white-space:normal;}
  .dnat .tblD td[data-label]:not(:first-child),.dnat .tblA td[data-label]:not(:first-child){display:grid;grid-template-columns:minmax(0,6.6rem) minmax(0,1fr);gap:.55rem;align-items:baseline;}
  .dnat .tblD td[data-label]:not(:first-child)::before,.dnat .tblA td[data-label]:not(:first-child)::before{content:attr(data-label);font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);line-height:1.6;}

  /* Mobile full-bleed section images.
     INFOGRAPHICS keep native 16:9 and are NEVER cover-cropped — the 5:4 cover frame
     shaved ~30% off the hand-raised set and cut its baked-in text.
     Only real OG PHOTOS take the taller 4:5 frame (IMAGE-DESIGNS §7 blurfill). */
  .dnat .sec-img{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);border-radius:0;border-left:0;border-right:0;}
  .dnat .sec-img.inf-img{aspect-ratio:1408/768;object-fit:contain;background:#fff;}
  .dnat .sec-img.og-photo{aspect-ratio:4/5;object-fit:cover;background:transparent;}
}

/* Compact newsletter band (2026-07-26). The input min-width:200px forced a wrap on
   mobile, leaving a button narrower than the field above it — a ragged left-edge
   stack. Below 560px both go full width so the block reads as one column. */
@media(max-width:560px){
  .dnat .fs-nl-form{flex-direction:column;}
  .dnat .fs-nl-form input,.dnat .fs-nl-form button{width:100%;min-width:0;}
}
</style>
