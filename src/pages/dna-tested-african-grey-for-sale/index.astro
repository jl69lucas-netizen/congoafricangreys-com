---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import clutch from '../../../data/clutch-inventory.json';

// ============================================================================
//  /dna-tested-african-grey-for-sale/  — for-sale cluster page 6
//  Tuple (distinct from egg/congo/timneh/hand-raised — sessions/2026-07-19-for-sale-component-map.md):
//    Hero-C Mosaic Metrics · Dial 1 clay-on-cream + Rail A clay pills · T2 Chip Cloud
//    · K4 Clipboard + K5 Capsule · NEW Table D "Lab Report" + Table A · FAQ-A refreshed
//    (numbered clay chip + chevron, not the +/x cross) · Avail-B faceted by CONFIRMED SEX
//  Angle: "Proof, Not Guesswork" — myth-bust -> method -> certificate -> bird
//  Blend: PDB (opening third) x EEBP (spine) x QAB (FAQ) x FAB (certificate/spec rows)
//  Voice lever: this page says HEN / COCK where siblings say male / female.
//  H6 prefixes reserved to this page: "From the Lab:" and "On the Record:".
//  Prose written fresh from sessions/2026-07-24-dna-tested-sprint1-blueprint.md §3
//  (Write-From-Outline — nothing paraphrased from a sibling; the reviews are whitelist).
// ============================================================================

const title = "DNA-Tested African Grey Parrots for Sale — Every Hen and Cock Lab-Confirmed | How Do You Sex an African Grey Parrot? | 6 Documented Psittacus erithacus Greys Reservable | C.A.Gs, Midland TX — Avian DNA Sexing Certificate, PCR Feather or Blood Assay, CITES Papers";
const description = "DNA-tested African Grey parrots for sale with the laboratory result already in hand — never 'DNA pending'. Avian DNA sexing by PCR names the hen or cock before we list a bird, certificate $40–$60. USDA-licensed Midland, TX family aviary; the band number matches every result. Ask us today.";
const canonical = "https://congoafricangreys.com/dna-tested-african-grey-for-sale/";

const IMG = "/images/dna-tested-page/";
const HR = "/images/hand-raised-page/";
const site = "https://congoafricangreys.com";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "African Greys for Sale", url: "/african-grey-parrots-for-sale/" },
  { name: "DNA-Tested African Greys for Sale", url: "/dna-tested-african-grey-for-sale/" },
];

// Real inventory. Avail-B facets by CONFIRMED SEX on this page (siblings facet by
// subspecies / variant) — the filter itself carries the page's argument.
const available = ((clutch as any).birds as any[]).filter((b) => b.status === "available");
const sexKey = (b: any) => (b.sex === "pair" ? "pair" : b.sex === "female" ? "hen" : "cock");
const sexLabel = (b: any) => (b.sex === "pair" ? "Cock + Hen" : b.sex === "female" ? "Hen" : "Cock");
const subLabel = (b: any) => (b.variant === "timneh_african_grey" ? "Timneh" : "Congo");
const sexCount = (k: string) => available.filter((b) => sexKey(b) === k).length;

// `badge:"top"` lifts the sex pill off a head-down bird's face (the Roys lesson).
const birdImg: Record<string, { src: string; alt: string; pos: string; badge?: "top" }> = {
  "Bery":  { src: "/images/congo-page/bery-congo-african-grey-female-card.webp", pos: "center 30%", alt: "Bery, a lab-confirmed Congo African Grey hen for sale, perched and looking to camera" },
  "Amie":  { src: "/images/congo-page/amie-congo-african-grey-female-card.webp", pos: "center 28%", alt: "Amie, a young Congo hen whose DNA sexing result was back before we listed her" },
  "Roys":  { src: "/images/congo-page/roys-congo-african-grey-male-card.webp",   pos: "center 30%", alt: "Roys, a Congo cock identified by PCR assay rather than by his tail feathers", badge: "top" },
  "Jins & Jeni (Pair)": { src: "/images/congo-page/jins-jeni-congo-african-grey-pair-card.webp", pos: "center 32%", alt: "Jins and Jeni, one Congo cock and one Congo hen, indistinguishable side by side" },
  "Elad":  { src: "/images/timneh-page/elad-timneh-african-grey-male-card.webp", pos: "center 34%", alt: "Elad, a maroon-tailed Timneh cock with his sexing certificate on file" },
  "Evie":  { src: "/images/timneh-page/evie-timneh-african-grey-female-card.webp", pos: "center 38%", alt: "Evie, a Timneh hen whose sex was settled by a feather sample rather than a guess" },
};
const birdBlurb: Record<string, string> = {
  "Bery": "Congo hen, result on file since her first moult — steady, unhurried, easy to read.",
  "Amie": "Congo hen, young and quick; her assay came back before her photographs went up.",
  "Roys": "Congo cock, and nothing about his tail told us that — the laboratory did.",
  "Jins & Jeni (Pair)": "One cock, one hen, sold together. Look at them and you still cannot tell which is which.",
  "Elad": "Timneh cock out of Levi and Rily, confirmed by assay rather than by eye.",
  "Evie": "Timneh hen, gentle and deliberate; her feather sample answered the question at once.",
};

// Hero-C mosaic. Anchor cell = the real pair (unused elsewhere in the cluster):
// one cock, one hen, visually identical — this page's whole thesis in one photograph.
const mosaic = [
  { src: IMG + "hero-grey-tile-a.webp", small: IMG + "hero-grey-tile-a-260.webp", tag: "Cock or hen?", alt: "A Congo African Grey photographed head-on, offering no visible clue to its sex", pos: "center 22%" },
  { src: IMG + "hero-grey-tile-b.webp", small: IMG + "hero-grey-tile-b-260.webp", tag: "Cock or hen?", alt: "Close view of a grey parrot's head and chest feathering, which carries no sex marker", pos: "center 20%" },
  { src: IMG + "hero-grey-tile-c.webp", small: IMG + "hero-grey-tile-c-260.webp", tag: "Cock or hen?", alt: "A red-tailed Congo grey on a branch, the red tail being no indicator of sex", pos: "center 18%" },
];

// Counter strip — 6, all Ledger-verified or laboratory-published (skill §2f)
const counters = [
  { n: "~99%", l: "Published assay accuracy" },
  { n: "1–2 Days", l: "Laboratory turnaround" },
  { n: "$40–60", l: "Certificate, priced openly" },
  { n: "0", l: "Greys we sex by eye" },
  { n: "12+ Yrs", l: "Aviary in Midland, TX" },
  { n: "24h", l: "We answer, personally" },
];

// T2 Chip Cloud — grouped in-body TOC (this page's TOC slot)
const chipGroups = [
  { g: "Settle it", chips: [ { h: "#myth", t: "The looking myth" }, { h: "#monomorphic", t: "Monomorphic biology" }, { h: "#method", t: "How the assay runs" } ] },
  { g: "Prove it", chips: [ { h: "#certificate", t: "Inside a certificate" }, { h: "#cost", t: "What it costs" }, { h: "#onesample", t: "One sample, two answers" }, { h: "#pending", t: "Pending listings" } ] },
  { g: "Buy it", chips: [ { h: "#available", t: "Reservable greys" }, { h: "#floor", t: "Price floor" }, { h: "#shipping", t: "Getting your grey home" }, { h: "#reserve", t: "Ask about a grey" } ] },
];

// DISTINCT geo set vs egg/congo/timneh/hand-raised (cannibalization guard); real live slugs.
const shipPlaces = [
  { href: "/african-grey-parrot-for-sale-washington/", label: "DNA-sexed African Greys for sale Washington", note: "Sea-Tac live-animal cargo" },
  { href: "/african-grey-parrot-for-sale-colorado/", label: "Lab-confirmed grey parrots Colorado", note: "Denver International desk" },
  { href: "/african-grey-parrot-for-sale-missouri/", label: "DNA sexing certificate greys Missouri", note: "St. Louis Lambert route" },
  { href: "/african-grey-parrot-for-sale-oregon/", label: "Sexed African Grey parrots Oregon", note: "Portland cargo counter" },
  { href: "/african-grey-parrot-for-sale-kentucky/", label: "Buy a DNA-tested African Grey Kentucky", note: "Louisville hub" },
  { href: "/african-grey-parrot-for-sale-iowa/", label: "Confirmed hens and cocks Iowa", note: "Des Moines pickup route" },
  { href: "/african-grey-parrot-for-sale-arizona/", label: "African Greys with lab results Arizona", note: "Phoenix Sky Harbor" },
  { href: "/african-grey-parrot-for-sale-tennessee/", label: "DNA-tested grey parrots Tennessee", note: "Nashville cargo desk" },
];

// Real, breeder-supplied reviews. The ONE whitelisted verbatim crossover on this page.
const stories = [
  { name: "Stanley Perkin", loc: "Oceanside, CA 92054", meta: "Verified C.A.Gs buyer",
    avatar: HR + "stanley-perkin-oceanside-ca-african-gray-bird-review.webp",
    quote: "If you're looking for an african gray bird for sale, I highly recommend C.A.Gs. My bird arrived exactly as promised — healthy, curious, and already comfortable around people. The updates throughout the process and the professionalism of the C.A.Gs team gave me complete confidence. It's rare to find a breeder that truly cares about both the birds and their customers." },
  { name: "Jesse Ovalle", loc: "Baton Rouge, LA 70806", meta: "Verified C.A.Gs buyer",
    avatar: HR + "jesse-ovalle-baton-rouge-la-african-grey-purchase-review.webp",
    quote: "My African grey parrot purchase through C.A.Gs couldn't have gone better. Every question I had was answered promptly, and I received regular updates before my bird arrived. My African Grey is healthy, intelligent, and already becoming a wonderful member of our family. The quality of care and customer service from C.A.Gs exceeded my expectations." },
];

const readMore = [
  { href: "/male-vs-female-african-grey-parrots-for-sale/", img: IMG + "why-visual-sexing-african-grey-fails", kicker: "Hen or cock", title: "Male vs female African Grey parrots", sub: "Once the laboratory has answered the question, this weighs what the answer actually predicts." },
  { href: "/how-to-avoid-african-grey-parrot-scams/", img: IMG + "dna-pending-versus-result-in-hand", kicker: "Scam guide", title: "How to avoid African Grey parrot scams", sub: "Where a certificate claim sits among the other tells a fraudulent listing gives off." },
  { href: "/african-greys-for-sale-with-health-guarantee/", img: IMG + "one-sample-sex-and-disease-screening", kicker: "Health", title: "African Greys with a health guarantee", sub: "What the PCR disease panel covers, and what we put in writing once results are back." },
  { href: "/african-grey-parrot-price/", img: IMG + "certificate-does-not-justify-sub-floor-price", kicker: "Pricing", title: "African Grey price, itemised", sub: "Every line behind the figure — testing included — and why the floor sits where it does." },
];

// QAB — the 10 PAA targets mined in Sprint 0 §4 and the live SERP
const faqs = [
  { q: "Can you tell if an African Grey is male or female just by looking?", a: "No, and this is the single most repeated piece of bad advice about the species. Greys are monomorphic: hens and cocks carry the same plumage, the same red or maroon tail and the same face mask, for life. Body size, eye shape, head shade and tail tipping all vary between individuals and with age, so they will happily let you build a confident guess that turns out wrong. Only two things settle it — a laboratory assay, or an egg." },
  { q: "How accurate is DNA sexing in parrots?", a: "Laboratories publish accuracy of approximately 99 percent, and that is the figure we quote. It is not 100 percent, and any seller advertising 99.9 percent is out-claiming the laboratories themselves. Errors are rare and usually trace back to a contaminated or insufficient sample rather than to the assay, which is why a clean pull matters. If a result ever contradicted a bird's later behaviour — a supposed cock laying an egg — a repeat test settles it." },
  { q: "Does bird DNA sexing use blood or feathers?", a: "Both work. The laboratory we use accepts blood, feather and eggshell samples and states plainly that all are equally reliable. A feather sample means plucking a few chest feathers so the pulp at the base comes away with them; a blood sample is a single drop taken from the tip of a toenail. We submit whichever suits the individual bird on the day, and for a very young chick the feather route is usually the gentler one." },
  { q: "How long do DNA sexing results take to come back?", a: "The laboratory publishes one to two business days from the moment the sample reaches them. In practice you should add the post in both directions, so a fortnight from pulling the feather to holding the paper is a fair expectation. Owner threads quoting one to two weeks are usually counting the vet appointment and the mail rather than the assay itself." },
  { q: "How much does DNA sexing an African Grey cost?", a: "Per-sample laboratory fees advertised publicly sit in the region of $17 to $25. Our certificate is $40 to $60, and that gap is deliberate rather than a markup for its own sake: it covers taking the sample cleanly, the courier both ways, the assay, and issuing a certificate tied to the bird's closed band number. We publish the figure rather than folding it silently into the price of the grey." },
  { q: "Do red tail feathers mean an African Grey is male?", a: "They do not. Every healthy Congo African Grey carries a red tail and every Timneh a maroon one, whatever their sex. The claim circulates because a page-one search result states it outright, and thousands of owners have acted on it. Silver tipping along the tail, a paler head and rounder eyes belong to the same folklore — real variations that simply do not track sex." },
  { q: "Can an avian vet sex an African Grey without a DNA test?", a: "A vet can perform surgical sexing under anaesthetic, which visualises the gonads directly, and it was standard practice before molecular testing became cheap. Almost nobody does it on a companion grey now, because it carries anaesthetic risk for an answer a plucked feather gives just as reliably. What a vet cannot do is look at a clothed, conscious grey and tell you its sex." },
  { q: "What does a DNA sexing certificate actually say on it?", a: "A legitimate one names the bird, records the closed band number, states the species, records the sample type and the method, gives the result, carries a date and comes from a named laboratory. The band number is the field that matters most, because it is the only line tying the paper to the parrot standing in front of you. A certificate with no identifier proves that some bird was tested — just not necessarily yours." },
  { q: "Are male African Greys better talkers than females?", a: "The evidence for that is thin, and we have watched it fail in our own aviary often enough to stop repeating it. Individual temperament, how much a household talks, and how early the bird was socialised all predict vocabulary far better than sex does. Knowing you have a hen tells you what to name her and what to expect if she ever lays; it does not tell you how much she will say." },
  { q: "Can the same feather sample also screen for disease?", a: "Yes, and it is the most useful thing we can tell you on this page. The same sample type that answers the sex question runs the PCR panels for psittacine beak and feather disease and avian polyomavirus, both of which we screen for. One pull, one courier, three answers — which is why it is worth asking any seller whether they ran the disease panel while they had the sample in hand." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

const productSchema = {
  "@context": "https://schema.org", "@type": "Product",
  name: "DNA-Tested African Grey Parrot for Sale (Sex Confirmed by an Avian Laboratory)",
  image: [ site + IMG + "jins-jeni-cock-and-hen-hero-anchor.webp", site + IMG + "anatomy-of-a-dna-sexing-certificate.webp" ],
  description: "A DNA-sexed African Grey parrot from C.A.Gs, a USDA-licensed family aviary in Midland, Texas. Every hen and cock is confirmed by avian DNA sexing (PCR on a feather or blood sample) before listing, with the certificate tied to the bird's closed band number. Captive-bred, CITES Appendix I documented, PBFD and avian polyomavirus PCR-screened.",
  category: "Companion parrot",
  brand: { "@type": "Organization", name: "C.A.Gs – Midland, TX" },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.9", reviewCount: "52" },
  review: stories.map((s) => ({ "@type": "Review", author: { "@type": "Person", name: s.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" }, reviewBody: s.quote })),
  offers: { "@type": "AggregateOffer", lowPrice: "1500", highPrice: "3500", priceCurrency: "USD", offerCount: String(available.length),
    availability: "https://schema.org/InStock", url: canonical,
    seller: { "@type": ["Organization", "LocalBusiness"], name: "C.A.Gs – Midland, TX", alternateName: "Congo African Greys" } },
};
const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  itemListElement: available.map((b, i) => ({ "@type": "ListItem", position: i + 1,
    item: { "@type": "Product", name: b.name.replace(" (Pair)", "") + " — DNA-Confirmed " + subLabel(b) + " " + sexLabel(b), category: "Companion parrot",
      offers: { "@type": "Offer", price: String(b.price), priceCurrency: "USD",
        availability: "https://schema.org/InStock", url: site + b.slug } } })) };

// Dial 1 spine. IDs map to the approved H1–H6 outline (blueprint §3).
const sections = [
  { n: "01", id: "myth",        label: "Can you tell by looking?", tag: "Myth" },
  { n: "02", id: "monomorphic", label: "Monomorphic biology",      tag: "Z & W" },
  { n: "03", id: "method",      label: "How the assay works",      tag: "PCR" },
  { n: "04", id: "certificate", label: "Inside a certificate",     tag: "7 fields" },
  { n: "05", id: "available",   label: "Confirmed greys now",      tag: available.length + " birds" },
  { n: "06", id: "cost",        label: "What the paper costs",     tag: "$40–60" },
  { n: "07", id: "onesample",   label: "One sample, two answers",  tag: "PBFD" },
  { n: "08", id: "pending",     label: "Pending listings",         tag: "Wait" },
  { n: "09", id: "floor",       label: "Badges and cheap greys",   tag: "$1,500" },
  { n: "10", id: "behaviour",   label: "Does sex change the bird?", tag: "Little" },
  { n: "11", id: "legal",       label: "Owning one legally",       tag: "CITES" },
  { n: "12", id: "shipping",    label: "Getting your grey home",   tag: "$185/$350" },
  { n: "13", id: "reviews",     label: "What buyers told us",      tag: "5★" },
  { n: "14", id: "video",       label: "A pair on camera",         tag: "Video" },
  { n: "15", id: "compare",     label: "Us vs page-one sellers",   tag: "Receipts" },
  { n: "16", id: "reading",     label: "Read next",                tag: "" },
  { n: "17", id: "faq",         label: "Questions buyers ask",     tag: "10 Q" },
  { n: "18", id: "reserve",     label: "Ask about a grey",         tag: "24h" },
];
const N = sections.length;

// Table D "Lab Report" — the seven fields a legitimate certificate carries (NEW to this page)
const certFields = [
  { f: "Bird name", w: "The name the breeder listed the grey under", why: "Ties the paper to a listing you can point at" },
  { f: "Closed band number", w: "The unique number on the ring fitted at a few weeks old", why: "The only field tying paper to parrot — check it against the leg" },
  { f: "Species", w: "Psittacus erithacus, or Psittacus timneh for a Timneh", why: "Confirms the laboratory ran a grey, not a generic bird panel" },
  { f: "Sample type", w: "Feather, blood or eggshell", why: "Tells you how the material was taken, and by whom" },
  { f: "Method", w: "PCR — polymerase chain reaction, reading the Z and W chromosomes", why: "Separates a molecular assay from a visual opinion" },
  { f: "Result", w: "Male or female, stated without hedging", why: "A hedged result is not a result" },
  { f: "Date and issuing laboratory", w: "When the assay ran, and who signed it off", why: "Lets you ring the laboratory and confirm the record exists" },
];

// Table A — what page-one sellers claim vs what they publish (Sprint 0 §3 receipts)
const compareRows = [
  { k: "Names the testing laboratory", us: "Yes — Avian Biotech, now part of Animal Genetics", them: "No laboratory named on any page-one listing we checked" },
  { k: "States the sample type", us: "Feather or blood, stated per bird", them: "Not stated anywhere" },
  { k: "Publishes an accuracy figure", us: "Approximately 99%, matching the labs", them: "Silent, or claiming 99.9%" },
  { k: "Prices the certificate", us: "$40–$60, itemised separately", them: "“Included”, with no figure given" },
  { k: "Lists birds before results return", us: "Never — result in hand, or it is not listed", them: "“DNA pending” listings observed" },
  { k: "Lowest Congo price advertised", us: "A $1,500 floor", them: "$750–$820 under a certificate badge" },
];

const seam = "/cag-fs-seam-emblem.webp";
const deposit = "$200";
const schemaGraph = JSON.stringify({ "@context": "https://schema.org", "@graph": [productSchema, itemListSchema, faqSchema] });
const ogExtra = `<meta property="og:image" content="${site}${IMG}jins-jeni-cock-and-hen-hero-anchor.webp">`;
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="product" hideGlobalCta={true} schemaJson={schemaGraph} heroPreload={IMG + "jins-jeni-cock-and-hen-hero-anchor.webp"} heroPreloadSrcset={IMG + "jins-jeni-cock-and-hen-hero-anchor-440.webp 440w, " + IMG + "jins-jeni-cock-and-hen-hero-anchor-690.webp 690w, " + IMG + "jins-jeni-cock-and-hen-hero-anchor.webp 880w"} heroPreloadSizes="(max-width:980px) 92vw, 420px" extraHeadHtml={ogExtra}>

  <main class="dnat">
    <div class="dn-container"><Breadcrumb items={breadcrumbs} /></div>

    <!-- ===================== HERO-C · MOSAIC METRICS ===================== -->
    <header class="hero">
      <div class="hero-grid dn-container">
        <div class="hero-copy">
          <p class="eyebrow"><em>Psittacus erithacus</em> · Midland, TX · USDA-licensed family aviary since 2014</p>
          <ul class="hero-metrics" aria-label="Sexing at a glance">
            <li><b>1–2 days</b><span>Lab turnaround</span></li>
            <li><b>~99%</b><span>Assay accuracy</span></li>
            <li><b>{available.length}</b><span>Confirmed greys</span></li>
          </ul>
          <h1>DNA-Tested African Grey Parrots for Sale — Every Hen and Cock <em>Confirmed by an Avian Lab</em>, Not a Guess</h1>
          <p class="lead">Here at C.A.Gs we do not guess at a grey's sex, and we do not ask you to. Every captive-bred African Grey on this page had a feather or blood sample run by an avian genetics laboratory, and the result was back in our hands before the bird was ever photographed for sale.</p>
          <div class="hero-cta">
            <a class="btn btn-clay" href="#available">See the confirmed greys →</a>
            <a class="btn btn-ghost" href="#method">How the assay works</a>
          </div>
        </div>
        <div class="hero-mosaic">
          <figure class="mtile anchor">
            <img src={IMG + "jins-jeni-cock-and-hen-hero-anchor.webp"}
                 srcset={IMG + "jins-jeni-cock-and-hen-hero-anchor-440.webp 440w, " + IMG + "jins-jeni-cock-and-hen-hero-anchor-690.webp 690w, " + IMG + "jins-jeni-cock-and-hen-hero-anchor.webp 880w"}
                 sizes="(max-width:980px) 92vw, 420px"
                 alt="Jins and Jeni, one Congo African Grey cock and one hen side by side, visually identical" width="880" height="660" loading="eager" fetchpriority="high" />
            <figcaption><b>Jins &amp; Jeni</b><span>One cock, one hen · $3,500</span></figcaption>
          </figure>
          {mosaic.map((m) => (
            <figure class="mtile">
              <img src={m.src} srcset={m.small + " 260w, " + m.src + " 520w"} sizes="(max-width:980px) 30vw, 134px"
                   alt={m.alt} width="520" height="520" loading="lazy" style={"object-position:" + m.pos} />
              <figcaption class="q">{m.tag}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </header>

    <!-- ===================== COUNTER STRIP ===================== -->
    <section class="counter" aria-label="DNA sexing at a glance">
      <div class="dn-container counter-grid">
        {counters.map((c) => (<div class="cstat"><span class="cn">{c.n}</span><span class="cl">{c.l}</span></div>))}
      </div>
    </section>

    <!-- Rail A (mobile) — outlined clay pills, sticky UNDER the site header -->
    <nav class="railA" aria-label="Jump to section">
      <ul>
        {sections.map((s) => (<li><a href={"#" + s.id} data-id={s.id}><span class="p">{s.n}</span> {s.label}</a></li>))}
      </ul>
    </nav>

    <!-- ===================== BODY: DIAL 1 SIDEBAR + CONTENT ===================== -->
    <div class="dn-container body-grid">

      <aside class="dial" aria-label="Section progress">
        <div class="dial-card">
          <div class="ring" id="dialRing" style="--p:0">
            <div class="ring-in"><span class="ring-n" id="dialNum">01</span><span class="ring-of">of {N}</span></div>
          </div>
          <ul class="dial-list" id="dialList">
            {sections.map((s) => (
              <li><a href={"#" + s.id} data-id={s.id}><span class="di">{s.n}</span><span class="dh">{s.label}</span>{s.tag && <span class="dt">{s.tag}</span>}</a></li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="content">

        <!-- ===== K4 CLIPBOARD + K5 CAPSULE ===== -->
        <div class="k4">
          <div class="k4-head"><span class="k4-clip" aria-hidden="true"></span><b>The short answer</b></div>
          <ul class="k4-list">
            <li>African Greys are monomorphic — a hen and a cock look the same for life, so nobody can sex your bird by eye.</li>
