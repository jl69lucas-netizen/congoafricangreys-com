---
/**
 * cag-owner-card — "About the Breeder" · Variant B (one-photo founder story)
 * Compact single-photo + tight H-S-S narrative. Verified facts only · CITES Appendix I · C.A.Gs voice.
 * Photo framed via object-position (real breeder photo — never AI-altered).
 */
interface Props {
  storyHref?: string;
  storyLabel?: string;
  /** H2 text. Default = the original. */
  heading?: string;
  /** Story paragraphs (plain text, rendered escaped). Default = the original two. */
  story?: string[];
  /** Signature line under the story. Default = the original. */
  signature?: string;
  /** Credential chips. Default = the original four. */
  chips?: string[];
}
const {
  storyHref = "/trusted-african-grey-parrot-breeders/",
  storyLabel = "Our Breeder Story →",
  heading = "Who Are the Breeders Behind C.A.Gs?",
  story = [
    "We started raising African Greys in our Midland, Texas home in 2014 — because we could not stand how many were sold sick, undocumented, or shipped from people the buyer would never meet. So C.A.Gs became the opposite: every chick is hand-fed inside our home, never warehoused in a back-room facility.",
    "Every Grey we raise is DNA-sexed, examined by an avian veterinarian, closed-banded, and CITES Appendix I documented before it leaves us — and you hold that paperwork before any money changes hands. A decade on, the principle is unchanged: raise fewer birds, raise them right, and stay reachable long after pickup.",
  ],
  signature = "— Mark & Teri Benjamin, C.A.Gs",
  chips = ["USDA AWA Licensed", "CITES Appendix I", "DNA Sexed", "Avian-Vet Certified"],
} = Astro.props;

// Literal newlines so the default render stays byte-identical to the pre-prop markup (compressHTML).
const NL = "\n";
const photo = "/about-mark-teri-benjamin-african-grey-breeders-midland-tx.webp";
const photoAlt =
  "Mark Benjamin of C.A.Gs in Midland, Texas hand-feeding a captive-bred Congo African Grey chick — the USDA AWA–licensed, DNA-sexed, CITES Appendix I hand-rearing behind every Grey we place.";

---

<section id="about" class="owner-card scroll-mt-20 bg-cream py-14 px-4 md:py-16">
  <div class="container mx-auto max-w-[1100px]">
    <div class="grid overflow-hidden rounded-[24px] border border-black/[0.07] bg-white md:grid-cols-[0.85fr_1.15fr]" style="box-shadow:0 14px 44px rgba(60,30,10,0.10);">

      <!-- one photo (framed) -->
      <div class="relative">
        <img src={photo} alt={photoAlt} width="600" height="600" loading="lazy" decoding="async"
             class="h-60 w-full object-cover md:h-full" style="object-position:50% 36%;" />
        <span class="font-sora absolute bottom-3 left-3 rounded-full bg-white/95 px-3.5 py-1.5 text-xs font-semibold text-green shadow">
          Mark &amp; Teri Benjamin · Est. 2014
        </span>
      </div>

      <!-- founder story (tight) -->
      <div class="p-7 md:p-9">
        <p class="font-sora text-xs font-bold uppercase tracking-[0.16em] text-clay">Meet the Breeders</p>
        <h2 class="font-lora mt-2 text-2xl font-bold leading-tight text-logo-dark md:text-[2rem]">{NL}{heading}{NL}</h2>

        <div class="mt-4 space-y-3.5 text-[15px] leading-relaxed text-stone-600" style="max-width:62ch;">
          {story.map((para, i) => (<Fragment>{i > 0 && " "}<p>{para}</p></Fragment>))}
        </div>

        <p class="font-lora mt-4 text-[15px] italic text-green">{signature}</p>

        <div class="mt-5 flex flex-wrap gap-2">
          {chips.map((c) => (
            <span class="font-sora rounded-full border border-green/20 bg-green/[0.06] px-3 py-1 text-xs font-semibold text-green">✓ {c}</span>
          ))}
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={storyHref} class="font-sora rounded-full bg-clay px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-clay-dk">{storyLabel}</a>
          <a href="#contact" class="font-sora rounded-full bg-clay px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-clay-dk">Ask About Birds →</a>
        </div>
      </div>

    </div>
  </div>
</section>
