---
import { srcsetAttrs } from '../../lib/srcset';
/**
 * cag-hero-v3:b — "Authority Green"
 * Source design: UNIQUE CAGs NEW COMPONENTS.zip → standalone/Hero B - Authority Green.html
 * Ported to the site's Tailwind tokens. Trust-first forest-green hero with a circular
 * framed bird photo, ring accent, floating availability pill, eyebrow + trust pills.
 * Content corrected to contract: C.A.Gs voice · CITES Appendix I · real photo · no phone.
 * Single consumer: `/` (homepage) — the `#proof` link only resolves there.
 *
 * Contrast (2026-09-09): the copy column sits on an opaque dark-green scrim (#0f3d2c, the
 * same bed as the image stage) so the clay H1 span reads 3.6:1 (large text needs 3:1);
 * every other text colour is a full-opacity tint pre-blended over that scrim, because
 * a11y-text-contrast-aa cannot judge translucent foregrounds (Tailwind emits oklab()).
 * The lead paragraph carries its colour INLINE: two `h1 + p` rules (body.theme-d in the
 * layout, .home-d on the page) force ink !important and both exempt only [style*=color].
 */
interface Props {
  availableCount?: number;
}
const { availableCount = 8 } = Astro.props;

// heroImg and the sizes="300px" on its <img> are a pair, measured against the 220/260/300
// circular stage. The homepage preload derives from the same srcsetFor(heroImg, [300]) call —
// keep them in step.
const heroImg = "/african-grey-parrot-breeder-midland-tx-hero.webp";
const heroAlt =
  "Hand-raised Congo African Grey parrot with silver-scalloped grey plumage and a red tail in the Benjamin family aviary";

// Breeder ruling (2026-09-10): the credential entities are named in the pills; the
// paragraph links the proof list (#proof).
const pills = [
  "USDA AWA Licensed",
  "CITES Appendix I Documented",
  "PCR DNA-Sexed",
  "Avian-Vet Certified",
];
---

<section class="hero-v3-b relative overflow-hidden bg-green text-white">
  <!-- warm radial glow -->
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background: radial-gradient(900px 520px at 78% 28%, rgba(232,96,76,0.22), transparent 60%);"
  >
  </div>

  <div class="container relative z-10 mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-12">
    <div class="grid items-center gap-10 py-8 md:grid-cols-2 md:gap-8 md:py-12 lg:py-12">

      <!-- COPY -->
      <div class="order-2 rounded-2xl bg-[#0f3d2c] px-5 py-6 text-center md:order-1 md:px-8 md:py-8 md:text-left">
        <span
          class="font-sora text-xs font-medium tracking-[0.12em] text-[#9fb1ab] md:text-xs"
        >
          C.A.Gs &middot; Family Aviary Since 2014
        </span>

        <h1
          class="font-lora mt-4 text-3xl font-bold leading-[1.08] sm:text-4xl md:text-[2.25rem] lg:text-[2.5rem] md:leading-[1.1]"
        >
          Congo and Timneh African Grey Breeder in <span class="text-clay">Midland, Texas</span>
        </h1>

        <p
          class="hero-lead font-sora mx-auto mt-3 max-w-xl text-[15px] leading-relaxed md:mx-0 md:text-base"
          style="color:#cfd8d5"
        >
          Mark &amp; Teri Benjamin have hand-raised captive-bred Congo and Timneh African Greys in our
          family home since 2014. Every Grey is lab-sexed, avian-vet certified and
          <a href="#proof" class="underline decoration-clay/40 underline-offset-2 hover:decoration-clay">documented</a>
          before it leaves us — never wild-caught, always with lifetime breeder support.
        </p>

        <div class="mt-5 flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="#available-birds"
            class="font-sora rounded-full bg-clay px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-clay-dk"
          >
            View Available Greys →
          </a>
          <a
            href="#contact"
            class="font-sora rounded-full border-2 border-white/60 px-8 py-3.5 text-sm font-semibold text-white transition-all hover:border-white hover:bg-white hover:text-green"
          >
            Reserve Yours Now →
          </a>
        </div>

        <ul
          class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2.5 md:justify-start"
          aria-label="Breeder credentials"
        >
          {pills.map((p) => (
            <li class="font-sora flex items-center gap-2 text-[13px] text-[#dbe2df] whitespace-nowrap">
              <span
                class="flex h-4 w-4 items-center justify-center rounded-full bg-clay text-xs font-bold text-white"
                aria-hidden="true"
              >✓</span>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <!-- CIRCULAR IMAGE STAGE -->
      <div class="order-1 flex justify-center md:order-2 md:justify-end">
        <div class="relative">
          <div
            class="absolute inset-0 -m-3 rounded-full border border-white/25 md:-m-5"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative flex h-[220px] w-[220px] items-center justify-center overflow-hidden rounded-full bg-[#0f3d2c] ring-4 ring-white/15 sm:h-[260px] sm:w-[260px] md:h-[300px] md:w-[300px]"
            style="box-shadow: 0 24px 60px rgba(60,30,10,0.35);"
          >
            <img
              src={heroImg}
              alt={heroAlt}
              width="400"
              height="300"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full object-contain"
              {...srcsetAttrs(heroImg, [300], "300px")}
            />
          </div>
          <span
            class="font-sora absolute -bottom-2 left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full bg-white px-4 py-2 text-[13px] font-semibold text-green shadow-lg md:bottom-4 md:left-auto md:right-0 md:translate-x-0"
            style="box-shadow: 0 10px 30px rgba(60,30,10,0.22);"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-clay opacity-60"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-clay"></span>
            </span>
            {availableCount} Birds Available Now
          </span>
        </div>
      </div>

    </div>
  </div>
</section>
