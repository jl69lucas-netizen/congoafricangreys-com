---
import { srcsetAttrs } from '../../lib/srcset';
import { HERO_IMG, HERO_WIDTHS, HERO_SIZES } from '../../lib/homeHero';
/**
 * cag-hero-v3:b — homepage hero, round-5 variation A "Paperwork card" (breeder pick 2026-09-11).
 * Design source: docs/design/homepage-hero-r5/ (canvas 6881b0e8). Visual layer only: the copy
 * is the previous HeroV3 copy verbatim.
 *
 * Layout: copy sits straight on the forest-dark scrim (#0f3d2c); the Midland photo is a cream
 * "document" card that also carries the four credentials. The card comes FIRST in source, so
 * it leads on mobile (stacked) and tablet (left column); from lg it moves to the right.
 * Desktop target 350–450px tall (breeder ceiling, 2026-09-11).
 *
 * Contrast: the clay H1 span reads 3.45:1 on #0f3d2c (large text needs 3:1). The lead
 * paragraph keeps its colour INLINE because two `h1 + p` rules (body.theme-d and .home-d)
 * force ink !important and exempt only [style*=color]. The availability pill is deliberately
 * almost transparent (breeder: the two Greys' faces must show) — a 28% scrim tint plus a
 * text-shadow keeps the white text legible over the floor fabric it sits on. It sits
 * bottom-LEFT: the faces are in the top half of every crop, and at 1024–1420px the fixed
 * desktop JumpRail covers the card's right edge (measured 59px at 1280).
 * Single consumer: `/` (homepage) — the `#proof` link only resolves there.
 */
interface Props {
  availableCount?: number;
}
const { availableCount = 8 } = Astro.props;

const heroAlt =
  "Hand-raised Congo African Grey parrot with silver-scalloped grey plumage and a red tail in the Benjamin family aviary";

// Breeder ruling (2026-09-10): the credential entities are named in the pills; the
// paragraph links the proof list (#proof). tests/test_homepage_entities.py guards this list.
const pills = [
  "USDA AWA Licensed",
  "CITES Appendix I Documented",
  "PCR DNA-Sexed",
  "Avian-Vet Certified",
];
---

<section class="hero-v3-b relative overflow-hidden border-b border-green bg-[#0f3d2c] text-white">
  <div class="container relative z-10 mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-12">
    <div class="grid items-center gap-[22px] pt-5 pb-7 md:grid-cols-[292px_minmax(0,1fr)] md:gap-8 md:py-8 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-12 lg:py-7 xl:grid-cols-[minmax(0,1fr)_492px] xl:gap-16">

      <!-- PAPERWORK CARD — photo + credentials; first on mobile/tablet -->
      <div class="flex flex-col gap-3.5 rounded-[18px] bg-[#faf7f4] p-3 shadow-[0_24px_60px_rgba(0,0,0,0.28)] lg:order-2 lg:p-3.5">
        <div class="relative overflow-hidden rounded-xl bg-[#234f3b]">
          <img
            src={HERO_IMG}
            alt={heroAlt}
            width="800"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="block h-[168px] w-full object-cover object-[50%_24%] md:h-[150px] lg:h-[200px] lg:object-[50%_40%] xl:h-[232px]"
            {...srcsetAttrs(HERO_IMG, HERO_WIDTHS, HERO_SIZES)}
          />
          <span
            class="font-sora absolute left-2.5 bottom-2.5 inline-flex items-center gap-[7px] whitespace-nowrap rounded-full border border-[rgba(250,247,244,0.55)] bg-[rgba(15,61,44,0.28)] px-3 py-[5px] text-[12.5px] font-semibold leading-[18px] text-white [text-shadow:0_1px_2px_rgba(0,0,0,0.55)]"
          >
            <span class="h-2 w-2 rounded-full bg-clay" aria-hidden="true"></span>
            {availableCount} Birds Available Now
          </span>
        </div>
        <div class="flex flex-col gap-2.5 px-1 pb-1">
          <span class="font-sora text-[12.5px] font-semibold uppercase leading-4 tracking-[0.1em] text-clay-text" aria-hidden="true">Breeder credentials</span>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-1 lg:grid-cols-2" aria-label="Breeder credentials">
            {pills.map((p) => (
              <li class="font-sora flex items-start gap-2 text-[12.5px] font-medium leading-5 text-[#1f2a24] md:text-[13px]">
                <svg class="mt-0.5 flex-none" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#b04228" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.4l3.3 3.3L13 5"></path></svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- COPY — straight on the scrim -->
      <!-- [container-type:inline-size] lets the H1 size itself to this column (cqi) so it is
           always exactly two lines (breeder, 2026-09-11). -->
      <div class="flex flex-col gap-3 [container-type:inline-size] lg:order-1 lg:gap-3.5">
        <span class="font-sora block text-[13px] font-medium leading-[18px] tracking-[0.1em] text-[#9fb1ab]">
          C.A.Gs &middot; Family Aviary Since 2014
        </span>

        <h1 class="font-lora text-[#faf7f4]">
          <span class="block whitespace-nowrap">Congo and Timneh African Grey</span>
          <span class="block whitespace-nowrap">Breeder in <span class="text-clay">Midland, Texas</span></span>
        </h1>

        <p class="hero-lead font-sora max-w-[58ch]" style="color:#cfd8d5">
          Mark &amp; Teri Benjamin have hand-raised captive-bred Congo and Timneh African Greys in our
          family home since 2014. Every Grey is lab-sexed, avian-vet certified and
          <a href="#proof" class="underline decoration-clay/55 underline-offset-[3px] hover:decoration-clay">documented</a>
          before it leaves us — never wild-caught, always with lifetime breeder support.
        </p>

        <div class="flex flex-col gap-2.5 pt-1.5 sm:flex-row sm:flex-wrap sm:gap-3 lg:pt-2">
          <a
            href="#available-birds"
            class="font-sora inline-flex min-h-[46px] items-center justify-center whitespace-nowrap rounded-full bg-clay-ink px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-clay-dk"
          >
            View Available Greys →
          </a>
          <a
            href="#contact"
            class="font-sora inline-flex min-h-[46px] items-center justify-center whitespace-nowrap rounded-full border-2 border-[rgba(250,247,244,0.6)] px-[22px] py-2.5 text-sm font-semibold text-[#faf7f4] transition-colors hover:border-[#faf7f4] hover:bg-[#faf7f4] hover:text-green"
          >
            Reserve Yours Now →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
