---
/**
 * cag-inquiry-compact — low-friction inquiry box for content pages (not the full adoption
 * application, cag-inquiry-form). Two variants (see .claude/skills/cag-contact-form/SKILL.md):
 *
 *   variant="short" (default) — the blog posts. The original short form (name, email, phone,
 *     interest, message) plus Confirm Email, Confirm Number and the two screening questions
 *     (resale, surrender). Breeder, 2026-09-11: "revert all blog post forms to the old short
 *     forms … only put confirm email, numbers, the two questions." Interest + message stay
 *     optional as they were; phone is required because Confirm Number presupposes one.
 *   variant="full" — the scam page. The full seven-field contract (experience + delivery added).
 *
 * AA-safe: green header with white heading + scoped light subtext (beats the Direction-D
 * `h2 + p {color:--ink}` rule via class specificity, so no dark-on-green trap).
 * Formspree xrejpnvn. Props let a page set its own framing + keep ids unique across instances.
 */
interface Props {
  heading?: string;
  subtext?: string;
  subject?: string;
  page?: string;
  idPrefix?: string;
  variant?: 'short' | 'full';
}
const {
  heading = 'Ask a Verified Breeder',
  subtext = 'Send us your question and we reply within 24 hours.',
  subject = 'C.A.Gs Website Inquiry',
  page = '',
  idPrefix = '',
  variant = 'short',
} = Astro.props;
const full = variant === 'full';
const formAction = 'https://formspree.io/f/xrejpnvn';
---

<div class="cf-card">
  <div class="cf-head">
    <h2 class="cf-title font-lora">{heading}</h2>
    <p class="cf-sub font-sora">{subtext}</p>
  </div>
  <form class="cf-form font-sora" action={formAction} method="POST">
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="_next" value="https://congoafricangreys.com/contact-us/?success=true" />
    <input type="text" name="_gotcha" class="cf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    {page && <input type="hidden" name="page" value={page} />}
    <div class="cf-group">
      <label for={idPrefix + 'cf-name'}>Your Name <span class="cf-req">*</span></label>
      <input type="text" id={idPrefix + 'cf-name'} name="name" required placeholder="First &amp; Last Name" autocomplete="name" />
    </div>
    <div class="cf-row">
      <div class="cf-group">
        <label for={idPrefix + 'cf-email'}>Email Address <span class="cf-req">*</span></label>
        <input type="email" id={idPrefix + 'cf-email'} name="email" required placeholder="you@email.com" autocomplete="email" />
      </div>
      <div class="cf-group">
        <label for={idPrefix + 'cf-email2'}>Confirm Email <span class="cf-req">*</span></label>
        <input type="email" id={idPrefix + 'cf-email2'} name="email_confirm" required placeholder="Repeat your email" />
      </div>
    </div>
    <div class="cf-row">
      <div class="cf-group">
        <label for={idPrefix + 'cf-phone'}>Phone Number <span class="cf-req">*</span></label>
        <input type="tel" id={idPrefix + 'cf-phone'} name="phone" required placeholder="(555) 000-0000" autocomplete="tel" />
      </div>
      <div class="cf-group">
        <label for={idPrefix + 'cf-phone2'}>Confirm Number <span class="cf-req">*</span></label>
        <input type="tel" id={idPrefix + 'cf-phone2'} name="phone_confirm" required placeholder="Repeat your number" />
      </div>
    </div>
    <div class="cf-group">
      <label for={idPrefix + 'cf-interest'}>Interested In{full && <> <span class="cf-req">*</span></>}</label>
      <select id={idPrefix + 'cf-interest'} name="interest" required={full}>
        <option value="">Select an option</option>
        <option>Congo African Grey ($1,500–$3,500)</option>
        <option>Timneh African Grey ($1,200–$2,500)</option>
        <option>Breeding Pair</option>
        <option>Fertile Eggs</option>
        <option>Just vetting a listing</option>
        <option>General question</option>
      </select>
    </div>
    <div class="screen-head"><p class="screen-title">Questions we ask every family</p><p class="screen-why">A grey lives 40 to 60 years, so we ask every buyer the same few questions before we place a bird.</p></div>
    <fieldset class="cf-group cf-fset">
      <legend>Are you involved in any pet store, commercial parrot breeding operation, or getting parrots for cheap resale? <span class="cf-req">*</span></legend>
      <div class="cf-rad">
        <label for={idPrefix + 'cf-resale-yes'}><input type="radio" id={idPrefix + 'cf-resale-yes'} name="resale_screening" value="yes" required /> Yes</label>
        <label for={idPrefix + 'cf-resale-no'}><input type="radio" id={idPrefix + 'cf-resale-no'} name="resale_screening" value="no" required /> No</label>
      </div>
    </fieldset>
    <fieldset class="cf-group cf-fset">
      <legend>Have you ever surrendered a pet to a shelter or given one away? <span class="cf-req">*</span></legend>
      <div class="cf-rad">
        <label for={idPrefix + 'cf-surrender-yes'}><input type="radio" id={idPrefix + 'cf-surrender-yes'} name="surrender_history" value="yes" required /> Yes</label>
        <label for={idPrefix + 'cf-surrender-no'}><input type="radio" id={idPrefix + 'cf-surrender-no'} name="surrender_history" value="no" required /> No</label>
      </div>
    </fieldset>
    <div class="cf-group" data-surrender-details>
      <label class="cf-q" for={idPrefix + 'cf-surrender'}>If yes, tell us what happened. Honest answers are appreciated.</label>
      <textarea id={idPrefix + 'cf-surrender'} name="surrender_details" rows="2"></textarea>
    </div>
    {full && (
      <fieldset class="cf-group cf-fset">
        <legend>Are you a First-Time or Experienced Parrot Owner? <span class="cf-req">*</span></legend>
        <div class="cf-rad">
          <label for={idPrefix + 'cf-exp-exp'}><input type="radio" id={idPrefix + 'cf-exp-exp'} name="experience" value="experienced" required /> Experienced owner</label>
          <label for={idPrefix + 'cf-exp-first'}><input type="radio" id={idPrefix + 'cf-exp-first'} name="experience" value="first-time" required /> First-time owner</label>
        </div>
      </fieldset>
    )}
    {full && (
      <fieldset class="cf-group cf-fset">
        <legend>How would you like your grey to reach you? <span class="cf-req">*</span></legend>
        <div class="cf-dlv">
          <label for={idPrefix + 'cf-dlv-airport'}><input type="radio" id={idPrefix + 'cf-dlv-airport'} name="delivery" value="Airport pickup — $185" required /><span class="t">Airport Pickup · $185</span><span class="d">Flies on IATA live-animal terms with Delta, United or American to your nearest major airport; you collect at the airline's cargo desk.</span></label>
          <label for={idPrefix + 'cf-dlv-home'}><input type="radio" id={idPrefix + 'cf-dlv-home'} name="delivery" value="Home delivery — $350" required /><span class="t">Home Delivery · $350</span><span class="d">Brought to the address you give us, on a date we agree with you first.</span></label>
          <label for={idPrefix + 'cf-dlv-nanny'}><input type="radio" id={idPrefix + 'cf-dlv-nanny'} name="delivery" value="Flight nanny — from $750" required /><span class="t">Flight Nanny · from $750</span><span class="d">A nanny keeps your grey in the cabin for the whole flight; quoted per route.</span></label>
          <label for={idPrefix + 'cf-dlv-midland'}><input type="radio" id={idPrefix + 'cf-dlv-midland'} name="delivery" value="Pickup in Midland, TX" required /><span class="t">Local Pickup · Free</span><span class="d">Collect from us in Midland, TX if you live within two to three hours.</span></label>
        </div>
      </fieldset>
    )}
    <div class="cf-group">
      <label for={idPrefix + 'cf-msg'}>Your Message or Listing Link{full && <> <span class="cf-req">*</span></>}</label>
      <textarea id={idPrefix + 'cf-msg'} name="message" rows="3" required={full} placeholder="Paste a suspicious listing, or tell us which Grey you're after."></textarea>
    </div>
    <button type="submit" class="cf-submit">Send to C.A.Gs — Free, No Pressure &#10003;</button>
  </form>
  <div class="cf-pills">
    <span>&#10003; USDA AWA Licensed</span>
    <span>&#10003; CITES Appendix I</span>
    <span>&#10003; DNA Sexed</span>
    <span>&#10003; Avian Vet Certified</span>
    <span>&#10003; Ships Nationwide</span>
  </div>
</div>

<style>
  .cf-card{ max-width:640px; margin:0 auto; background:#fff; border:1px solid #ede5dc; border-radius:18px; overflow:hidden; box-shadow:0 4px 24px rgba(60,30,10,.07); }
  .cf-head{ background:linear-gradient(135deg,#1f4d38,#2D6A4F); padding:22px 28px; text-align:center; }
  .cf-title{ color:#fff; margin:0; font-size:1.3rem; font-weight:700; line-height:1.25; }
  .cf-sub{ color:#f1ebe4; margin:8px 0 0; font-size:13.5px; line-height:1.55; }
  .cf-form{ padding:22px 24px; display:flex; flex-direction:column; gap:14px; }
  .cf-row{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .cf-group{ display:flex; flex-direction:column; gap:5px; }
  .cf-group label{ font-size:var(--fs-micro); font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#5a5248; }
  .cf-req{ color:#b04228; }
  .cf-group input,.cf-group select,.cf-group textarea{ padding:11px 14px; border:1.5px solid #ede5dc; border-radius:10px; font-size:14px; font-family:inherit; color:#1c1a18; background:#fff9f6; outline:none; transition:border-color .15s,box-shadow .15s; }
  .cf-group input:focus,.cf-group select:focus,.cf-group textarea:focus{ border-color:#e8604c; box-shadow:0 0 0 3px rgba(232,96,76,.1); background:#fff; }
  .cf-group textarea{ resize:vertical; min-height:84px; }
  .cf-hp{ position:absolute; left:-9999px; }
  .cf-fset{ border:0; padding:0; margin:0; min-width:0; }
  /* Question legends read as sentences, not 12px capitals (2026-09-11 form critique, both assessments). */
  .cf-fset legend{ padding:0; font-size:14px; font-weight:600; line-height:1.4; color:#1c1a18; margin-bottom:8px; }
  .cf-group label.cf-q{ text-transform:none; letter-spacing:0; font-size:13.5px; font-weight:600; color:#1c1a18; }
  .cf-rad{ display:flex; flex-wrap:wrap; gap:8px; }
  .cf-rad label{ display:flex; align-items:center; gap:8px; min-height:44px; padding:8px 16px; border:1.5px solid #ede5dc; border-radius:50px; background:#fff9f6; font-size:13.5px; font-weight:600; color:#5a5248; text-transform:none; letter-spacing:0; cursor:pointer; }
  .cf-rad label:has(input:checked){ border-color:#e8604c; background:rgba(232,96,76,.06); color:#b04228; }
  .cf-dlv{ display:grid; gap:8px; }
  .cf-dlv label{ display:grid; grid-template-columns:auto 1fr; column-gap:10px; row-gap:2px; align-items:start; padding:10px 14px; border:1.5px solid #ede5dc; border-radius:12px; background:#fff9f6; text-transform:none; letter-spacing:0; cursor:pointer; }
  .cf-dlv label:has(input:checked){ border-color:#e8604c; background:rgba(232,96,76,.05); }
  .cf-dlv input{ grid-row:span 2; margin-top:3px; }
  .cf-dlv .t{ font-size:13.5px; font-weight:700; color:#1c1a18; }
  .cf-dlv .d{ grid-column:2; font-size:12.5px; font-weight:400; color:#5a5248; line-height:1.45; }
  .cf-rad input,.cf-dlv input{ padding:0; border:0; background:none; box-shadow:none; accent-color:#e8604c; }
  .cf-submit{ background:#bd4129; color:#fff; border:none; padding:13px; border-radius:50px; font-size:15px; font-weight:700; font-family:inherit; cursor:pointer; box-shadow:0 6px 20px rgba(232,96,76,.32); transition:background .2s,transform .15s; }
  .cf-submit:hover{ background:#a8381f; transform:translateY(-1px); }
  .cf-pills{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; padding:0 24px 22px; }
  .cf-pills span{ background:#eaf4ef; color:#2D6A4F; border:1px solid rgba(45,106,79,.2); border-radius:50px; padding:5px 14px; font-size:var(--fs-micro); font-weight:700; letter-spacing:.03em; }
  @media(max-width:560px){ .cf-row{ grid-template-columns:1fr; } .cf-head{ padding:20px 20px; } .cf-form{ padding:20px 18px; } .cf-pills{ padding:0 18px 18px; } }
</style>
